			></script>
		{%- endif -%}

		{%- if request.design_mode -%}
			<script>
				if (
					window.Shopify &&
					window.Shopify.theme &&
					navigator &&
					navigator.sendBeacon &&
					window.Shopify.designMode
				) {
					const themeKey = `dataSent_{{ theme.name }}`;
					if (!localStorage.getItem(themeKey)) {
						navigator.sendBeacon(
							'https://cdn.ashstonestudios.com/shopify-beacon/sent/',
							new URLSearchParams({
								slug: window.Shopify.theme.schema_name,
								shop: window.Shopify.shop,
								role: window.Shopify.theme.role,
								route: window.location.pathname,
								themeId: window.Shopify.theme.id,
								themeStoreId: window.Shopify.theme.theme_store_id || 0,
								isThemeEditor: !!window.Shopify.designMode,
								themeName: '{{ theme.name }}',
								shopName: '{{ shop.name }}',
								shopEmail: '{{ shop.email }}',
							}),
						);
						localStorage.setItem(themeKey, 'true');
					}
				}
			</script>
		{%- endif -%}
		<script src="{{ 'bss-custom.js' | asset_url }}" defer></script>
{% render 'exit-intent-popup' %}


<script>
document.addEventListener('DOMContentLoaded', function () {

  const checkbox = document.getElementById('agree_terms');
  const checkoutBtn = document.querySelector('.cart__checkout-button');
  const error = document.querySelector('.terms-error');

  if (!checkoutBtn || !checkbox) return;

  function validateTerms(e) {

    if (!checkbox.checked) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();

      error.style.display = 'block';

      checkbox.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });

      return false;
    }

    error.style.display = 'none';
    return true;
  }

  // Checkout button click block
  checkoutBtn.addEventListener('click', validateTerms, true);

  // Form submit block
  const form = checkoutBtn.closest('form');

  if (form) {
    form.addEventListener('submit', function (e) {
      if (!checkbox.checked) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        error.style.display = 'block';
        return false;
      }

      error.style.display = 'none';
    }, true);
  }

  // Checkbox checked → error hide
  checkbox.addEventListener('change', function () {
    if (checkbox.checked) {
      error.style.display = 'none';
    }
  });

});
</script>
