<!doctype html>
<html
	class="no-js"
	lang="{{ request.locale.iso_code }}"
	data-scheme="{{ settings.color_scheme }}"
	dir="{% render 'direction' %}"
>

	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<meta name="theme-color" content="">
		<link rel="canonical" href="{{ canonical_url }}">
		<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

		{%- if settings.favicon != blank -%}
			<link
				rel="icon"
				type="image/png"
				href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
			>
		{%- endif -%}

		{%- unless settings.type_header_font.system? -%}
			<link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
		{%- endunless -%}

		<title>
			{{ page_title }}
			{%- if current_tags %}
				&ndash; tagged "{{ current_tags | join: ', ' }}"
			{%- endif -%}
			{%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
			{%- unless page_title contains shop.name %}
				&ndash; {{ shop.name -}}
			{%- endunless -%}
		</title>

		{% if page_description %}
			<meta
				name="description"
				content="{{ page_description | escape }}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}"
			>
		{% endif %}

		{% render 'meta-tags' %}

		<script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
		{%- if settings.quickview_show
			or settings.add_to_cart_enabled
			or settings.show_on_mobile
		-%}
			<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
			<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
		{% endif %}

		<script>
			function calculateScrollbarWidth() {
				const scrollbarWidth =
					window.innerWidth - document.documentElement.clientWidth;
				document.documentElement.style.setProperty(
					'--scrollbar-width',
					scrollbarWidth + 'px',
				);
			}

			function calculateVh() {
				let vh = window.innerHeight * 0.01;
				document.documentElement.style.setProperty('--vh', `${vh}px`);
			}

			window.addEventListener('load', calculateScrollbarWidth);
			window.addEventListener('resize', calculateScrollbarWidth);

			window.addEventListener('load', calculateVh);
			window.addEventListener('resize', calculateVh);
		</script>

		{% if settings.rte_style == 'custom' %}
			<script>
				if (window.location.href.includes('policies')) {
					document.addEventListener('DOMContentLoaded', function () {
						const policiesRte = document.querySelector(
							'.shopify-policy__body .rte',
						);
						if (policiesRte) {
							policiesRte.classList.add('custom_rte');
						}
					});
				}
			</script>
		{% endif %}

		{{ content_for_header }}

		{%- liquid
			assign body_font_light = settings.type_body_font | font_modify: 'weight', '300'
			assign body_font_regular = settings.type_body_font | font_modify: 'weight', '400'
			assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
			assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
			assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
			assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
			assign heading_font_regular = settings.type_header_font | font_modify: 'weight', '400'
			assign heading_font_medium = settings.type_header_font | font_modify: 'weight', '500'
			assign section_heading_font_regular = settings.type_section_header_font | font_modify: 'weight', '400'
			assign section_heading_font_medium = settings.type_section_header_font | font_modify: 'weight', '500'
			assign heading_font_italic = settings.type_header_font | font_modify: 'style', 'italic'

			assign countdown_font_regular = settings.countdown_font | font_modify: 'weight', '400'
			assign countdown_font_bold = settings.countdown_font | font_modify: 'weight', 'bold'
			assign countdown_font_extra_bold = settings.countdown_font | font_modify: 'weight', '800'
			assign countdown_font_black = settings.countdown_font | font_modify: 'weight', '900'
			assign countdown_font_italic = settings.countdown_font | font_modify: 'style', 'italic'

			assign type_img_banner_ticker_font_regular = settings.type_img_banner_ticker_font | font_modify: 'weight', '400'
			assign type_img_banner_ticker_font_bold = settings.type_img_banner_ticker_font | font_modify: 'weight', 'bold'
			assign type_img_banner_ticker_font_extra_bold = settings.type_img_banner_ticker_font | font_modify: 'weight', '800'
			assign type_img_banner_ticker_font_black = settings.type_img_banner_ticker_font | font_modify: 'weight', '900'
			assign type_img_banner_ticker_font_italic = settings.type_img_banner_ticker_font | font_modify: 'style', 'italic'

			assign product_count_font_regular = settings.product_count_font | font_modify: 'weight', '400'
			assign product_count_font_bold = settings.product_count_font | font_modify: 'weight', 'bold'
			assign product_count_font_extra_bold = settings.product_count_font | font_modify: 'weight', '800'
			assign product_count_font_black = settings.product_count_font | font_modify: 'weight', '900'
			assign product_count_font_italic = settings.product_count_font | font_modify: 'style', 'italic'

			assign badge_font_regular = settings.type_badge_font | font_modify: 'weight', '400'
			assign badge_font_bold = settings.type_badge_font | font_modify: 'weight', 'bold'
			assign badge_font_extra_bold = settings.type_badge_font | font_modify: 'weight', '800'
			assign badge_font_black = settings.type_badge_font | font_modify: 'weight', '900'
			assign badge_font_italic = settings.type_badge_font | font_modify: 'style', 'italic'
		%}

		{% style %}
			{{ settings.type_body_font | font_face: font_display: 'swap' }}
			{{ settings.type_header_font | font_face: font_display: 'swap' }}
			{{ settings.type_tertiary_font | font_face: font_display: 'swap' }}
			{{ settings.type_section_header_font | font_face: font_display: 'swap' }}
			{{ settings.type_button_font | font_face: font_display: 'swap' }}
			{{ settings.type_header_font_card | font_face: font_display: 'swap' }}
			{{ settings.type_text_font_card | font_face: font_display: 'swap' }}
			{{ settings.type_subtitle_font | font_face: font_display: 'swap' }}
			{{ settings.type_header_menu_font | font_face: font_display: 'swap' }}
			{{ settings.type_footer_menu_font | font_face: font_display: 'swap' }}
			{{ settings.type_popups_heading_font | font_face: font_display: 'swap' }}
			{{ settings.type_popups_text_font | font_face: font_display: 'swap' }}

			{{ countdown_font_regular | font_face: font_display: 'swap' }}
			{{ countdown_font_bold | font_face: font_display: 'swap' }}
			{{ countdown_font_extra_bold | font_face: font_display: 'swap' }}
			{{ countdown_font_black | font_face: font_display: 'swap' }}
			{{ countdown_font_italic | font_face: font_display: 'swap' }}

			{{ type_img_banner_ticker_font_regular | font_face: font_display: 'swap' }}
			{{ type_img_banner_ticker_font_bold | font_face: font_display: 'swap' }}
			{{ type_img_banner_ticker_font_extra_bold | font_face: font_display: 'swap' }}
			{{ type_img_banner_ticker_font_black | font_face: font_display: 'swap' }}
			{{ type_img_banner_ticker_font_italic | font_face: font_display: 'swap' }}

			{{ product_count_font_regular | font_face: font_display: 'swap' }}
			{{ product_count_font_bold | font_face: font_display: 'swap' }}
			{{ product_count_font_extra_bold | font_face: font_display: 'swap' }}
			{{ product_count_font_black | font_face: font_display: 'swap' }}
			{{ product_count_font_italic | font_face: font_display: 'swap' }}

			{{ badge_font_regular | font_face: font_display: 'swap' }}
			{{ badge_font_bold | font_face: font_display: 'swap' }}
			{{ badge_font_extra_bold | font_face: font_display: 'swap' }}
			{{ badge_font_black | font_face: font_display: 'swap' }}
			{{ badge_font_italic | font_face: font_display: 'swap' }}

			{{ body_font_light | font_face: font_display: 'swap' }}
			{{ body_font_regular | font_face: font_display: 'swap' }}
			{{ body_font_medium | font_face: font_display: 'swap' }}
			{{ body_font_bold | font_face: font_display: 'swap' }}
			{{ body_font_italic | font_face: font_display: 'swap' }}
			{{ heading_font_regular | font_face: font_display: 'swap' }}
			{{ heading_font_medium | font_face: font_display: 'swap' }}
			{{ section_heading_font_regular | font_face: font_display: 'swap' }}
			{{ section_heading_font_medium | font_face: font_display: 'swap' }}
			{{ heading_font_italic | font_face: font_display: 'swap' }}
			{{ body_font_bold_italic | font_face: font_display: 'swap' }}

			{% for scheme in settings.color_schemes -%}
				{% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
				{% if forloop.index == 1 -%}
					:root,
				{%- endif %}
					[data-scheme=light] .color-{{ scheme.id }} {
					--color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{
					scheme.settings.colors_background_1.blue }};
					--color-background-secondary: {{ scheme.settings.colors_background_2.red }},{{
					scheme.settings.colors_background_2.green }},{{ scheme.settings.colors_background_2.blue }};
					--color-background-tertiary: {{ scheme.settings.colors_background_3.red }},{{
					scheme.settings.colors_background_3.green }},{{ scheme.settings.colors_background_3.blue }};
					{% if scheme.settings.background_gradient != empty %}
					--gradient-background: {{ scheme.settings.background_gradient }};
					{% else %}
					--gradient-background: {{ scheme.settings.colors_background_1 }};
					{% endif %}
					--color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{
					scheme.settings.colors_text.blue }};
					--color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{
					scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
					--color-foreground-tertiary: {{ scheme.settings.colors_tertiary_text.red }}, {{
					scheme.settings.colors_tertiary_text.green }}, {{ scheme.settings.colors_tertiary_text.blue }};
					--color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }},
					{{ scheme.settings.colors_text_title.blue }};

					--color-button-text: {{ scheme.settings.colors_solid_button_labels.red }}, {{
					scheme.settings.colors_solid_button_labels.green }}, {{ scheme.settings.colors_solid_button_labels.blue }};
					--color-button-text-hover: {{ scheme.settings.colors_solid_button_labels_hover.red }}, {{
					scheme.settings.colors_solid_button_labels_hover.green }}, {{ scheme.settings.colors_solid_button_labels_hover.blue
					}};
					--color-button: {{ scheme.settings.colors_solid_button_background.red }}, {{
					scheme.settings.colors_solid_button_background.green }}, {{ scheme.settings.colors_solid_button_background.blue }};
					--color-button-hover: {{ scheme.settings.colors_solid_button_background_hover.red }}, {{
					scheme.settings.colors_solid_button_background_hover.green }}, {{
					scheme.settings.colors_solid_button_background_hover.blue }};

					--color-button-secondary-border: {{ scheme.settings.colors_secondary_button_border.red }}, {{
					scheme.settings.colors_secondary_button_border.green }}, {{ scheme.settings.colors_secondary_button_border.blue }};
					--color-button-secondary-background-hover: {{ scheme.settings.colors_secondary_button_background_hover.red }}, {{
					scheme.settings.colors_secondary_button_background_hover.green }}, {{
					scheme.settings.colors_secondary_button_background_hover.blue }};
					--color-button-secondary-text: {{ scheme.settings.colors_secondary_button_labels.red }}, {{
					scheme.settings.colors_secondary_button_labels.green }}, {{ scheme.settings.colors_secondary_button_labels.blue }};
					--color-button-secondary-text-hover: {{ scheme.settings.colors_secondary_button_labels_hover.red }}, {{
					scheme.settings.colors_secondary_button_labels_hover.green }}, {{
					scheme.settings.colors_secondary_button_labels_hover.blue }};

					--color-button-link: {{ scheme.settings.colors_link_button_labels.red }}, {{
					scheme.settings.colors_link_button_labels.green }}, {{ scheme.settings.colors_link_button_labels.blue }};
					--color-button-link-hover: {{ scheme.settings.colors_link_button_labels_hover.red }}, {{
					scheme.settings.colors_link_button_labels_hover.green }}, {{ scheme.settings.colors_link_button_labels_hover.blue }};

					--color-button-link-second: {{ scheme.settings.colors_link_button_second_labels.red }}, {{
					scheme.settings.colors_link_button_second_labels.green }}, {{ scheme.settings.colors_link_button_second_labels.blue
					}};
					--color-button-link-second-hover: {{ scheme.settings.colors_link_button_second_labels_hover.red }}, {{
					scheme.settings.colors_link_button_second_labels_hover.green }}, {{
					scheme.settings.colors_link_button_second_labels_hover.blue }};

					--color-overlay: {{ scheme.settings.colors_background_overlay.red }}, {{
					scheme.settings.colors_background_overlay.green }}, {{ scheme.settings.colors_background_overlay.blue }};
					--color-border-input: {{ scheme.settings.colors_input_border.red }}, {{ scheme.settings.colors_input_border.green }},
					{{ scheme.settings.colors_input_border.blue }};
					--color-border-input-hover: {{ scheme.settings.colors_input_hover_border.red }}, {{
					scheme.settings.colors_input_hover_border.green }}, {{ scheme.settings.colors_input_hover_border.blue }};
					--color-background-input: {{ scheme.settings.colors_input_background.red }}, {{
					scheme.settings.colors_input_background.green }}, {{ scheme.settings.colors_input_background.blue }};
					--color-background-input-hover: {{ scheme.settings.colors_input_hover_background.red }}, {{
					scheme.settings.colors_input_hover_background.green }}, {{ scheme.settings.colors_input_hover_background.blue }};
					--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{
					scheme.settings.color_border.blue }};
					--color-border-on-hover: {{ scheme.settings.color_border_on_hover.red }}, {{ scheme.settings.color_border_on_hover.green }}, {{
					scheme.settings.color_border_on_hover.blue }};

					--color-badge-background: {{ scheme.settings.colors_badge_background.red }}, {{
					scheme.settings.colors_badge_background.green }}, {{ scheme.settings.colors_badge_background.blue }};
					--color-badge-text: {{ scheme.settings.colors_badge_labels.red }}, {{ scheme.settings.colors_badge_labels.green }}, {{
					scheme.settings.colors_badge_labels.blue }};
					--color-badge-text-sale: {{ scheme.settings.colors_badge_labels_sale.red }}, {{
					scheme.settings.colors_badge_labels_sale.green }}, {{ scheme.settings.colors_badge_labels_sale.blue }};

					--color-card-price-new: {{ scheme.settings.card_new_price_color.red }}, {{ scheme.settings.card_new_price_color.green
					}}, {{ scheme.settings.card_new_price_color.blue }};
					--color-card-price-old: {{ scheme.settings.card_old_price_color.red }}, {{ scheme.settings.card_old_price_color.green
					}}, {{ scheme.settings.card_old_price_color.blue }};

					--color-accent: {{ scheme.settings.colors_accent.red }}, {{ scheme.settings.colors_accent.green }}, {{
					scheme.settings.colors_accent.blue }};
					--colors_marker_background: {{ scheme.settings.colors_marker_background.red }}, {{
					scheme.settings.colors_marker_background.green }}, {{ scheme.settings.colors_marker_background.blue }};
					--color_shadow: {{ scheme.settings.color_shadow.red }}, {{
					scheme.settings.color_shadow.green }}, {{ scheme.settings.color_shadow.blue }};
					--color-bg-led-animation-first: {{ scheme.settings.bg_led_animation_color_first.red }}, {{
					scheme.settings.bg_led_animation_color_first.green }}, {{ scheme.settings.bg_led_animation_color_first.blue }};
					--color-bg-led-animation-second: {{ scheme.settings.bg_led_animation_color_second.red }}, {{
					scheme.settings.bg_led_animation_color_second.green }}, {{ scheme.settings.bg_led_animation_color_second.blue }};
					--color-bg-blockuote: {{ scheme.settings.bg_blockquote.red }}, {{
					scheme.settings.bg_blockquote.green }}, {{ scheme.settings.bg_blockquote.blue }};
				}
				@media (prefers-color-scheme: light) {
				{% if forloop.index == 1 -%}
				:root,
				{%- endif %}
				[data-scheme=auto] .color-{{ scheme.id }} {
				--color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{
				scheme.settings.colors_background_1.blue }};
				--color-background-secondary: {{ scheme.settings.colors_background_2.red }},{{
				scheme.settings.colors_background_2.green }},{{ scheme.settings.colors_background_2.blue }};
				--color-background-tertiary: {{ scheme.settings.colors_background_3.red }},{{
				scheme.settings.colors_background_3.green }},{{ scheme.settings.colors_background_3.blue }};
				{% if scheme.settings.background_gradient != empty %}
				--gradient-background: {{ scheme.settings.background_gradient }};
				{% else %}
				--gradient-background: {{ scheme.settings.colors_background_1 }};
				{% endif %}
				--color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{
				scheme.settings.colors_text.blue }};
				--color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{
				scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
				--color-foreground-tertiary: {{ scheme.settings.colors_tertiary_text.red }}, {{
				scheme.settings.colors_tertiary_text.green }}, {{ scheme.settings.colors_tertiary_text.blue }};
				--color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }},
				{{ scheme.settings.colors_text_title.blue }};

				--color-button-text: {{ scheme.settings.colors_solid_button_labels.red }}, {{
				scheme.settings.colors_solid_button_labels.green }}, {{ scheme.settings.colors_solid_button_labels.blue }};
				--color-button-text-hover: {{ scheme.settings.colors_solid_button_labels_hover.red }}, {{
				scheme.settings.colors_solid_button_labels_hover.green }}, {{ scheme.settings.colors_solid_button_labels_hover.blue
				}};
				--color-button: {{ scheme.settings.colors_solid_button_background.red }}, {{
				scheme.settings.colors_solid_button_background.green }}, {{ scheme.settings.colors_solid_button_background.blue }};
				--color-button-hover: {{ scheme.settings.colors_solid_button_background_hover.red }}, {{
				scheme.settings.colors_solid_button_background_hover.green }}, {{
				scheme.settings.colors_solid_button_background_hover.blue }};

				--color-button-secondary-border: {{ scheme.settings.colors_secondary_button_border.red }}, {{
				scheme.settings.colors_secondary_button_border.green }}, {{ scheme.settings.colors_secondary_button_border.blue }};
				--color-button-secondary-background-hover: {{ scheme.settings.colors_secondary_button_background_hover.red }}, {{
				scheme.settings.colors_secondary_button_background_hover.green }}, {{
				scheme.settings.colors_secondary_button_background_hover.blue }};
				--color-button-secondary-text: {{ scheme.settings.colors_secondary_button_labels.red }}, {{
				scheme.settings.colors_secondary_button_labels.green }}, {{ scheme.settings.colors_secondary_button_labels.blue }};
				--color-button-secondary-text-hover: {{ scheme.settings.colors_secondary_button_labels_hover.red }}, {{
				scheme.settings.colors_secondary_button_labels_hover.green }}, {{
				scheme.settings.colors_secondary_button_labels_hover.blue }};

				--color-button-link: {{ scheme.settings.colors_link_button_labels.red }}, {{
				scheme.settings.colors_link_button_labels.green }}, {{ scheme.settings.colors_link_button_labels.blue }};
				--color-button-link-hover: {{ scheme.settings.colors_link_button_labels_hover.red }}, {{
				scheme.settings.colors_link_button_labels_hover.green }}, {{ scheme.settings.colors_link_button_labels_hover.blue }};

				--color-button-link-second: {{ scheme.settings.colors_link_button_second_labels.red }}, {{
				scheme.settings.colors_link_button_second_labels.green }}, {{ scheme.settings.colors_link_button_second_labels.blue
				}};
				--color-button-link-second-hover: {{ scheme.settings.colors_link_button_second_labels_hover.red }}, {{
				scheme.settings.colors_link_button_second_labels_hover.green }}, {{
				scheme.settings.colors_link_button_second_labels_hover.blue }};

				--color-overlay: {{ scheme.settings.colors_background_overlay.red }}, {{
				scheme.settings.colors_background_overlay.green }}, {{ scheme.settings.colors_background_overlay.blue }};
				--color-border-input: {{ scheme.settings.colors_input_border.red }}, {{ scheme.settings.colors_input_border.green }},
				{{ scheme.settings.colors_input_border.blue }};
				--color-border-input-hover: {{ scheme.settings.colors_input_hover_border.red }}, {{
				scheme.settings.colors_input_hover_border.green }}, {{ scheme.settings.colors_input_hover_border.blue }};
				--color-background-input: {{ scheme.settings.colors_input_background.red }}, {{
				scheme.settings.colors_input_background.green }}, {{ scheme.settings.colors_input_background.blue }};
				--color-background-input-hover: {{ scheme.settings.colors_input_hover_background.red }}, {{
				scheme.settings.colors_input_hover_background.green }}, {{ scheme.settings.colors_input_hover_background.blue }};
				--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{
				scheme.settings.color_border.blue }};
				--color-border-on-hover: {{ scheme.settings.color_border_on_hover.red }}, {{ scheme.settings.color_border_on_hover.green }}, {{
				scheme.settings.color_border_on_hover.blue }};
				--color-badge-background: {{ scheme.settings.colors_badge_background.red }}, {{
				scheme.settings.colors_badge_background.green }}, {{ scheme.settings.colors_badge_background.blue }};
				--color-badge-text: {{ scheme.settings.colors_badge_labels.red }}, {{ scheme.settings.colors_badge_labels.green }}, {{
				scheme.settings.colors_badge_labels.blue }};
				--color-badge-text-sale: {{ scheme.settings.colors_badge_labels_sale.red }}, {{
				scheme.settings.colors_badge_labels_sale.green }}, {{ scheme.settings.colors_badge_labels_sale.blue }};

				--color-card-price-new: {{ scheme.settings.card_new_price_color.red }}, {{ scheme.settings.card_new_price_color.green
				}}, {{ scheme.settings.card_new_price_color.blue }};
				--color-card-price-old: {{ scheme.settings.card_old_price_color.red }}, {{ scheme.settings.card_old_price_color.green
				}}, {{ scheme.settings.card_old_price_color.blue }};

				--color-accent: {{ scheme.settings.colors_accent.red }}, {{ scheme.settings.colors_accent.green }}, {{
				scheme.settings.colors_accent.blue }};
				--colors_marker_background: {{ scheme.settings.colors_marker_background.red }},
				{{scheme.settings.colors_marker_background.green }}, {{ scheme.settings.colors_marker_background.blue }};
				--color_shadow: {{ scheme.settings.color_shadow.red }}, {{
				scheme.settings.color_shadow.green }}, {{ scheme.settings.color_shadow.blue }};
				}
				}
			{% endfor %}

			{{ scheme_classes | prepend: 'body' }} {
				color: rgba(var(--color-foreground));
				background-color: rgb(var(--color-background));
			}

			:root {
				--announcement-height: 0px;
