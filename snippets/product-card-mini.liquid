{{ 'component-product-card-mini.css' | asset_url | stylesheet_tag }}

{% liquid
	assign btn_link = product_card_product.url | default: '#'
%}

<div
	class="product-card-mini js-color-swatches-wrapper color-background-1 {% if product_card_product.featured_media == blank%} no-image{% endif %}"
	data-product="{{ product_card_product.handle }}"
>
	<span class="visually-hidden">{{ product_card_product.title | escape }}</span>

	{% if product_card_product.featured_media != blank %}
		<div
			class="product-card-mini__image"
			style="--object-fit-product-card-mini:  {{ media_fit }}"
		>
			{{
				product_card_product.featured_media
				| image_url: width: product_card_product.featured_media.width
				| image_tag: loading: 'lazy', widths: '275, 550, 750'
			}}
		</div>
	{% endif %}
	<a
		href="{{ btn_link }}"
		class="product-card-mini__link-overlay"
		aria-label="Shop Now"
	></a>
	<div class="product-card-mini__content--wrapper">
		<div class="product-card-mini__content animated-link__underline--multirow">
			<p class="vendor-name">{{ product_card_product.vendor }}</p>
			<a href="{{ btn_link }}" class="card-mini__content--title card__title ">
				{{- product_card_product.title | escape -}}
			</a>
			{% render 'price',
				product: product_card_product,
				price_class: 'card-mini__content--price',
				show_badges: true
			%}
		</div>
		{% render 'button',
			btn_label: 'Shop Now',
			btn_link: btn_link,
			btn_style: 'primary',
			add_classes: 'content__product-card--button focus-inset'
		%}
	</div>
</div>
