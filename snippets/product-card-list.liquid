{% comment %}
		Renders a product card
		Accepts:
		- product_card_product: {Object} Product Liquid object (optional)
		- media_size: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
		- show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
		- show_vendor: {Boolean} Show the product vendor. Default: true
		- show_desc: {Boolean} Show the product vendor. Default: false
		- section_id: {String} The ID of the section that contains this card.
		Usage:
	{% render 'product-card', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{% liquid
	assign quickview_button_layout = settings.quickview_button_layout
	assign quickview_show = settings.quickview_show
	assign show_on_mobile = settings.show_on_mobile
	assign add_to_cart_enabled = settings.add_to_cart_enabled
	assign trigger_swatch = settings.trigger_swatch
	assign trigger_swatch_other = settings.trigger_swatch_other
	assign type_color_swatch = settings.type_color_swatch

	assign class_media_transparent = ''
	if media_fit == 'cover'
		assign class_media_transparent = 'media--transparent'
	endif

	assign class_card_background = ''
	if media_fit == 'contain'
		assign class_card_background = 'card--background'
	endif
%}

{%- if quickview_show or show_on_mobile -%}
	{%- assign first_3d_model = product_card_product.media
		| where: 'media_type', 'model'
		| first
	-%}
	{%- if first_3d_model -%}
		{{ 'component-product-model.css' | asset_url | stylesheet_tag }}
		<link
			id="ModelViewerStyle"
			rel="stylesheet"
			href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
			media="print"
			onload="this.media='all'"
		>
		<link
			id="ModelViewerOverride"
			rel="stylesheet"
			href="{{ 'component-model-viewer-ui.css' | asset_url }}"
			media="print"
			onload="this.media='all'"
		>
	{%- endif -%}

	{%- if first_3d_model -%}
		<script type="application/json" id="ProductJSON-{{ product.id }}">
			{{ product_card_product.media | where: 'media_type', 'model' | json }}
		</script>

		<script src="{{ 'product-model.js' | asset_url }}" defer></script>
	{%- endif -%}
{%- endif -%}

<div
	class="product-card-list card-wrapper js-color-swatches-wrapper color-background-1"
	data-product="{{ product_card_product.handle }}"
>
	<span class="visually-hidden">
		{{- product_card_product.title | escape -}}
	</span>

	<div class="card-wrapper__media">
		<a
			href="{{ product_card_product.url | default: '#' }}"
			class="link link--overlay card-wrapper__link--overlay js-color-swatches-link"
			aria-label="{{ 'accessibility.product_link' | t }}"
			style="z-index: 20;"
		></a>
		<div
			class="card card--product {{ class_card_background }}"
			tabindex="-1"
		>
			<div class="card__inner full-unstyled-link">
				<div
					class="media {{ class_media_transparent }} media--hover-effect"
					style="aspect-ratio: {{ media_size }};"
				>
					{%- if product_card_product.featured_media -%}
						{% liquid
							assign aspect_ratio = media_size | split: '/'
							assign temp = aspect_ratio[0] | append: '.0'

							assign aspect_ratio_settings = aspect_ratio[1] | divided_by: temp
							assign aspect_ratio_img_width = product_card_product.featured_media.height | plus: 0.0 | divided_by: product_card_product.featured_media.width | round: 2
							assign aspect_ratio_img_height = product_card_product.featured_media.width | plus: 0.0 | divided_by: product_card_product.featured_media.height | round: 2

							assign width_ratio = 1
							if aspect_ratio_settings < 1
								if aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width > 1
									assign width_ratio = aspect_ratio_img_width
								elsif aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width < 1
									assign width_ratio = aspect_ratio_img_height
								elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width < 1
									assign width_ratio = aspect_ratio_img_height
								else

								endif
							else
								if aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width > 1
									assign width_ratio = aspect_ratio_img_width
								elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width > 1
									assign width_ratio = aspect_ratio_settings
								elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width < 1
									assign width_ratio = aspect_ratio_img_height | times: aspect_ratio_settings | round: 2 | plus: aspect_ratio_img_width
								else
									assign width_ratio = aspect_ratio_settings | plus: 0.25
								endif
							endif
						%}

						{% if columns %}
							{% capture sizes %}
              {% if columns == 4 %}
                (min-width: 1100px) calc(((100vw - 64px) / 4) * {{ width_ratio }}),
              {% endif %}
              {% if columns >= 3 %}
                (min-width: 990px) calc(((100vw - 40px) / 3) * {{ width_ratio }}),
              {% endif %}
              (min-width: 750px) calc(((100vw - 40px) / 2) * {{ width_ratio }}),
              calc((100vw - 40px))
            {% endcapture %}
						{% else %}
							{% capture sizes %}
              (min-width: 1100px) calc(535px * {{ width_ratio }}), (min-width: 750px) calc(((100vw - 128px) / 2) * {{ width_ratio }}), calc((100vw - 40px))
            {% endcapture %}
						{% endif %}

						{% capture style %}
            {%- if media_fit == 'contain' -%}
              object-fit: contain;
            {%- endif -%}
            {%- if media_fit == 'cover' -%}
              object-fit: cover;
            {%- endif -%}
          {% endcapture %}

						{{
							product_card_product.featured_media
							| image_url: width: product_card_product.featured_media.width
							| image_tag:
								loading: 'lazy',
								class: 'motion-reduce media--first',
								widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600',
								sizes: sizes,
								style: style
						}}

						{%- if product_card_product.media[1] != null
							and show_secondary_image
						-%}
							{{
								product_card_product.media[1]
								| image_url: width: product_card_product.media[1].width
								| image_tag:
									loading: 'lazy',
									class: 'motion-reduce media--second',
									widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
									sizes: sizes,
									style: style
							}}
						{%- endif -%}
					{%- else -%}
						{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
					{%- endif -%}
				</div>
			</div>
		</div>
	</div>

	<div class="card-product__info">
		<div class="card-product__info--inner-wrapper">
			<div class="card-product__info--inner">
				{%- if show_vendor or show_collection -%}
					<div class="card__subtitles">
						{%- if show_vendor and product_card_product.vendor -%}
							<span class="visually-hidden">
								{{- 'accessibility.vendor' | t -}}
							</span>
							<div class="card__subtitle card__vendor">
								{% if settings.enable_vendor_link %}
									{{
										product_card_product.vendor
										| link_to_vendor: class: 'focus-inset'
									}}
								{% else %}
									{{ product_card_product.vendor }}
								{% endif %}
							</div>
						{%- endif -%}
						{%- if show_collection
							and product_card_product.collections[0].title != blank
						-%}
							<div class="card__subtitle card__collection {% if show_vendor == false %} card__collection--none-separator {%  endif %}">
								{{ product_card_product.collections[0].title }}
							</div>
						{%- endif -%}
					</div>
				{% endif %}

				<h3 class="card__title h5">
					<a
						class="full-unstyled-link"
						href="{{ product_card_product.url | default: '#' }}"
						title="{{ product_card_product.title | escape }}"
						aria-label="{{ product_card_product.title | escape }}"
					>
						{{- product_card_product.title | escape -}}
					</a>
				</h3>

				{%- unless product_card_product.has_only_default_variant -%}
					<div
						class="product-parameters"
						style="{% if show_swatches == false %}display: none; {% endif %} z-index: 99; position: relative;	"
					>
						{%- for option in product_card_product.options_with_values -%}
							{% liquid
								assign color_trigger = trigger_swatch | append: '<br />' | append: trigger_swatch_other | strip | newline_to_br | split: '<br />'
								assign name_option = option.name | handle | strip

								assign is_color_option = false
								# for custom swatch type
								if type_color_swatch == 'custom'
									for item in color_trigger
										assign item_temp = item | handle | strip
										if name_option == item_temp
											assign is_color_option = true
										endif
									endfor
								endif

								# for standart swatch type
								# !!! for product card need Swatch trigger in settings
								if type_color_swatch == 'standart'
									for item in color_trigger
										assign item_temp = item | handle | strip
										if name_option == item_temp
											for value in option.values
												if value.swatch.color != blank
													assign is_color_option = true
												endif
											endfor
										endif
									endfor
								endif
							%}

							{% if is_color_option %}
								<div class="product-form__controls js-color-swatches">
									<div class="product-form__controls-group">
										{% render 'product-variant-options-card',
											product: product_card_product,
											option: option,
											no_form_id: false,
											show_color_swatch: true,
											limit_show: 3
										%}
									</div>
								</div>
							{% endif %}
						{%- endfor -%}
					</div>
				{% endunless %}

				{% render 'price', product: product_card_product, price_class: '' %}

				{%- if show_desc and product_card_product.description != blank -%}
					<div class="card__description card__description--{{ content_alignment }}">
						{{ product_card_product.description | strip_html | truncate: 120 }}
					</div>
				{%- endif -%}
			</div>
			<div class="card-product__info-buttons">
				{% render 'button',
					btn_label: 'Shop now',
					btn_link: product_card_product.url,
					btn_style: 'primary'
				%}
				<div>
					{% liquid
						assign quick_add = false
						if add_to_cart_enabled
							assign quick_add = true
						endif

						assign quick_view = false
						if quickview_show
							assign quick_view = true
						endif

						if add_to_cart_enabled == false and quickview_show == false and show_on_mobile
							assign quick_add = true
							assign quick_view = true
							assign hide_desktop = true
						endif
					%}
					{%- if quick_add
						and product_card_product.selected_or_first_available_variant.available
						and product_card_product.has_only_default_variant
						or product_card_product.options.size == 1
						and product_card_product.options[0] == trigger_swatch
					-%}
						{%- assign product_form_id = 'quick-add-'
							| append: section_id
							| append: product_card_product.id
						-%}
						<product-form class="card__add-to-cart card__button {% if hide_desktop %} hide-desktop {% endif %}">
							{%- form 'product',
								product_card_product,
								id: product_form_id,
								class: 'form',
								novalidate: 'novalidate',
								data-type: 'add-to-cart-form'
							-%}
								<input
									type="hidden"
									name="id"
									value="{{ product_card_product.selected_or_first_available_variant.id }}"
									disabled
								>

								<div class="button_wrapper custom-hover">
									<button
										id="{{ product_form_id }}-submit"
										type="submit"
										class="button button--secondary mobile-button--secondary card__link--{{ quickview_button_layout }} {% if show_on_mobile -%}card__link--show{%- endif %} card-focused"
										name="add"
										aria-label="{{ 'general.card.quick__add' | t }}"
										aria-haspopup="dialog"
										aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
										aria-live="polite"
										data-sold-out-message="true"
										{% if product_card_product.selected_or_first_available_variant.available
												== false
										%}
											disabled
										{% endif %}
										data-button-text="{{- 'general.card.quick__add' | t -}}"
										tabindex="0"
									>
										<div class="button__content">
											<span
												class="card__quickview-text button__label"
												data-label="{{- 'general.card.quick__add' | t  | escape -}}"
											>
												{{- 'general.card.quick__add' | t -}}
											</span>
										</div>
										<div class="button__content">
											<span
												class="sold-out-message hidden button__label"
												data-label="{{- 'products.product.sold_out' | t  | escape -}}"
											>
												{{ 'products.product.sold_out' | t }}
											</span>
										</div>
										<div class="loading-overlay__spinner hidden">
											{% render 'icon-spinner' %}
										</div>

										<span class="button_circle"> </span>
									</button>
								</div>
							{%- endform -%}
						</product-form>
					{%- elsif quick_view -%}
						<div class="quick-add no-js-hidden {% if hide_desktop %} hide-desktop {% endif %}">
							{%- assign product_form_id = 'quick-add-'
								| append: section_id
								| append: product_card_product.id
							-%}
							<modal-opener data-modal="#QuickAdd-{{ product_card_product.id }}">
								<div class="button_wrapper custom-hover">
									<button
										id="{{ product_form_id }}-submit"
										type="submit"
										name="add"
										class="button button--secondary mobile-button--secondary card__link--{{ quickview_button_layout }} {%- if show_on_mobile -%}card__link--show{%- endif %} card-focused"
										aria-label="{{ 'general.card.quick__view' | t }}"
										aria-haspopup="dialog"
										aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
										data-product-url="{{ product_card_product.url }}"
										data-button-text="{{- 'general.card.quick__view' | t -}}"
										tabindex="0"
									>
										<div class="button__content">
											<span
												class="card__quickview-text button__label"
												data-label="{{- 'general.card.quick__view' | t  | escape -}}"
											>
												{{- 'general.card.quick__view' | t -}}
											</span>
										</div>

										<div class="loading-overlay__spinner hidden">
											{% render 'icon-spinner' %}
										</div>

										<span class="button_circle"> </span>
									</button>
								</div>
							</modal-opener>
							<quick-add-modal
								id="QuickAdd-{{ product_card_product.id }}"
								class="quick-add-modal"
							>
								<div class="quick-add-modal__overlay color-background-3"></div>
								<div
									role="dialog"
									aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
									aria-modal="true"
									class="quick-add-modal__content global-settings-popup"
								>
									<button
										id="ModalClose-{{ product_card_product.id }}"
										type="button"
										class="quick-add-modal__toggle modal-close-button focus-inset"
										aria-label="{{ 'accessibility.close' | t }}"
										tabindex="0"
									>
										{% render 'icon-close' %}
									</button>
									<div class="quick-add-modal__content-wrapper">
										<div
											id="QuickAddInfo-{{ product_card_product.id }}"
											class="quick-add-modal__content-info"
										></div>
									</div>
								</div>
							</quick-add-modal>
						</div>
					{%- endif -%}
				</div>
			</div>
		</div>
		{% render 'main-product-specs-short',
			product: product_card_product,
			specs_short_link: '#specs_long',
			specs_size: 4
		%}
	</div>
</div>
