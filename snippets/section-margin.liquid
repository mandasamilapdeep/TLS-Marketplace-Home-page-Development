#shopify-section-{{ section.id }} {
{% if section.settings.margin_top == 'no-indent' %}
	padding-top: 0;
{% elsif section.settings.margin_top == 'xl' %}
	padding-top: 8rem;
{% elsif section.settings.margin_top == 'l' %}
	padding-top: 6.8rem;
{% elsif section.settings.margin_top == 'm' %}
	padding-top: 5.6rem;
{% elsif section.settings.margin_top == 's' %}
	padding-top: 3.2rem;
{% elsif section.settings.margin_top == 'xs' %}
	padding-top: 2.8rem;
{% endif %}

{% if section.settings.margin_bottom == 'no-indent' %}
	padding-bottom: 0;
{% elsif section.settings.margin_bottom == 'xl' %}
	padding-bottom: 8rem;
{% elsif section.settings.margin_bottom == 'l' %}
	padding-bottom: 6.8rem;
{% elsif section.settings.margin_bottom == 'm' %}
	padding-bottom: 5.6rem;
{% elsif section.settings.margin_bottom == 's' %}
	padding-bottom: 3.2rem;
{% elsif section.settings.margin_bottom == 'xs' %}
	padding-bottom: 2.8rem;
{% endif %}
}

@media screen and (min-width: 750px) { #shopify-section-{{ section.id }} {
{% if section.settings.margin_top == 'no-indent' %}
	padding-top: 0;
{% elsif section.settings.margin_top == 'xl' %}
	padding-top: 12.8rem;
{% elsif section.settings.margin_top == 'l' %}
	padding-top: 10.4rem;
{% elsif section.settings.margin_top == 'm' %}
	padding-top: 8rem;
{% elsif section.settings.margin_top == 's' %}
	padding-top: 4.8rem;
{% elsif section.settings.margin_top == 'xs' %}
	padding-top: 4rem;
{% endif %}

{% if section.settings.margin_bottom == 'no-indent' %}
	padding-bottom: 0;
{% elsif section.settings.margin_bottom == 'xl' %}
	padding-bottom: 12.8rem;
{% elsif section.settings.margin_bottom == 'l' %}
	padding-bottom: 10.4rem;
{% elsif section.settings.margin_bottom == 'm' %}
	padding-bottom: 8rem;
{% elsif section.settings.margin_bottom == 's' %}
	padding-bottom: 4.8rem;
{% elsif section.settings.margin_bottom == 'xs' %}
	padding-bottom: 4rem;
{% endif %}
} }
