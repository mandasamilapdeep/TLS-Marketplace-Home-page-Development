.section-{{ section.id }}-padding {
{% if section.settings.padding_top == 'xs' %}
	padding-top: 2.8rem;
{% elsif section.settings.padding_top == 'xl' %}
	padding-top: 8rem;
{% elsif section.settings.padding_top == 'l' %}
	padding-top: 6.8rem;
{% elsif section.settings.padding_top == 'm' %}
	padding-top: 5.6rem;
{% else %}
	padding-top: 0;
{% endif %}

{% if section.settings.padding_bottom == 'xs' %}
	padding-bottom: 2.8rem;
{% elsif section.settings.padding_bottom == 'xl' %}
	padding-bottom: 8rem;
{% elsif section.settings.padding_bottom == 'l' %}
	padding-bottom: 6.8rem;
{% elsif section.settings.padding_bottom == 'm' %}
	padding-bottom: 5.6rem;
{% else %}
	padding-bottom: 0;
{% endif %}
}

@media screen and (min-width: 750px) { .section-{{ section.id }}-padding {
{% if section.settings.padding_top == 'xs' %}
	padding-top: 4rem;
{% elsif section.settings.padding_top == 'xl' %}
	padding-top: 12.8rem;
{% elsif section.settings.padding_top == 'l' %}
	padding-top: 10.4rem;
{% elsif section.settings.padding_top == 'm' %}
	padding-top: 8rem;
{% elsif section.settings.padding_top == 's' %}
	padding-top: 4.8rem;
{% else %}
	padding-top: 0;
{% endif %}

{% if section.settings.padding_bottom == 'xs' %}
	padding-bottom: 4rem;
{% elsif section.settings.padding_bottom == 'xl' %}
	padding-bottom: 12.8rem;
{% elsif section.settings.padding_bottom == 'l' %}
	padding-bottom: 10.4rem;
{% elsif section.settings.padding_bottom == 'm' %}
	padding-bottom: 8rem;
{% elsif section.settings.padding_bottom == 's' %}
	padding-bottom: 4.8rem;
{% else %}
	padding-bottom: 0;
{% endif %}
} }
