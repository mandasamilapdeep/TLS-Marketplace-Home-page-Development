<ul
	class="header__submenu list-menu list-menu--disclosure motion-reduce {% if simple_mega_menu %}simple_mega_menu{% endif %}"
	role="list"
>
	{%- for childlink in link.links -%}
		<li class="header__submenu-li h5">
			{%- if childlink.links == blank -%}
				<a
					href="{{ childlink.url }}"
					class="header__menu-item header__submenu-item link focus-inset {% if simple_mega_menu %}h5{% endif %}"
					{% if childlink.current %}
						aria-current="page"
					{% endif %}
					aria-label="{{ childlink.title | escape }}"
				>
					<span class="{% if simple_mega_menu %}h5{% endif %}">
						{{ childlink.title | escape }}
					</span>
				</a>
			{%- else -%}
				<a
					href="{{ childlink.url }}"
					class="header__menu-item header__submenu-item link focus-inset"
					{% if childlink.current %}
						aria-current="page"
					{% endif %}
					aria-label="{{ childlink.title | escape }}"
				>
					<span class="{% if simple_mega_menu %}h5{% endif %}">
						{{ childlink.title | escape }}
					</span>
					{% render 'icon-caret' %}
				</a>
				<ul
					class="header__submenu list-menu--disclosure list-menu motion-reduce color-background-1"
					tabindex="0"
				>
					{%- for grandchildlink in childlink.links -%}
						<li>
							<a
								href="{{ grandchildlink.url }}"
								class="header__menu-item header__submenu-item header__submenu-item--grandchild link focus-inset"
								{% if grandchildlink.current %}
									aria-current="page"
								{% endif %}
								aria-label="{{ grandchildlink.title | escape }}"
							>
								<span class="{% if simple_mega_menu %}small-font{% endif %}">
									{{ grandchildlink.title | escape }}
								</span>
							</a>
						</li>
					{%- endfor -%}
				</ul>
			{%- endif -%}
		</li>
	{%- endfor -%}
</ul>
