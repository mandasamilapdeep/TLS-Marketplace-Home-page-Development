{{- 'marquee-ticker.css' | asset_url | stylesheet_tag -}}

<script src="{{ 'marquee-ticker.js' | asset_url }}" defer="defer"></script>

{% style %}
	#shopify-section-{{ id }} {
	  --marquee-ticker-speed: {{ ticker_speed  | default: 10 }};
	  --marquee-ticker-size: {{ ticker_size | default: '86px'  }};
	}
{% endstyle %}

{% if ticker_text != blank %}
	<div class="marquee-ticker-container">
		<div class="marquee-ticker-content">
			{% for i in (1..30) %}
				<span class="{% if transparent_text_stroke %} transparent-text-stroke{% endif %}">
					{{- ticker_text -}}
				</span>
			{% endfor %}
		</div>
	</div>
{% endif %}
