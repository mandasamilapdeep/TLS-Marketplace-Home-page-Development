<div class="header__first-level">
	<div class="header__first-level-wrapper container">
		{%- if section.settings.enable_country_selector
			or section.settings.enable_language_selector
		-%}
			<div class="header__localization-wrapper">
				{%- if section.settings.enable_country_selector
					and localization.available_countries.size > 1
				-%}
					<div class="header__localization">
						<noscript>
							{%- form 'localization',
								id: 'HeaderCountryFormNoScript',
								class: 'localization-form'
							-%}
								<div class="localization-form__select">
									<h2
										class="visually-hidden"
										id="HeaderCountryLabelNoScript"
									>
										{{ 'localization.country_label' | t }}
									</h2>
									<select
										class="localization-selector link"
										name="country_code"
										aria-labelledby="HeaderCountryLabelNoScript"
									>
										{%- for country in localization.available_countries -%}
											<option
												value="{{ country.iso_code }}"
												{%- if country.iso_code == localization.country.iso_code
												%}
													selected
												{% endif %}
											>
												{{ country.name }} ({{ country.currency.iso_code }}
												{{ country.currency.symbol }})
											</option>
										{%- endfor -%}
									</select>
									{% render 'icon-caret' %}
								</div>

								<div class="button_wrapper custom-hover">
									<button
										class="button button--secondary button--small focus-inset"
										data-button-text="{{ 'localization.update_country' | t }}"
									>
										<div class="button__content">
											<span
												class="button__label"
												data-label="{{- 'localization.update_country' | t | escape -}}"
											>
												{{ 'localization.update_country' | t }}
											</span>
										</div>
										<span class="button_circle"> </span>
									</button>
								</div>
							{%- endform -%}
						</noscript>
						<localization-form>
							{%- form 'localization',
								id: 'HeaderCountryForm',
								class: 'localization-form'
							-%}
								<div class="no-js-hidden">
									<div class="disclosure">
										<button
											type="button"
											class="disclosure__button localization-selector focus-inset"
											aria-expanded="false"
											aria-controls="HeaderCountryList"
											aria-describedby="HeaderCountryLabel"
											tabindex="0"
										>
											<span class="currency-country">
												{{- localization.country.name }}
												{{ localization.country.currency.iso_code }}
												{{ localization.country.currency.symbol -}}
											</span>
											{% render 'icon-caret' %}
										</button>
										<div
											id="HeaderCountryList"
											role="list"
											class="disclosure__list color-background-1"
											hidden
										>
											<div class="disclosure__list-label extra-small-font">
												{{- 'localization.region_label' | t -}}
											</div>
											<ul class="disclosure__list-items list-unstyled">
												{%- for country in localization.available_countries -%}
													<li class="disclosure__item" tabindex="-1">
														<a
															class="disclosure__link focus-inset"
															href="#"
															{% if country.iso_code
																	== localization.country.iso_code
															%}
																aria-current="true"
															{% endif %}
															aria-label="{{ country.name }}"
															data-value="{{ country.iso_code }}"
															data-flag="{{ country.currency.iso_code }}"
														>
															<span>
																<span class="small-font font-weight-bold">
																	{{- country.name }}
																	{% if country.iso_code
																			== localization.country.iso_code
																	%}
																		{% render 'icon-check' %}
																	{% endif -%}
																</span>
																<span class="localization-form__currency extra-small-font">
																	{{ country.currency.iso_code }}
																	{{ country.currency.symbol }}
																</span>
															</span>
														</a>
													</li>
												{%- endfor -%}
											</ul>
										</div>
										<div class="disclosure__overlay"></div>
									</div>
									<input
										type="hidden"
										name="country_code"
										value="{{ localization.country.iso_code }}"
									>
								</div>
							{%- endform -%}
						</localization-form>
					</div>
				{%- endif -%}

				{%- if section.settings.enable_language_selector
					and localization.available_languages.size > 1
				-%}
					<div class="header__localization header__localization--language">
						<noscript>
							{%- form 'localization',
								id: 'HeaderLanguageFormNoScript',
								class: 'localization-form'
							-%}
								<div class="localization-form__select">
									<h2
										class="visually-hidden"
										id="HeaderLanguageLabelNoScript"
									>
										{{ 'localization.language_label' | t }}
									</h2>
									<select
										class="localization-selector link"
										name="locale_code"
										aria-labelledby="HeaderLanguageLabelNoScript"
									>
										{%- for language in localization.available_languages -%}
											<option
												value="{{ language.iso_code }}"
												lang="{{ language.iso_code }}"
												{%- if language.iso_code
														== localization.language.iso_code
												%}
													selected
												{% endif %}
											>
												{{ language.endonym_name | capitalize }}
											</option>
										{%- endfor -%}
									</select>
									{% render 'icon-caret' %}
								</div>

								<div class="button_wrapper custom-hover">
									<button
										class="button button--secondary button--small focus-inset"
										data-button-text="{{ 'localization.update_language' | t }}"
									>
										<div class="button__content">
											<span
												class="button__label"
												data-label="{{- 'localization.update_language' | t | escape -}}"
											>
												{{ 'localization.update_language' | t }}
											</span>
										</div>
										<span class="button_circle"> </span>
									</button>
								</div>
							{%- endform -%}
						</noscript>
						<localization-form>
							{%- form 'localization',
								id: 'HeaderLanguageForm',
								class: 'localization-form'
							-%}
								<div class="no-js-hidden">
									<div class="disclosure">
										<button
											type="button"
											class="disclosure__button localization-selector focus-inset"
											aria-expanded="false"
											aria-controls="HeaderLanguageList"
											aria-describedby="HeaderLanguageLabel"
											tabindex="0"
										>
											<span class="value">
												{{ localization.language.endonym_name | capitalize }}
											</span>
											{% render 'icon-caret' -%}
										</button>
										<div
											id="HeaderLanguageList"
											role="list"
											class="disclosure__list color-background-1"
											hidden
										>
											<div class="disclosure__list-label extra-small-font">
												{{- 'localization.language_label' | t -}}
											</div>
											<ul class="disclosure__list-items list-unstyled">
												{%- for language in localization.available_languages -%}
													<li class="disclosure__item" tabindex="-1">
														<a
															class="disclosure__link focus-inset"
															href="#"
															hreflang="{{ language.iso_code }}"
															lang="{{ language.iso_code }}"
															{% if language.iso_code
																	== localization.language.iso_code
															%}
																aria-current="true"
															{% endif %}
															aria-label="{{ language.endonym_name }}"
															data-value="{{ language.iso_code }}"
														>
															<span class="small-font font-weight-bold">
																{{ language.endonym_name | capitalize }}
																{% if language.iso_code
																		== localization.language.iso_code
																%}
																	{% render 'icon-check' %}
																{% endif %}
															</span>
														</a>
													</li>
												{%- endfor -%}
											</ul>
										</div>
										<div class="disclosure__overlay"></div>
									</div>
									<input
										type="hidden"
										name="locale_code"
										value="{{ localization.language.iso_code }}"
									>
								</div>
							{%- endform -%}
						</localization-form>
					</div>
				{%- endif -%}
			</div>
		{%- endif -%}
		{%- if section.settings.menu_top != blank -%}
			<nav class="header__inline-menu-top">
				<ul class="list-menu list-menu--inline" role="list">
					{%- for link in section.settings.menu_top.links -%}
						{% liquid
							assign mega_menu = false
						%}

						{% if section.blocks.size > 0 %}
							{% for block in section.blocks %}
								{% liquid
									assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip

									if link.handle == mega_menu_trigger
										assign mega_menu = true
									endif
								%}
							{% endfor %}
						{% endif %}
						<li class="list-menu-item{% if link.current and link.url != '/' %} list-menu-item--active{% endif %}">
							<a
								href="{{ link.url }}"
								class="menu-top-item list-menu__item extra-small-font focus-inset{% if link.current and link.url != '/' %} header__active-menu-item{% endif %}"
								{% if link.current and link.url != '/' %}
									aria-current="page"
								{% endif %}
								aria-label="{{ link.title | escape }}"
							>
								<span title="{{ link.title | escape }}">
									{{ link.title | escape }}
								</span>
							</a>
						</li>
					{%- endfor -%}
				</ul>
			</nav>
		{%- endif -%}
	</div>
</div>
<div class="header__second-level container">
	<div class="header__left">
		{%- if section.settings.menu != blank -%}
			{% render 'header-drawer' %}
		{%- endif -%}

		{%- if settings.enable_aside_menu
			and section.settings.header_type != 'left-logo-second'
		-%}
			<button
				class="header__offcanvas-toggle aside-menu__toggle aside-menu__toggle--open-btn button--unstyled focus-inset js-aside-menu-toggle"
				aria-label="{{ 'sections.header.aside_menu' | t }}"
			>
				{% render 'icon-menu' %}
				{% comment %}{% render 'icon-close-mobile-menu' %}{% endcomment %}
			</button>
			{%- if settings.enable_aside_menu -%}
				{%- render 'aside-menu' -%}
			{%- endif -%}
		{%- endif -%}

		{%- if section.settings.header_type == 'left-logo'
			or section.settings.header_type == 'left-logo-second'
		-%}
			{% render 'header-logo', header_type: section.settings.header_type %}
		{%- endif -%}

		{%- if section.settings.menu != blank -%}
			<nav class="header__inline-menu">
				{%- if settings.enable_aside_menu
					and section.settings.header_type == 'left-logo-second'
				-%}
					<button
						class="header__offcanvas-toggle aside-menu__toggle aside-menu__toggle--open-btn button--unstyled focus-inset js-aside-menu-toggle"
						aria-label="{{ 'sections.header.aside_menu' | t }}"
					>
						{% render 'icon-menu' %}
						{% render 'icon-close-mobile-menu' %}
					</button>
					{%- if settings.enable_aside_menu -%}
						{%- render 'aside-menu' -%}
					{%- endif -%}
				{%- endif -%}
				<ul class="list-menu list-menu--inline" role="list">
					{%- for link in section.settings.menu.links -%}
						{% liquid
							assign mega_menu = false
							assign simple_mega_menu = false
						%}

						{% if section.blocks.size > 0 %}
							{% for block in section.blocks %}
								{% liquid
									assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip
									assign simple_mega_menu_trigger = block.settings.simple_mega_menu_trigger | handle | strip

									if link.handle == mega_menu_trigger
										assign mega_menu = true
									elsif link.handle == simple_mega_menu_trigger
										assign simple_mega_menu = true
									endif
								%}
							{% endfor %}
						{% endif %}

						{%- if mega_menu -%}
							<li
								class="list-menu-item list-menu--megamenu{% if link.current and link.url != '/' %} list-menu-item--active{% endif %}"
								{{ shopify_attributes }}
							>
								<a
									href="{{ link.url }}"
									class="header__menu-item list-menu__item link focus-inset{% if link.current and link.url != '/' %} header__active-menu-item{% endif %}"
									{% if link.current and link.url != '/' %}
										aria-current="page"
									{% endif %}
									aria-label="{{ link.title | escape }}"
								>
									<span title="{{ link.title | escape }}">
										{{ link.title | escape }}
									</span>
								</a>
								<div class="header__mega-menu mega-menu color-background-1">
									{% render 'mega-menu', link: link, blocks: section.blocks %}
								</div>
							</li>
						{%- elsif link.links != blank -%}
							<li
								class="list-menu-item list-menu--submenu{% if link.current and link.url != '/' %} list-menu-item--active{% endif %}"
								{{ shopify_attributes }}
							>
								<a
									href="{{ link.url }}"
									class="header__menu-item list-menu__item link focus-inset{% if link.current and link.url != '/' %} header__active-menu-item{% endif %}"
									{% if link.current and link.url != '/' %}
										aria-current="page"
									{% endif %}
									aria-label="{{ link.title | escape }}"
								>
									<span title="{{ link.title | escape }}">
										{{ link.title | escape }}
									</span>
									{% render 'icon-caret' %}
								</a>
								{% render 'submenu',
									link: link,
									simple_mega_menu: simple_mega_menu
								%}
							</li>
						{%- else -%}
							<li class="list-menu-item{% if link.current and link.url != '/' %} list-menu-item--active{% endif %}">
								<a
									href="{{ link.url }}"
									class="header__menu-item list-menu__item link focus-inset{% if link.current and link.url != '/' %} header__active-menu-item{% endif %}"
									{% if link.current and link.url != '/' %}
										aria-current="page"
									{% endif %}
									aria-label="{{ link.title | escape }}"
								>
									<span title="{{ link.title | escape }}">
										{{ link.title | escape }}
									</span>
								</a>
							</li>
						{%- endif -%}
					{%- endfor -%}
					<li id="blob"></li>
				</ul>
				{% if section.settings.header_type == 'left-logo-second'
					and section.settings.enable_search
				%}
					{% if request.page_type != 'search' %}
						<div class="header__search">
							<div
								class="header__icon header__icon--search header__icon--summary focus-inset search-open-btn"
								aria-haspopup="dialog"
								aria-label="Open search"
								role="button"
							>
								{% render 'icon-search' %}
								<div
									class="header__search-mobile-close modal-close-button"
									aria-label="Close search"
								>
									{%- render 'icon-close' -%}
								</div>
							</div>
							<div
								class="header__search-inner search color-background-1"
								role="dialog"
								aria-modal="true"
								aria-label="{{ 'general.search.search' | t }}"
							>
								<div class="search__content">
									<div class="search__main">
										{%- if settings.predictive_search_enabled -%}
											<predictive-search
												class="search-modal__form"
												data-loading-text="{{ 'accessibility.loading' | t }}"
											>
										{%- endif -%}
										<div class="search__container container">
											<form
												action="{{ routes.search_url }}"
												method="get"
												role="search"
												class="search search__form"
											>
												<label class="field" for="search-input-header">
													<button
														class="search__button button focus-inset"
														aria-label="{{ 'general.search.search' | t }}"
													>
														{% render 'icon-search' %}
													</button>
													<input
														id="search-input-header"
														dir="ltr"
														class="search__input field__input focus-inset"
														id="Search-In-Modal-1"
														type="search"
														name="q"
														value="{{ search.terms | escape }}"
														placeholder="{{ 'general.search.placeholder' | t }}"
														{%- if settings.predictive_search_enabled -%}
															role="combobox"
															aria-expanded="false"
															aria-owns="predictive-search-results-list"
															aria-controls="predictive-search-results-list"
															aria-haspopup="listbox"
															aria-autocomplete="list"
															autocorrect="off"
															autocomplete="off"
															autocapitalize="off"
															spellcheck="false"
														{%- endif -%}
														tabindex="0"
													>
													<label
														class="visually-hidden"
														for="Search-In-Modal-1"
													>
														{{- 'general.search.search' | t -}}
													</label>
													<input
														type="hidden"
														name="options[prefix]"
														value="last"
													>
													<div class="button_wrapper custom-hover">
														<button
															type="submit"
															class="button button--primary focus-inset"
															data-button-text="{{ 'general.search.search' | t }}"
															tabindex="0"
														>
															<div class="button__content">
																<span
																	class="button__label"
																	data-label="{{- 'general.search.search' | t | escape -}}"
																>
																	{{- 'general.search.search' | t -}}
																</span>
															</div>
															<span class="button_circle"> </span>
														</button>
													</div>
												</label>
												{%- if settings.predictive_search_enabled -%}
													<div
														class="predictive-search predictive-search--header"
														tabindex="-1"
														data-predictive-search
													>
														<div class="predictive-search__loading-state">
															{% render 'icon-spinner' %}
														</div>
													</div>

													<span
														class="predictive-search-status visually-hidden"
														role="status"
														aria-hidden="true"
													></span>
												{%- endif -%}
											</form>
										</div>
										{%- if settings.predictive_search_enabled -%}
											</predictive-search>
										{%- endif -%}
										{% render 'search-modal', blocks: section.blocks %}
									</div>

									<span
										class="skip-to-close-button visually-hidden focus-inset"
										aria-label="{{- 'accessibility.skip_to_close' | t -}}"
										tabindex="0"
									>
										{{- 'accessibility.skip_to_close' | t -}}
									</span>
								</div>
							</div>
						</div>
					{%- else -%}
						<div class="header__search">
							<a
								href="{{ routes.search_url }}"
								class="header__icon header__icon--search   header__icon--summary search-open-btn focus-inset"
								title="{{ 'general.search.search' | t }}"
								aria-label="{{ 'general.search.search' | t }}"
							>
								{% render 'icon-search' %}
							</a>
						</div>
					{%- endif -%}
					<noscript>
						<div class="header__search">
							<a
								href="{{ routes.search_url }}"
								class="header__icon header__icon--search link--text  header__icon--summary search-open-btn focus-inset"
								title="{{ 'general.search.search' | t }}"
								aria-label="{{ 'general.search.search' | t }}"
							>
								{% render 'icon-search' %}
							</a>
						</div>
					</noscript>
				{% endif %}
			</nav>
			<div class="header__submenu__overlay color-background-3"></div>
		{%- endif -%}
	</div>

	{%- if section.settings.header_type == 'center-logo' -%}
		{% render 'header-logo', header_type: section.settings.header_type %}
	{%- endif -%}

	<div class="header__icons">
		<div class="header__icons-wrapper">
			<div class="{% if section.settings.header_type == 'left-logo-second' %}header__search-hide-desktop{% endif %}">
				{%- if section.settings.enable_search -%}
					{% if request.page_type != 'search' %}
						<div class="header__search">
							<div
								class="header__icon header__icon--search link--text header__icon--summary focus-inset modal__toggle search-open-btn"
								aria-haspopup="dialog"
								role="button"
								aria-label="Open search"
							>
								{% render 'icon-search' %}
								<div
									class="header__search-mobile-close modal-close-button"
									aria-label="Close search"
								>
									{%- render 'icon-close' -%}
								</div>
							</div>
							<div
								class="header__search-inner search color-background-1"
								role="dialog"
								aria-modal="true"
								aria-label="{{ 'general.search.search' | t }}"
							>
								<div class="search__content">
									<div class="search__main">
										{%- if settings.predictive_search_enabled -%}
											<predictive-search
												class="search-modal__form"
												data-loading-text="{{ 'accessibility.loading' | t }}"
											>
										{%- endif -%}
										<div class="search__container container">
											<form
												action="{{ routes.search_url }}"
												method="get"
												role="search"
												class="search search__form"
											>
												<label class="field" for="search-input-header">
													<button
														class="search__button button focus-inset"
														aria-label="{{ 'general.search.search' | t }}"
													>
														{% render 'icon-search' %}
													</button>
													<input
														dir="ltr"
														id="search-input-header"
														class="search__input field__input focus-inset"
														id="Search-In-Modal-1"
														type="search"
														name="q"
														value="{{ search.terms | escape }}"
														placeholder="{{ 'general.search.placeholder' | t }}"
														{%- if settings.predictive_search_enabled -%}
															role="combobox"
															aria-expanded="false"
															aria-owns="predictive-search-results-list"
															aria-controls="predictive-search-results-list"
															aria-haspopup="listbox"
															aria-autocomplete="list"
															autocorrect="off"
															autocomplete="off"
															autocapitalize="off"
															spellcheck="false"
														{%- endif -%}
														tabindex="0"
													>
													<label
														class="visually-hidden"
														for="Search-In-Modal-1"
													>
														{{- 'general.search.search' | t -}}
													</label>
													<input
														type="hidden"
														name="options[prefix]"
														value="last"
													>
													<div class="button_wrapper custom-hover">
														<button
															type="submit"
															class="button button--primary focus-inset"
															data-button-text="{{ 'general.search.search' | t }}"
															tabindex="0"
														>
															<div class="button__content">
																<span
																	class="button__label"
																	data-label="{{- 'general.search.search' | t | escape -}}"
																>
																	{{- 'general.search.search' | t -}}
																</span>
															</div>
															<span class="button_circle"> </span>
														</button>
													</div>
												</label>

												{%- if settings.predictive_search_enabled -%}
													<div
														class="predictive-search predictive-search--header"
														tabindex="-1"
														data-predictive-search
													>
														<div class="predictive-search__loading-state">
															{% render 'icon-spinner' %}
														</div>
													</div>

													<span
														class="predictive-search-status visually-hidden"
														role="status"
														aria-hidden="true"
													></span>
												{%- endif -%}
											</form>
										</div>
										{%- if settings.predictive_search_enabled -%}
											</predictive-search>
										{%- endif -%}
										{% render 'search-modal', blocks: section.blocks %}
									</div>

									<span
										class="skip-to-close-button visually-hidden focus-inset"
										aria-label="{{- 'accessibility.skip_to_close' | t -}}"
										tabindex="0"
									>
										{{- 'accessibility.skip_to_close' | t -}}
									</span>
								</div>
							</div>
						</div>
					{%- else -%}
						<div class="header__search">
							<a
								href="{{ routes.search_url }}"
								class="header__icon header__icon--search link--text  header__icon--summary search-open-btn focus-inset"
								title="{{ 'general.search.search' | t }}"
								aria-label="{{ 'general.search.search' | t }}"
							>
								{% render 'icon-search' %}
							</a>
						</div>
					{%- endif -%}
					<noscript>
						<div class="header__search">
							<a
								href="{{ routes.search_url }}"
								class="header__icon header__icon--search link--text  header__icon--summary search-open-btn focus-inset"
								title="{{ 'general.search.search' | t }}"
								aria-label="{{ 'general.search.search' | t }}"
							>
								{% render 'icon-search' %}
							</a>
						</div>
					</noscript>
				{%- endif -%}
			</div>
			{%- if shop.customer_accounts_enabled -%}
				<details-disclosure class="header__account">
					<details>
						<summary
							class="header__icon header__icon--account header__icon--summary focus-inset modal__toggle"
							aria-haspopup="dialog"
							role="button"
						>
							{% render 'icon-account' %}
						</summary>
						<div
							class="header__account-modal modal__toggle color-background-1 {% if customer %}header__account-modal-login{% endif %}"
							role="dialog"
							aria-modal="true"
						>
							{%- if customer -%}
								<div class="header__account__account">
									<span class="header__account__subtitle extra-small-font">
										{{- 'customer.account_fallback' | t -}}
									</span>
									<div class="header__account__name large-font">
										{{ 'customer.account_welcome' | t -}}
										<br>
										{{ customer.name }}
									</div>
									<ul class="header__account__body">
										<li class="header__account__link">
											<a
												class="small-font"
												href="{{ routes.account_url }}"
												aria-label="{{ 'customer.account_fallback' | t }}"
											>
												{{ 'customer.account_fallback' | t }}
											</a>
										</li>
										<li class="header__account__address">
											<a
												class="small-font"
												href="{{ routes.account_addresses_url }}"
												aria-label="{{ 'customer.addresses.book' | t }}"
											>
												{{- 'customer.addresses.book' | t -}}
											</a>
										</li>
									</ul>

									<div class="button_wrapper header__account__logout">
										<a
											href="{{ routes.account_logout_url }}"
											data-button-text="{{ 'customer.log_out' | t | escape }}"
											aria-label="{{ 'customer.log_out' | t | escape }}"
											class="link button button--link"
										>
											<span class="small-font">
												{{ 'customer.log_out' | t }}
											</span>
										</a>
									</div>
								</div>
							{%- else -%}
								<div class="button_wrapper custom-hover">
									<a
										href="{{ routes.account_register_url }}"
										data-button-text="{{ 'customer.login_page.create_account' | t | escape }}"
										aria-label="{{ 'customer.login_page.create_account' | t | escape }}"
										class="header__account__register link button button--primary"
									>
										<div class="button__content">
											<span
												class="button__label"
												data-label="{{ 'customer.login_page.create_account' | t | escape }}"
											>
												{{ 'customer.login_page.create_account' | t }}
											</span>
										</div>
										<span class="button_circle"></span>
									</a>
								</div>
								<span class="account_descr small-font">
									{{-
										'customer.activate_account.already_have_an_account'
										| t
									-}}
								</span>
								<a
									href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
									class="button button--link button header__account__login link focus-inset small-font"
									{%- if customer -%}
										data-button-text="{{ 'customer.account_fallback' | t }}"
										aria-label="{{ 'customer.account_fallback' | t }}"
									{%- else -%}
										data-button-text="{{ 'customer.log_in' | t }}"
										aria-label="{{ 'customer.log_in' | t }}"
									{%- endif -%}
								>
									<span>
										{% if customer %}
											{{ 'customer.account_fallback' | t }}
										{% else %}
											{{ 'customer.log_in' | t }}
										{% endif %}
									</span>
								</a>
							{%- endif -%}
						</div>
						<div
							class="header__account__overlay color-background-3"
						></div>
					</details>
				</details-disclosure>
			{%- endif -%}

			<div class="{% if request.page_type != 'cart' %}header__cart {% else %} header__cart--page{% endif %}">
				<a
					href="{{ routes.cart_url }}"
					class=" header__icon header__icon--cart {% if cart.item_count > 0  %}header__cart-has-items{% endif %} link focus-inset"
					id="cart-icon-bubble"
					aria-label="{{ 'general.cart.view' | t }}"
				>
					{% render 'icon-cart' %}
					<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
					{%- if cart.item_count > 0 -%}
						<div class="cart-count-bubble {% if cart.item_count >= 100 %} cart-count-bubble-very-long{% endif %}">
							{%- if cart.item_count < 100 -%}
								<span aria-hidden="true">{{ cart.item_count }}</span>
							{%- else -%}
								<span
									class="cart-count-bubble-very-long-number"
									aria-hidden="true"
									>99+</span
								>
							{%- endif -%}
							<span class="visually-hidden">
								{{- 'sections.header.cart_count' | t: count: cart.item_count -}}
							</span>
						</div>
					{%- endif -%}
				</a>
			</div>
		</div>
	</div>
</div>
