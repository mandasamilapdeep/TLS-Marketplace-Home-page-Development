{{ 'component-main-product-info.css' | asset_url | stylesheet_tag }}

<div
	id="ProductInfo-{{ section.id }}"
	data-section="{{ section.id }}"
	class="product__info-container"
>
	<div class="product__info-container--col without-buy-box">
		{%- for block in section.blocks -%}
			{%- case block.type -%}
				{%- when 'vendor_name' -%}
					{% render 'main-product-info-vendor-name',
						text: block.settings.text,
						vendor: product.vendor,
						enable_vendor_link: settings.enable_vendor_link,
						shopify_attributes: block.shopify_attributes
					%}
				{%- when 'product_title' -%}
					{% render 'main-product-info-heading',
						badges_type: block.settings.badges_type,
						badge_soldout_show: settings.badge_soldout_show,
						shopify_attributes: block.shopify_attributes,
						product_title: product.title,
						product_available: product.available,
						badge_sale_show: settings.badge_sale_show,
						badges_color: 'background-1',
						compare_at_price: product.compare_at_price,
						product_price: product.price,
						badge_sale_type: settings.badge_sale_type,
						badge_custom_show: settings.badge_custom_show,
						product_metafields: product.metafields,
						show_badges: block.settings.show_badges,
						heading_tag: block.settings.section_heading_tag
				%}
			{%- when '@app' -%}
				<div class="product__info-app-block" {{ block.shopify_attributes }}>
					{% render block %}
				</div>
			{%- when 'core_benefit' -%}
				{% render 'main-product-core-benefit', block: block, product: product %}
{% when 'tls_product_tags' %}
  {% render 'tls-product-tags', product: product %}
			{%- when 'feature_grid' -%}
				{% render 'main-product-feature-grid', block: block %}
			{%- when 'short_description' -%}
					{% assign long_description_link = product.url
						| append: '#description'
					%}
					{% render 'main-product-short-description',
						shopify_attributes: block.shopify_attributes,
						show_read_more: true,
						long_description_link: long_description_link,
						product: product
					%}
				{%- when 'sku' -%}
					<p
						class="product__sku no-js-hidden{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hiddenxxx{% endif %}"
						id="Sku-{{ section.id }}"
						role="status"
					>
						<span class="visually-hidden">
							{{- 'products.product.sku' | t }}:</span
						>
						{{- product.selected_or_first_available_variant.sku -}}
					</p>
				{%- when 'variant_picker' -%}
					<div class="product-parameters">
						{% unless product.has_only_default_variant %}
							{% if block.settings.picker_type == 'button' %}
								{% comment %}----------  PRODUCT VARIANT RADIOS ------------{% endcomment %}
								<variant-radios
									id="variant-radios-{{ product.id }}"
									class="no-js-hidden"
									data-section="{{ section.id }}"
									data-url="{{ product.url }}"
									{{ block.shopify_attributes }}
								>
									{%- for option in product.options_with_values -%}
										{% liquid
											assign color_trigger = settings.trigger_swatch | append: '<br />' | append: settings.trigger_swatch_other | strip | newline_to_br | split: '<br />'
											assign name_option = option.name | handle | strip

											# check is color option or not
											assign is_color_option = false
											# for custom swatch type
											if settings.type_color_swatch == 'custom'
												for item in color_trigger
													assign item_temp = item | handle | strip
													if name_option == item_temp
														assign is_color_option = true
													endif
												endfor
											endif

											# for standart swatch type
											if settings.type_color_swatch == 'standart'
												for value in option.values
													if value.swatch.color != blank
														assign is_color_option = true
													endif
												endfor
											endif
										%}

										<fieldset
											class="product-form__controls{% if is_color_option %} product-form__controls--colors{% endif %}"
											id="SingleOptionSelector-{{ forloop.index0 }}"
											style="{% if is_color_option and block.settings.show_swatches == false %} display: none; {% endif %}"
										>
											<div class="product-form__group-wrapper">
												<legend class="product-form__group-name">
													{{ option.name }}:
												</legend>
												<div class="product-form__controls-group">
													{% comment %}----------  PRODUCT VARIANT OPTIONS ------------{% endcomment %}

													{%- liquid
														assign variants_available_arr = product.variants | map: 'available'
														assign variants_option1_arr = product.variants | map: 'option1'
														assign variants_option2_arr = product.variants | map: 'option2'
														assign variants_option3_arr = product.variants | map: 'option3'
														assign product_form_id = 'product-form-' | append: product.id
													-%}

													{%- for value in option.values -%}
														{%- liquid
															assign option_disabled = true

															for option1_name in variants_option1_arr
																case option.position
																	when 1
																		if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
																			assign option_disabled = false
																		endif
																	when 2
																		if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
																			assign option_disabled = false
																		endif
																	when 3
																		if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
																			assign option_disabled = false
																		endif
																endcase
															endfor
														-%}

														{% if is_color_option %}
															{% liquid
																if settings.type_color_swatch == 'standart' and value.swatch.image != blank
																	assign color_image = value.swatch.image | image_url: width: 60
																	assign color_value = 'url(' | append: color_image | append: ') no-repeat center/cover'
																elsif settings.type_color_swatch == 'standart' and value.swatch.color != blank
																	assign color_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
																else
																	assign init_color_value = value.name | handle | strip
																	assign color_value = init_color_value | remove: '-'

																	if settings.custom_colors != blank
																		assign custom_colors_string = settings.custom_colors | strip
																		assign custom_colors_obj = custom_colors_string | newline_to_br | split: '<br />'

																		for obj in custom_colors_obj
																			assign obj_strip = obj | strip
																			assign obj_key = obj_strip | split: ':' | first
																			assign obj_value = obj_strip | split: ':' | last
																			assign obj_color_name = obj_key | handle | strip

																			if init_color_value == obj_color_name
																				assign obj_color_value = obj_value | strip
																				if obj_color_value contains 'gradient'
																					assign color_value = obj_color_value
																				else
																					assign color_value = obj_color_value | remove: '-'
																				endif
																				break
																			endif
																		endfor
																	endif
																endif
															%}

															{% liquid
																assign variant_link = product.url

																for variant in product.variants
																	assign flag = false
																	if variant.available
																		for option_variant in variant.options
																			if option_variant == value
																				assign flag = true
																				break
																			endif
																		endfor
																	endif

																	if flag == true
																		assign variant_link = variant.url
																		assign variant_id = variant.id
																		break
																	endif
																endfor
															%}

															<input
																type="radio"
																id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}-{{ product.id }}"
																name="{{ option.name }}-{{ section.id }}-{{ product.id }}"
																value="{{ value | escape }}"
																{% if variant_link %}
																	data-variant-link="{{ variant_link }}"
																{% endif %}
																{% if variant_id %}
																	data-variant-id="{{ variant_id }}"
																{% endif %}
																{% if no_form_id != true %}
																	form="{{ product_form_id }}"
																{% endif %}
																{% if option.selected_value == value %}
																	checked
																{% endif %}
																{% if option_disabled and no_form_id != true %}
																	class="disabled"
																{% endif %}
																tabindex="0"
															>

															{% liquid
																if color_value == 'white' or color_value == '#fff' or color_value == '#ffffff' or color_value == '255,255,255' or color_value_custom == '255,255,255,1' or color_value == 'rgb(255 255 255)'
																	assign is_white = true
																else
																	assign is_white = false
																endif

																if color_value == 'black' or color_value == '#000' or color_value == '#000000' or color_value == '0,0,0' or color_value == '0,0,0,1' or color_value == 'rgb(0 0 0)'
																	assign is_black = true
																else
																	assign is_black = false
																endif
															%}
															<label
																for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}-{{ product.id }}"
																class="color-swatch focus-inset{% if is_white %} color-white{% endif %}{% if is_black %} color-black{% endif %}"
																style="--swatch-color: {{ color_value }}; border-radius: {{ settings.swatch_border_radius }}px"
																aria-label="{{- value -}}"
																{% comment %}tabindex="0"{% endcomment %}
															>
																<span class="{% if settings.show_color_swatch_title %}color-swatch-title{% else %}visually-hidden{% endif %}">
																	{{- value -}}
																</span>
															</label>
														{% else %}
															{% liquid
																assign picker_type = 'button'

																if block != blank and block.settings.picker_type
																	assign picker_type = block.settings.picker_type
																endif
															%}
															{% if picker_type == 'button' %}
																<input
																	type="radio"
																	id="{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}-{{ product.id }}"
																	name="{{ option.name }}"
																	value="{{ value | escape }}"
																	{% if no_form_id != true %}
																		form="{{ product_form_id }}"
																	{% endif %}
																	{% if option.selected_value == value %}
																		checked
																	{% endif %}
																	{% if option_disabled %}
																		class="disabled"
																	{% endif %}
																	tabindex="0"
																>
																<label
																	for="{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}-{{ product.id }}"
																	class="focus-inset"
																	{% comment %}tabindex="0"{% endcomment %}
																>
																	{{ value -}}
																	<span class="visually-hidden">
																		{{-
																			'products.product.variant_sold_out_or_unavailable'
																			| t
																		-}}
																	</span>
																</label>
															{% elsif block.settings.picker_type == 'dropdown'
															%}
																<option
																	value="{{ value | escape }}"
																	{% if option.selected_value == value %}
																		selected="selected"
																	{% endif %}
																>
																	{% if option_disabled -%}
																		{{-
																			'products.product.value_unavailable'
																			| t: option_value: value
																		-}}
																	{%- else -%}
																		{{- value -}}
																	{%- endif %}
																</option>
															{% endif %}
														{% endif %}
													{%- endfor -%}

													{% comment %}
														MORE COLORS COUNT
													{% endcomment %}

													{% liquid
														assign enabled_color_values_count = 0
													%}

													{%- for value in option.values -%}
														{%- liquid
															assign option_disabled = true

															for option1_name in variants_option1_arr
																case option.position
																	when 1
																		if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
																			assign option_disabled = false
																		endif
																	when 2
																		if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
																			assign option_disabled = false
																		endif
																	when 3
																		if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
																			assign option_disabled = false
																		endif
																endcase
															endfor

															if option_disabled != true
																assign enabled_color_values_count = enabled_color_values_count | plus: 1
															endif
														-%}
													{% endfor %}
												</div>
											</div>
										</fieldset>
									{%- endfor -%}

									<script type="application/json">
										{{ product.variants | json }}
									</script>
								</variant-radios>
							{% else %}
								{% render 'main-product-variant-selects',
									section: section,
									settings: settings,
									product: product,
									block: block,
									show_swatches: block.settings.show_swatches
								%}
							{% endif %}
						{% endunless %}
					</div>
				{% when 'specs_short' %}
					{% render 'main-product-specs-short',
						product: product,
						specs_short_link: '#specs_long',
						specs_size: 4
					%}
			{%- endcase -%}
		{%- endfor -%}
	</div>

	<div class="product__info-container--col">
		{%- for block in section.blocks -%}
			{%- case block.type -%}
				{%- when 'buy_box' -%}
					{% render 'buy-box', block: block %}
					{% render 'main-product-sticky-buy-box',
						block: block,
						section: section
					%}
				{%- when 'benefits_grid' -%}
					{% render 'main-product-benefits-grid', block: block %}
				{%- when 'countdown' -%}
					<div class="main-product__countdown">
						{% if block.settings.contdown_heading != blank %}
							<p class="main-product__countdown--heading h5">
								{{ block.settings.contdown_heading }}
							</p>
						{% endif %}

						{% render 'countdown',
							id: section.id,
							section_settings: block.settings,
							with_bg: true,
							countdown_heading: block.settings.text_after_countdown,
							enable_mock_timer: block.settings.enable_mock_timer,
							mock_date_picker_day: block.settings.mock_date_picker_day,
							mock_date_picker_hours: block.settings.mock_date_picker_hours
						%}
					</div>
				{%- when 'inventory' -%}
					{% render 'main-product-inventory', block: block %}
				{%- when 'pickup_availability' -%}
					{% render 'main-product-pickup-availability', block: block %}
				{% when 'express_shipping' %}
					{% render 'main-product-express-shipping', block: block %}
			{%- endcase -%}
		{%- endfor -%}
	</div>
</div>
