{% style %}
      #background-image-with-text-section_{{ section.id }} {
        padding-top: {{ section.settings.padding_top_desktop }}px;
        padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        background-image: url("{{ section.settings.bg_image_desktop | image_url }}");
        background-size: contain;
        background-position: right;
        background-repeat: no-repeat;
        background-color: {{ section.settings.bg_color }};

      }
      
      #background-image-with-text-section_{{ section.id }} .container .background-image-with-text-section-inner{
        padding-top: {{ section.settings.container_padding_top_desktop }}px;
        padding-bottom: {{ section.settings.container_padding_bottom_desktop }}px;
        padding-left: {{ section.settings.container_padding_left_desktop }}px;
        padding-right: {{ section.settings.container_padding_right_desktop }}px;
        background-image: url("{{ section.settings.container_bg_image_desktop | image_url }}");
        background-size: {{ section.settings.container_bg_image_desktop_size }};
        background-position: {{ section.settings.container_bg_image_desktop_postion }};
        background-repeat: no-repeat;
        {% if section.settings.container_border_color_show == true %}
          border: 1px solid {{ section.settings.container_border_color }};
          border-radius: {{ section.settings.container_border_radius_desktop }}px;
        {% endif %}
        overflow: hidden;
        {% if section.settings.image_desktop == blank and section.settings.text_align_center == true %}
        justify-content:center;
        text-align:center;
        {% endif %}

      }
      #background-image-with-text-section_{{ section.id }} .text_box_outer {
        max-width: {{ section.settings.text_box_max_width }}px;
        padding-left: {{ section.settings.text_box_padding_left_desktop }}px;
        padding-right: {{ section.settings.text_box_padding_right_desktop }}px;
        padding-top: {{ section.settings.text_box_padding_top_desktop }}px;
        padding-bottom: {{ section.settings.text_box_padding_bottom_desktop }}px;
        width: 100%;
      }
      {% if section.settings.image_desktop != blank %}
      #background-image-with-text-section_{{ section.id }} .image_box {
        max-width: calc(100% - {{ section.settings.text_box_max_width }}px);
        width: 100%;
      }
      {% endif %}
      #background-image-with-text-section_{{ section.id }} span.line span.dot {
          width: 100%;
          background: transparent;
          height: 1px;
          position: relative;
          display: block;
      }
      #background-image-with-text-section_{{ section.id }} .line .dot::before {
          content: "";
          background-color: {{ section.settings.subtitle_line_dot_bg_color }};
          width: 10px;
          height: 10px;
          position: absolute;
          border-radius: 100%;
          right: -2px;
          top: 50%;
          transform: translateY(-50%);
          z-index: 1;
      }
      #background-image-with-text-section_{{ section.id }} .line .dot::after {
        content: "";
        background: {{ section.settings.subtitle_line_dot_gradient }};
        width: 18px;
        height: 18px;
        position: absolute;
        border-radius: 100%;
        right: -6px;
          top: 50%;
          transform: translateY(-50%);
      }
      #background-image-with-text-section_{{ section.id }} .sub_title {
        color: {{ section.settings.subtitle_color }};
        font-size: {{ section.settings.subtitle_font_size_dekstop }}px;
        letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;

      }
      #background-image-with-text-section_{{ section.id }} .title {
        color: {{ section.settings.title_color }};
        font-size: {{ section.settings.title_font_size_dekstop }}px;
        {% if section.settings.image_desktop == blank and section.settings.text_align_center == true %}
        margin-left: auto;
        margin-right: auto;
      {% endif %}
      }
      #background-image-with-text-section_{{ section.id }} .first_title {
        max-width: {{ section.settings.first_title_max_width }}px;
        margin-top: {{ section.settings.first_title_margin_top_dekstop }}px;
      }
      #background-image-with-text-section_{{ section.id }} .title.second_title {
        background: {{ section.settings.second_title_gradient }};
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      #background-image-with-text-section_{{ section.id }} .text {
        font-size: {{ section.settings.text_font_size_desktop }}px;
        max-width: {{ section.settings.text_max_width }}px;
        margin-top: {{ section.settings.text_margin_top_desktop }}px;
        {% if section.settings.image_desktop == blank and section.settings.text_align_center == true %}
        margin-left: auto;
        margin-right: auto;
      {% endif %}
      }
      #background-image-with-text-section_{{ section.id }} .button_box_inner {
        {% if section.settings.image_desktop == blank and section.settings.text_align_center == true %}
        justify-content: center;
      {% endif %}
      }

      #background-image-with-text-section_{{ section.id }} .icon_with_text_box {
        margin-bottom: {{ section.settings.icon_text_margin_bottom_desktop }}px;

      }
      #background-image-with-text-section_{{ section.id }} .icon_with_text {
        color: {{ section.settings.icon_text_color }};
        font-size: {{ section.settings.icon_text_font_size_desktop }}px;
        margin-top: {{ section.settings.icon_text_margin_top_desktop }}px;
        display: flex;
        align-items: center;
        gap: 25px;

      }
      #background-image-with-text-section_{{ section.id }} .icon_with_text .text_box {
        border-left: 1px solid {{ section.settings.border_color }};
        max-width: max-content;
        padding:0 0 0 25px;
      }
      #background-image-with-text-section_{{ section.id }} .icon_with_text i,
      #background-image-with-text-section_{{ section.id }} .icon_with_text svg{
        color: {{ section.settings.icon_text_color }};
      }
      #background-image-with-text-section_{{ section.id }} .icon_box {
        border-radius: 100%;
        width: 50px;
        height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      #background-image-with-text-section_{{ section.id }} .icon_with_text svg path {
        stroke: {{ section.settings.icon_text_color }};
      }
      #background-image-with-text-section_{{ section.id }} .icon_with_text_box {
        display: flex;
        align-items: center;
        gap: 25px;
      }
      #background-image-with-text-section_{{ section.id }} .badge {
        font-size: {{ section.settings.badge_font_size_dekstop }}px;
        line-height: 1;
      }
      
      

    @media(max-width: 768px) {
    #background-image-with-text-section_{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      background-image: url("{{ section.settings.bg_image_mobile | image_url: width: 1920 }}");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
    #background-image-with-text-section_{{ section.id }} .sub_title {
        font-size: {{ section.settings.subtitle_font_size_mobile }}px;
      }
    #background-image-with-text-section_{{ section.id }} .title {
        font-size: {{ section.settings.title_font_size_mobile }}px;
      }
      #background-image-with-text-section_{{ section.id }} .text {
        font-size: {{ section.settings.text_font_size_mobile }}px;
        max-width: {{ section.settings.text_max_width }}px;
        margin-top: {{ section.settings.text_margin_top_mobile }}px;
      }
      #background-image-with-text-section_{{ section.id }} .icon_with_text {
        font-size: {{ section.settings.icon_text_font_size_mobile }}px;
        margin-top: {{ section.settings.icon_text_margin_top_mobile }}px;
      }
      #background-image-with-text-section_{{ section.id }} .icon_with_text_box {
        margin-bottom: {{ section.settings.icon_text_margin_bottom_mobile }}px;
      }
      #background-image-with-text-section_{{ section.id }} .image_box {
        max-width: 100%;
        width: 100%;
      }
      #background-image-with-text-section_{{ section.id }} .first_title {
        margin-top: {{ section.settings.first_title_margin_top_mobile }}px;
      }
      #background-image-with-text-section_{{ section.id }} .container .background-image-with-text-section-inner{
        padding-top: {{ section.settings.container_padding_top_mobile }}px;
        padding-bottom: {{ section.settings.container_padding_bottom_mobile }}px;
        padding-left: {{ section.settings.container_padding_left_mobile }}px;
        padding-right: {{ section.settings.container_padding_right_mobile }}px;
        background-image: url("{{ section.settings.container_bg_image_mobile | image_url }}");
        background-size: contain;
        background-position: {{ section.settings.container_bg_image_mobile_postion }};
        background-repeat: no-repeat;
        border-radius: {{ section.settings.container_border_radius_mobile }}px;
      }
      #background-image-with-text-section_{{ section.id }} .text_box_outer {
        padding-left: {{ section.settings.text_box_padding_left_mobile }}px;
        padding-right: {{ section.settings.text_box_padding_right_mobile }}px;
        padding-top: {{ section.settings.text_box_padding_top_mobile }}px;
        padding-bottom: {{ section.settings.text_box_padding_bottom_mobile }}px;
      }
      #background-image-with-text-section_{{ section.id }} .badge {
        font-size: {{ section.settings.badge_font_size_mobile }}px;
      }
  }
{% endstyle %}
<div id="background-image-with-text-section_{{ section.id }}" class="background-image-with-text-section">
  <div class="container{% if section.settings.full_width_container %} container_full{% endif %}">
    <div class="background-image-with-text-section-inner">
      <div class="text_box_outer">
        <div class="text_box">
          {% if section.settings.badge_text != blank %} 
          <div>  
          <span class="badge"
            style="background: {{ section.settings.badge_background_gradient }}; color: {{ section.settings.badge_text_color }};"
          >
            {{ section.settings.badge_text }}
          </span>
          </div>
          {% endif %}

          {% if section.settings.subtitle != blank %}
            <h5 class="sub_title">
              {{ section.settings.subtitle }}
              {% if section.settings.subtitle_line_hide == false %}
                <span class="line" style="background: {{ section.settings.subtitle_line_gradient }};">
                  <span class="dot"></span>
                </span>
              {% endif %}
            </h5>
          {% endif %}
          {% if section.settings.first_title != blank %}
            <h3 class="title first_title">{{ section.settings.first_title }}</h3>
          {% endif %}
          {% if section.settings.second_title != blank %}
            <h3 class="title second_title">{{ section.settings.second_title }}</h3>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="text">{{ section.settings.text }}</div>
          {% endif %}
        </div>
        <div class="icon_with_text_box_outer">
          <div class="icon_with_text_box_inner">
            <div class="icon_with_text_box">
              {% for block in section.blocks %}
                {% if block.type == 'icon_with_text' %}
                  <div class="icon_with_text">
                    {% if block.settings.icon != blank %}
                      <div class="icon_box">
                        {{
                          block.settings.icon
                          | image_url: width: 60
                          | image_tag: alt: block.settings.text, loading: 'lazy'
                        }}
                      </div>
                    {% else %}
                      <div class="icon_box svg_icon_box">
                        {{ block.settings.svg_icon }}
                      </div>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="text_box">
                        <p>{{ block.settings.text }}</p>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="button_box_main">
          <div class="button_box_inner">
            {% for block in section.blocks %}
              {% if block.type == 'buttons' %}
                <style>
                  .button_{{ section.id }}_{{ block.id }} {
                    background: {{ block.settings.button_gradient_color }};
                    color: {{ block.settings.button_color }};
                    border: 1px solid {{ block.settings.button_border_color }};
                  }
                  .button_{{ section.id }}_{{ block.id }}:hover {
                    background: {{ block.settings.button_gradient_hover_color }};
                    color: {{ block.settings.button_hover_color }};
                    border: 1px solid {{ block.settings.button_border_hover_color }};
                  }
                </style>
                <div class="button_box">
                  {% if block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" class="button button_{{ section.id }}_{{ block.id }}">
                      {% if block.settings.button_svg_icon != blank %}
                        <span class="button_icon">{{ block.settings.button_svg_icon }}</span>
                      {% endif %}
                      {% if block.settings.button_text != blank %}
                        <span class="button_text">{{ block.settings.button_text }}</span>
                      {% endif %}
                      {% if block.settings.enable_button_arrow %}
                        <span class="arrow_icon">
                          <svg
                            class="w-6 h-6 text-gray-800 dark:text-white"
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            fill="none"
                            viewBox="0 0 24 24"
                          >
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/>
                          </svg>
                        </span>
                      {% endif %}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="image_box">
        {% if section.settings.image_desktop != blank %}
          <div class="desktop_image_box">
            {{ section.settings.image_desktop | image_url: width: 1280 | image_tag: alt: block.settings.text, loading: 'lazy' }}
          </div>
        {% endif %}
        {% if section.settings.image_mobile != blank %}
          <div class="mobile_image_box">
            {{ section.settings.image_mobile | image_url: width: 750 | image_tag: alt: block.settings.text, loading: 'lazy' }}
          </div>
        {% endif %}
    </div>
  </div>
</div>
{% schema %}
{
