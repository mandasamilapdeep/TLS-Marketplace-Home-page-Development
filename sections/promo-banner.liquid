{{ 'promo-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lazyload-fade-scale.js' | asset_url }}" defer="defer"></script>

{% style %}
	{% render 'section-margin' %}
{% endstyle %}

{% liquid
	assign image_size = section.settings.image_size
	assign content_alignment = section.settings.content_alignment
	assign section_size = section.settings.section_size
	assign primary_button_label = section.settings.primary_button_label
	assign primary_button_link = section.settings.primary_button_link
	assign ticker_text = section.settings.ticker_text
	assign transparent_text_stroke = section.settings.transparent_text_stroke
	assign ticker_speed = section.settings.ticker_speed
	assign ticker_size = section.settings.ticker_size
	assign color_scheme = section.settings.color_scheme
	assign heading = section.settings.heading
	assign heading_size = section.settings.heading_size
	assign heading_tag = section.settings.heading_tag
	assign text = section.settings.text
	assign countdown_heading = section.settings.countdown_heading
	assign section_image = section.settings.image
	assign image_height = section_image.width | divided_by: section_image.aspect_ratio
	assign header_overlay = section.settings.header_overlay
	assign padding_bottom_adapt = 1 | divided_by: section_image.aspect_ratio | times: 100
	assign transparent_background = section.settings.transparent_background

	if header_overlay == true and section_size == 'full'
		assign has_overlay = true
	else
		assign has_overlay = false
	endif

	assign class_header_overlay = ''
	if has_overlay
		assign class_header_overlay = 'promo-banner__content--header-overlay'
	endif

	assign background_class = has_overlay | default: false

	if background_class
		assign background_class = 'color-background-3'
	else
		assign background_class = 'color-' | append: color_scheme
	endif

	assign class_content_wrapper_container = ''
	if section_size == 'container'
		assign class_content_wrapper_container = 'content-wrapper__container'
	endif
%}

<style>
	#shopify-section-{{ section.id }} {
	   {% if image_size != 'adapt' %}
	     --padding-bottom: {{ image_size }}%;
		 {% else %}
			--padding-bottom: {{ padding_bottom_adapt }}%;
	   {% endif %}
	}

	#shopify-section-{{ section.id }} .promo-banner {
		--opacity-overlay: {{ section.settings.overlay_opacity_mobile }};

		@media screen and (min-width: 990px) {
			--opacity-overlay: {{ section.settings.overlay_opacity }};
		}
	}
</style>

<section
	class="promo-banner"
	data-id="shopify-section-{{ section.id }}"
	{% if has_overlay %}
		data-header-overlay="true"
	{% endif %}
>
	<div
		class="container promo-banner__container backlight-led-animation__bg--new"
		style="{% if section_size != "container" %}display: contents;{% endif %}"
	>
		<div
			class="content-wrapper {{ background_class }} {{ class_content_wrapper_container }}"
			data-color-scheme="{{ background_class }}"
			{{ section.shopify_attributes }}
		>
			<div class="promo-banner--inner " data-id="{{ section.id }}">
				{% if section_image != blank %}
					<div class="promo-banner__img animate-on-scroll--image">
						{% liquid
							assign width_adapt_ratio = 1
							if section_image.width > section_image.height
								assign width_adapt_ratio = 550 | times: section_image.aspect_ratio | round: 2
							endif

							if section_size == 'full'
								assign desktop_width = '100vw'
							else
								assign desktop_width = 'calc(100vw - 64px * 2)'
							endif
						%}
						{% capture sizes %}
							(min-width: 1100px) {{desktop_width}},
							{% if width_adapt_ratio != 1 %}
								{{ width_adapt_ratio }}px
							{% else %}
								100vw
							{% endif %}
						{% endcapture %}
						{% liquid
							assign fetch_priority = 'auto'
							assign image_loading = 'lazy'
							if section.index == 1
								assign fetch_priority = 'high'
								assign image_loading = 'eager'
							endif
						%}
						{{
							section_image
							| image_url: width: section_image.width
							| image_tag:
								loading: image_loading,
								fetchpriority: fetch_priority,
								width: section_image.width,
								height: image_height,
								sizes: sizes,
								widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
						}}
					</div>
				{% else %}
					<div class="promo-banner__img">
						{{ 'hero-apparel-2' | placeholder_svg_tag }}
					</div>
				{% endif %}
				{% if primary_button_link != blank %}
					<a
						href="{{ primary_button_link }}"
						class="promo-banner__link-overlay"
						aria-label="{{ heading }}"
					></a>
				{% endif %}
				<div class="promo-banner__content content-{{ content_alignment }} {{ class_header_overlay }}">
					<div class="promo-banner__content--header container">
						{% render 'countdown',
							id: section.id,
							section_settings: section.settings,
							with_bg: true,
							countdown_heading: countdown_heading,
							transparent_background_with_bg: transparent_background,
							enable_mock_timer: section.settings.enable_mock_timer,
							mock_date_picker_day: section.settings.mock_date_picker_day,
							mock_date_picker_hours: section.settings.mock_date_picker_hours
						%}
						<div>
							{% if heading != blank %}
								<{{ heading_tag | default: 'h1' }}
									class="content__title {{ heading_size }}"
								>
									{{ heading }}
								</{{ heading_tag | default: 'h1' }}>
							{% endif %}
							{%- if text != blank -%}
								<div
									class="content__desc richtext__content richtext_custom"
								>
									{{ text }}
								</div>
							{%- endif -%}
						</div>
						{% if primary_button_label != blank %}
							{%
								render 'button',
								btn_label: primary_button_label,
								btn_link: primary_button_link,
								btn_style: 'primary',
							%}
						{% endif %}
					</div>

					{% if ticker_text != blank %}
						{% render 'marquee-ticker-new',
							id: section.id,
							ticker_text: ticker_text,
							transparent_text_stroke: transparent_text_stroke,
							ticker_speed: ticker_speed,
							ticker_size: ticker_size,
							pause_on_hover: false,
							overlay_link_url: primary_button_link,
							change_directon: true
						%}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</section>

{% schema %}
{
	"name": "t:sections.promo-banner.name",
	"tag": "section",
	"class": "promo-banner-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-3",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "select",
			"id": "section_size",
			"default": "full",
			"label": "t:sections.all.section_size.label",
			"options": [
				{
					"value": "full",
					"label": "t:sections.all.section_size.options.options__1.label"
				},
				{
					"value": "container",
					"label": "t:sections.all.section_size.options.options__2.label"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "header_overlay",
			"label": "t:sections.all.header_overlay.label",
			"info": "t:sections.all.header_overlay.info",
			"default": false
		},
		{
			"type": "select",
			"id": "content_alignment",
			"default": "center",
			"label": "t:sections.all.content_alignment.label",
			"options": [
				{
					"value": "left",
					"label": "t:sections.all.content_alignment.options.options__2.label"
				},
				{
					"value": "center",
					"label": "t:sections.all.content_alignment.options.options__1.label"
				}
			]
		},
		{
			"type": "header",
			"content": "t:sections.all.image.header.content"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.all.image.label"
		},
		{
			"type": "select",
			"id": "image_size",
			"default": "42.85",
			"label": "t:sections.all.image.aspect_ratio.label",
			"options": [
				{
					"value": "100",
					"label": "t:sections.all.image.aspect_ratio.options__1.label"
				},
				{
					"value": "66.66",
					"label": "t:sections.all.image.aspect_ratio.options__2.label"
				},
				{
					"value": "133.33",
					"label": "t:sections.all.image.aspect_ratio.options__3.label"
				},
				{
					"value": "75",
					"label": "t:sections.all.image.aspect_ratio.options__4.label"
				},
				{
					"value": "56.25",
					"label": "t:sections.all.image.aspect_ratio.options__5.label"
				},
				{
					"value": "42.85",
					"label": "t:sections.all.image.aspect_ratio.options__6.label"
				},
				{
					"value": "adapt",
					"label": "t:sections.all.image.aspect_ratio.options__7.label"
				}
			]
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"min": 0,
			"max": 1,
			"step": 0.1,
			"default": 0.2,
			"label": "t:sections.all.overlay.overlay_opacity.label"
		},
		{
			"type": "range",
			"id": "overlay_opacity_mobile",
			"min": 0,
			"max": 1,
			"step": 0.1,
			"default": 0.6,
			"label": "t:sections.all.overlay.overlay_opacity_mobile.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.content_options.header.content"
		},
		{
			"type": "checkbox",
			"id": "enable_mock_timer",
			"default": true,
			"label": "t:sections.countdown.settings.enable_mock_timer.label",
			"info": "t:sections.countdown.settings.enable_mock_timer.info"
		},
		{
			"type": "range",
			"id": "mock_date_picker_day",
			"min": 1,
			"max": 31,
			"step": 1,
			"default": 2,
			"label": "t:sections.countdown.settings.mock_date_picker_day.label",
			"visible_if": "{{ section.settings.enable_mock_timer }}"
		},
		{
			"type": "range",
			"id": "mock_date_picker_hours",
			"min": 0,
			"max": 23,
			"step": 1,
			"default": 3,
			"label": "t:sections.countdown.settings.mock_date_picker_hours.label",
			"visible_if": "{{ section.settings.enable_mock_timer }}"
		},
		{
			"type": "text",
			"id": "date_picker",
			"default": "2025-10-01",
			"info": "YYYY-MM-DD",
			"label": "t:sections.countdown.settings.date_picker.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "text",
			"id": "time_picker",
			"default": "00:00",
			"info": "hh:mm",
			"label": "t:sections.countdown.settings.time_picker.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "checkbox",
			"id": "transparent_background",
			"label": "t:sections.countdown.settings.transparent_background.label",
			"default": true
		},
		{
			"type": "select",
			"id": "completed_countdown",
			"options": [
				{
					"value": "hide_section",
					"label": "t:sections.countdown.settings.completed_countdown.options_1.label"
				},
				{
					"value": "show_text",
					"label": "t:sections.countdown.settings.completed_countdown.options_2.label"
				}
			],
			"default": "show_text",
			"label": "t:sections.countdown.settings.completed_countdown.label"
		},
		{
			"type": "text",
			"id": "countdown_heading",
			"default": "Header after countdown",
			"info": "t:sections.countdown.settings.show_text",
			"label": "t:sections.countdown.settings.countdown_heading.label"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "t:sections.all.heading.label",
			"default": "t:sections.promo-banner.heading.default"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:sections.all.heading_size.options__4.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h1",
			"label": "t:sections.all.heading_size.label",
			"visible_if": "{{ section.settings.heading != blank }}"
		},
		{
			"type": "select",
			"id": "heading_tag",
			"default": "h1",
			"label": "t:sections.all.heading_tag.label",
			"info": "t:sections.all.heading_tag.info",
			"visible_if": "{{ section.settings.heading != blank }}",
			"options": [
				{
					"value": "h1",
					"label": "t:sections.all.heading_tag.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_tag.options__2.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_tag.options__3.label"
				},
				{
					"value": "h4",
					"label": "t:sections.all.heading_tag.options__4.label"
				},
				{
					"value": "h5",
					"label": "t:sections.all.heading_tag.options__5.label"
				},
				{
					"value": "h6",
					"label": "t:sections.all.heading_tag.options__6.label"
				},
				{
					"value": "div",
					"label": "t:sections.all.heading_tag.options__7.label"
				},
				{
					"value": "p",
					"label": "t:sections.all.heading_tag.options__8.label"
				},
				{
					"value": "span",
					"label": "t:sections.all.heading_tag.options__9.label"
				}
			]
		},
		{
			"type": "inline_richtext",
			"id": "text",
			"label": "t:sections.all.text.label",
			"default": "t:sections.promo-banner.description.default"
		},
		{
			"type": "text",
			"id": "primary_button_label",
			"default": "t:sections.promo-banner.button.default",
			"label": "t:sections.all.button.button_label.label",
			"info": "t:sections.all.button.button_label.info"
		},
		{
			"type": "url",
			"id": "primary_button_link",
			"label": "t:sections.all.button.button_link.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.ticker.header.content"
		},
		{
			"type": "range",
			"id": "ticker_speed",
			"min": 1,
			"max": 25,
			"step": 1,
			"default": 10,
			"unit": "s",
			"label": "t:sections.all.ticker.settings.ticker_speed.label"
		},
		{
			"type": "text",
			"id": "ticker_text",
			"default": "t:sections.all.featured_ticker.default",
			"label": "t:sections.all.ticker.settings.ticker_text.label",
			"info": "t:sections.all.ticker.info"
		},
		{
			"type": "range",
			"id": "ticker_size",
			"min": 50,
			"max": 200,
			"step": 5,
			"default": 180,
			"unit": "px",
			"label": "t:sections.all.ticker.settings.ticker_font_size.label"
		},
		{
			"type": "checkbox",
			"id": "transparent_text_stroke",
			"label": "t:sections.all.transparent_text_stroke.label",
			"default": true
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.promo-banner.name"
		}
	]
}
{% endschema %}
