{{ 'featured-ticker.css' | asset_url | stylesheet_tag }}

{% style %}
	{% render 'section-margin' %}
{% endstyle %}

{% liquid
	assign trusted_text = section.settings.trusted_text
	assign ticker_speed = section.settings.ticker_speed
	assign section_size = 'container'
	assign pause_on_hover = section.settings.pause_on_hover

	assign class_pause = ''
	if pause_on_hover == true
		assign class_pause = 'pause'
	endif
%}

{% style %}
	#shopify-section-{{ section.id }} {
	  --marquee-ticker-speed: {{ ticker_speed }};
	}
{% endstyle %}

<div
	class="featured-ticker__wrapper"
	data-id="shopify-section-{{ section.id }}"
>
	<div
		class="container featured-ticker__container"
		style="{% if section_size == 'full' %} display: contents;{% endif %}"
	>
		<div class="featured-ticker--static">
			<p class="static--trusted-text">
				{{- trusted_text -}}
			</p>
		</div>

		<div class="marquee-container {{ class_pause }}">
			<div class="marquee-content">
				{% for i in (1..3) %}
					<div class="marquee-tag marquee-animate">
						{% for i in (1..5) %}
							{%- for block in section.blocks -%}
								<p class="marquee-item">
									<span class="dynamic__text--first">
										{{- block.settings.block_ticker_text_first }}
									</span>
									<span class="dynamic__text--second">
										{{ block.settings.block_ticker_text_second }}
									</span>
								</p>
							{% endfor %}
						{% endfor %}
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.all.featured_ticker.label",
	"tag": "section",
	"class": "featured-ticker-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "inline_richtext",
			"id": "trusted_text",
			"default": "t:sections.all.featured_ticker.default",
			"label": "t:sections.all.featured_ticker.title"
		},
		{
			"type": "range",
			"id": "ticker_speed",
			"min": 1,
			"max": 35,
			"step": 1,
			"default": 35,
			"unit": "s",
			"label": "t:sections.all.ticker.settings.ticker_speed.label"
		},
		{
			"type": "checkbox",
			"id": "pause_on_hover",
			"default": true,
			"label": "t:sections.all.featured_ticker.pause_on_hover.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"blocks": [
		{
			"type": "ticker_text",
			"name": "t:sections.all.featured_ticker.block_ticker_label",
			"limit": 10,
			"settings": [
				{
					"type": "text",
					"id": "block_ticker_text_first",
					"default": "t:sections.all.featured_ticker.block_text_first.default",
					"label": "t:sections.all.featured_ticker.ticker_text_first"
				},
				{
					"type": "text",
					"id": "block_ticker_text_second",
					"default": "t:sections.all.featured_ticker.block_text_second.default",
					"label": "t:sections.all.featured_ticker.ticker_text_second"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.all.featured_ticker.label",
			"blocks": [
				{
					"type": "ticker_text"
				},
				{
					"type": "ticker_text"
				},
				{
					"type": "ticker_text"
				}
			]
		}
	]
}
{% endschema %}
