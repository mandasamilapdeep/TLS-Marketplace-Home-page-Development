{% liquid
	assign heading_size = section.settings.heading_size
	assign heading = section.settings.heading
	assign text = section.settings.text
	assign button_label_no = section.settings.button_label_no
	assign button_label_yes = section.settings.button_label_yes
	assign heading_declined = section.settings.heading_declined
	assign text_declined = section.settings.text_declined
%}

<div
	class="age-verification popup"
	data-exit-animation="popupExitFade"
	data-body-scroll-disable="true"
	data-open-trigger="none"
	data-id="{{ section.id }}"
	data-limit-display="1"
	data-limit-lifetime="30"
>
	<div class="age-verification__wrapper popup-wrap">
		<div class="container">
			<div class="age-verification__content">
				<div class="age-verification__question show">
					{% if heading %}
						<h2 class="popup-heading age-verification__heading {{ heading_size }}">
							{{ heading }}
						</h2>
					{% endif %}
					{% if text %}
						<div class="popup-text richtext__content richtext_custom">
							{{ text }}
						</div>
					{% endif %}
					<div class="age-verification__buttons">
						<button class="button age-verification__button-no focus-inset">
							<span>{{ button_label_no }}</span>
						</button>

						<div class="custom-hover age-verification__popup-close--wrapper">
							<a
								class="button button--primary age-verification__popup-close "
								data-button-text="{{ button_label_yes }}"
								tabindex="0"
							>
								<div class="button__content">
									<span
										class="button__label"
										data-label="{{- button_label_yes | escape -}}"
									>
										{{- button_label_yes -}}
									</span>
								</div>
								<span class="button_circle"> </span>
							</a>
						</div>
					</div>
				</div>

				<div class="age-verification__declined">
					<div class="age-declined__wrapper">
						{% if heading_declined %}
							<h2 class="popup-heading age-verification__heading h1">
								{{ heading_declined }}
							</h2>
						{% endif %}
						{% if text_declined %}
							<div class="popup-text richtext__content richtext_custom">
								{{ text_declined }}
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.overlay-group.age-verification.name",
	"limit": 1,
	"enabled_on": {
		"groups": ["custom.overlay"]
	},
	"settings": [
		{
			"type": "header",
			"content": "t:sections.overlay-group.age-verification.settings.header_1.content"
		},
		{
			"type": "text",
			"id": "heading",
			"default": "Confirm Your Age",
			"label": "t:sections.overlay-group.age-verification.settings.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h1",
			"label": "t:sections.all.heading_size.label"
		},
		{
			"type": "inline_richtext",
			"id": "text",
			"default": "Are you over 18 years old?",
			"label": "t:sections.overlay-group.age-verification.settings.text.label"
		},
		{
			"type": "text",
			"id": "button_label_no",
			"default": "No I'm not",
			"label": "t:sections.overlay-group.age-verification.settings.button_label_no.label"
		},
		{
			"type": "text",
			"id": "button_label_yes",
			"default": "Yes I am",
			"label": "t:sections.overlay-group.age-verification.settings.button_label_yes.label"
		},
		{
			"type": "header",
			"content": "t:sections.overlay-group.age-verification.settings.header_2.content"
		},
		{
			"type": "text",
			"id": "heading_declined",
			"default": "Here can be your age verification title",
			"label": "t:sections.overlay-group.age-verification.settings.heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "text_declined",
			"default": "Details Go Here",
			"label": "t:sections.overlay-group.age-verification.settings.text.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.overlay-group.age-verification.name"
		}
	]
}
{% endschema %}
