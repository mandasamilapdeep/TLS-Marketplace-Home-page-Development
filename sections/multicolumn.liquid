{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
<script src="{{ 'multicolumn.js' | asset_url }}" defer="defer"></script>

{% style %}
	{% render 'section-margin' %}
	{% render 'section-padding' %}
{% endstyle %}

{% liquid
	assign content_alignment = section.settings.content_alignment
	assign swipe_on_mobile = section.settings.swipe_on_mobile
	assign columns_per_row = section.settings.columns_per_row
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_heading_content_alignment = section.settings.section_heading_content_alignment
	assign pulse_subheading = section.settings.pulse_animation_text

	assign class_swiper_mobile = ''
	assign class_swiper_wrapper = ''
	assign class_swiper_slide = ''
	if swipe_on_mobile and section.blocks.size > 1
		assign class_swiper_mobile = 'swiper swiper--multicolumn'
		assign class_swiper_wrapper = 'swiper-wrapper'
		assign class_swiper_slide = 'swiper-slide'
	endif
%}

<div class="multicolumn">
	<div class="container">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			content_alignment: section_heading_content_alignment,
			pulse: pulse_subheading
		%}
		<div class="multicolumn-list {{ class_swiper_mobile }}">
			<div
				class="
					multicolumn-list__wrapper multicolumn-list__wrapper--{{ columns_per_row }}
					multicolumn-list__wrapper--{{ content_alignment }} {{ class_swiper_wrapper }}
				"
			>
				{%- for block in section.blocks -%}
					{% liquid
						assign full_link_enabled = false
						if block.settings.button_link != blank and block.settings.full_link
							assign full_link_enabled = true
						endif
					%}
					<div
						class="
							multicolumn-card multicolumn-list__item
							multicolumn-card--left {{ class_swiper_slide }} {% if full_link_enabled %} full-link-enabled magnetic-hover-effect{% endif %}
						"
						{{ block.shopify_attributes }}
					>
						{%- if block.settings.button_link != blank
							and block.settings.full_link
						-%}
							<a
								href="{{ block.settings.button_link }}"
								class="multicolumn__link-overlay"
								aria-label="{{ block.settings.heading }}"
							></a>
							<div class="multicolumn__overlay-bg"></div>
						{%- endif -%}
						{%- if block.settings.icon != 'none' -%}
							<div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--extra_small">
								{% if block.settings.image != blank %}
									{{
										block.settings.image
										| image_url: width: block.settings.image.width
										| image_tag:
											loading: 'lazy',
											class: 'motion-reduce media--first',
											widths: '25, 50, 75'
									}}
								{% else %}
									{% render 'icon-pack', icon: block.settings.icon %}
								{% endif %}
							</div>
						{% endif %}
						<div class="multicolumn-card__info">
							{%- if block.settings.heading != blank -%}
								<{{ block.settings.item_heading_tag | default: 'h4' }}
									class="multicolumn-card__heading h5"
								>
									{{ block.settings.heading | escape }}
								</{{ block.settings.item_heading_tag | default: 'h4' }}>
							{%- endif -%}
							{%- if block.settings.text != blank -%}
								<div class="multicolumn-card__text richtext__content richtext_custom">
									{{ block.settings.text }}
								</div>
							{%- endif -%}

							{% render 'button',
								btn_label: block.settings.button_label,
								btn_link: block.settings.button_link,
								btn_style: block.settings.button_style
							%}

							{%- if block.settings.button_link != blank
								and block.settings.full_link
							-%}
								<a
									href="{{ block.settings.button_link }}"
									class="multicolumn__link-overlay"
									aria-label="{{ block.settings.heading }}"
								></a>
							{%- endif -%}
						</div>
					</div>
				{%- endfor -%}
			</div>

			{%- if swipe_on_mobile and section.blocks.size > 1 -%}
				<div class="swipe-on-mobile__nav no-js-hidden">
					<div class="multicolumn__pagination swiper-pagination"></div>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

