{{ 'section-card-grid.css' | asset_url | stylesheet_tag }}

<script src="{{ 'card-grid.js' | asset_url }}" defer="defer"></script>

<script
	src="{{ 'magnetic-hover-effect.js' | asset_url }}"
	defer="defer"
></script>

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign image_ratio = section.settings.image_ratio
%}

<div class="card-grid">
	<div class="container">
		{% render 'section-header',
			section_heading: section.settings.heading,
			section_subheading: section.settings.subheading,
			section_heading_size: section.settings.section_heading_size,
			section_heading_tag: section.settings.section_heading_tag,
			pulse: section.settings.pulse_animation_text
		%}
		<div class="swiper swiper--cards">
			<div
				class="
					card-grid__wrapper card-grid__wrapper--{{ section.settings.columns_per_row }}
					{% if section.blocks.size > 1 %} swiper-wrapper{% endif %}
				"
			>
				{% for block in section.blocks %}
					<a
						href="{{ block.settings.card_link }}"
						class="{% if section.blocks.size > 1 %}swiper-slide{% endif %} card-grid__card {% if block.settings.image_height_option == 'overflow-top' %}overflow-top-card{% endif %} {% if section.settings.magnetic_hover_effect %} magnetic-hover-effect {% endif %}"
						style="
							--overlay-opacity: {{ block.settings.overlay_opacity }};
							--image-ratio: {{ image_ratio }};
							{% if block.settings.card_link == blank %} pointer-events: none; {% endif %}
						"
					>
						<div class="card-grid__card_content {% if block.settings.image == blank %}no-image{% endif %}">
							{% if block.settings.discount != blank %}
								{% render 'discount-badge',
									discount: block.settings.discount,
									badge_size: 'badge--large'
								%}
							{% endif %}
							<{{ block.settings.heading_tag | default: 'h4' }}
								class="card-grid__card_title {{  block.settings.heading_size }}"
							>
								{{ block.settings.card_title }}
							</{{ block.settings.heading_tag | default: 'h4' }}>
						</div>
						<div class="card-grid__card_img {% if block.settings.image_height_option == 'overflow-top' %}overflow-top{% endif %}">
							{% if block.settings.image != blank %}
								{% capture sizes %}
								(min-width: 990px) 940px, (min-width: 750px) calc((100vw - 40px) / 2), calc((100vw - 40px))
							{% endcapture %}
								{% liquid
									assign fetch_priority = 'auto'
									assign image_loading = 'lazy'
									if block.index == 1
										assign fetch_priority = 'high'
										assign image_loading = 'eager'
									endif
								%}
								{{
									block.settings.image
									| image_url: width: 1066
									| image_tag:
										loading: image_loading,
										fetchpriority: fetch_priority,
										sizes: sizes,
										widths: '165, 360, 535, 720, 940, 1066'
								}}
							{% endif %}
						</div>

						<div class="card-grid__card_bg">
							{%- if block.settings.bg_image != blank -%}
								{% liquid
									assign fetch_priority = 'auto'
									assign image_loading = 'lazy'
									if block.index == 1
										assign fetch_priority = 'high'
										assign image_loading = 'eager'
									endif
								%}
								{%- capture sizes -%}
								(min-width: 1100px) calc((50vw - 64px)), calc((100vw - 40px))
							{%- endcapture -%}
								{%- assign widths = '360, 535, 720, 940, 1070, 1200, 1400, 1600' -%}
								{{
									block.settings.bg_image
									| image_url: width: block.settings.bg_image.width
									| image_tag:
										loading: image_loading,
										fetchpriority: fetch_priority,
										sizes: sizes,
										widths: widths
								}}
							{%- endif -%}
						</div>

						<span class="visually-hidden"> Go to card </span>
					</a>
				{% endfor %}
			</div>
			{%- if section.blocks.size > 1 -%}
				<div class="swipe-on-mobile__nav no-js-hidden">
					<div class="categories-list__pagination swiper-pagination"></div>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

