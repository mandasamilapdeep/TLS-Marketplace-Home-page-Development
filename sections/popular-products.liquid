{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}
{{ 'component-main-product-info.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'popular-products.js' | asset_url }}" defer="defer"></script>
{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign quickview_hover = settings.quickview_hover
	assign show_on_mobile = settings.show_on_mobile
	assign quickview_show = settings.quickview_show
	assign type_color_swatch = settings.type_color_swatch
%}

{%- if quickview_show or show_on_mobile or type_color_swatch == 'custom' -%}
	{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if quickview_show or show_on_mobile -%}
	<link
		rel="stylesheet"
		href="{{ 'component-deferred-media.css' | asset_url }}"
		media="all"
	>
	{{ 'quick-add.css' | asset_url | stylesheet_tag: preload: true }}
{%- endif -%}

<script src="{{ 'lava-lamp.js' | asset_url }}" defer="defer"></script>

{% liquid
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_heading_content_alignment = section.settings.section_heading_content_alignment
	assign pulse_animation_text = section.settings.pulse_animation_text
	assign product_card_type = section.settings.product_card_type
	assign show_swatches = section.settings.show_swatches
	assign collection_list = section.settings.collection_list
	assign image_ratio = section.settings.image_ratio
	assign product_count = section.settings.product_count
	assign product_limit = section.settings.product_limit
	assign show_secondary_image = section.settings.show_secondary_image
	assign image_fit = section.settings.image_fit
	assign show_vendor = section.settings.show_vendor
	assign show_collection = section.settings.show_collection
	assign show_desc = section.settings.show_desc
	assign product_list = section.settings.product_list
	assign tabs_link_text = section.settings.tabs_link_text
	assign tabs_link_url = section.settings.tabs_link_url
	assign picker_type = section.settings.picker_type
	assign enable_slider_shadow = section.settings.enable_slider_shadow

	assign count = 0
	for collection in collection_list
		if collection.products != blank
			assign count = count | plus: 1
		endif
	endfor

	assign is_collection_products_selected = false
	if collection_list != blank and count >= 1
		assign is_collection_products_selected = true
	endif

	assign class_product_card_featured_wrapper = ''
	if product_card_type == 'featured'
		assign class_product_card_featured_wrapper = 'product-card__featured--wrapper'
	endif

	assign class_quickview = 'quickview'
	if quickview_hover
		assign class_quickview = class_quickview | append: '--hover'
	endif

	assign class_slider_shadow_enabled = ''
	if enable_slider_shadow == true
		assign class_slider_shadow_enabled = 'slider-shadow-enabled'
	endif
%}

<div
	class="popular-products"
	data-is-collection-products-selected="{{ is_collection_products_selected }}"
>
	<div class="container">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			content_alignment: section_heading_content_alignment,
			pulse: pulse_animation_text,
			section_settings: section.settings,
			section: section
		%}

		{%- if collection_list != blank and count >= 1 -%}
			<div class="popular-products__collection-tabs-list--container">
				<div class="popular-products__collection-tabs-list--wrapper">
					<ul
						class="popular-products__collection-tabs-list list-unstyled tabs-lava-lamp"
						role="tablist"
					>
						{% if count >= 2 %}
							<li
								id="popular-tab-0"
								data-tab-target="#product-carousel-main-0"
								class="secondary_text collections-tabs__title active"
								role="tab"
								aria-selected="true"
								aria-controls="product-carousel-main-0"
								tabindex="0"
							>
								<span>All</span>
							</li>
						{% endif %}

						{% assign real_index = 1 %}
						{%- for collection in collection_list -%}
							{% if collection.products != blank %}
								{% assign real_index = real_index | plus: 1 %}
								<li
									id="popular-tab-{{ forloop.index }}"
									data-tab-target="#product-carousel-main-{{ forloop.index }}"
									class="secondary_text collections-tabs__title"
									role="tab"
									aria-selected="false"
									aria-controls="product-carousel-main-{{ forloop.index }}"
									tabindex="-1"
								>
									<span>{{ collection.title }}</span>
								</li>
							{% endif %}
						{%- endfor -%}
						<li id="tabs-lava-lamp-blob" class="no-js-hidden" role="tab"></li>
					</ul>
					{% render 'button',
						btn_label: tabs_link_text,
						btn_link: tabs_link_url,
						btn_style: 'link'
					%}
				</div>
			</div>
		{% endif %}

		{%- if collection_list != blank -%}
			<div
				class="popular-products__content--wrapper collection-products active not-all-products-collections"
				id="product-carousel-main-0"
				data-tab-content
				role="tabpanel"
				aria-labelledby="popular-tab-0"
				tabindex="0"
			>
				<div
					class="popular-products__content swiper swiper--products product-carousel-swiper {{ class_slider_shadow_enabled }}"
					data-slider-shadow-enabled="{{enable_slider_shadow }}"
					data-columns-mobile="1"
					data-product-card-type="{{ product_card_type }}"
				>
					<div
						class="popular-products__wrapper popular-products__wrapper--4 popular-products__wrapper--1-mobile swiper-wrapper"
						data-count="{{ product_limit }}"
					>
						{% comment %}
							============
							collection.all.products
							============
						{% endcomment %}
						{% for collection in collection_list %}
							{% for product in collection.products limit: product_count %}
								{%- assign z_index = 1000 | minus: forloop.index -%}
								<div
									style="z-index: {{ z_index }};"
									class="popular-products__item {{ product_card_type }} collection-product-card {{ class_quickview }} swiper-slide"
								>
									{% if product_card_type == 'simple' %}
										{% render 'product-card',
											product_card_product: product,
											media_size: image_ratio,
											media_fit: image_fit,
											show_secondary_image: show_secondary_image,
											show_vendor: show_vendor,
											show_collection: show_collection,
											show_desc: show_desc,
											section_id: section.id,
											columns: 4,
											add_id: forloop.index,
											content_alignment: 'left',
											show_swatches: show_swatches,
											heading_tag: section.settings.product_heading_tag
										%}
									{% else %}
										{% render 'product-card-featured',
											product: product,
											media_size: image_ratio,
											media_fit: image_fit,
											show_secondary_image: show_secondary_image,
											show_vendor: show_vendor,
											show_collection: show_collection,
											show_desc: show_desc,
											section_id: section.id,
											columns: 4,
											add_id: forloop.index,
											content_alignment: 'left',
											picker_type: picker_type,
											heading_tag: section.settings.product_heading_tag
										%}
									{% endif %}
								</div>
							{% endfor %}
						{% endfor %}
					</div>

					{% comment %}{% render 'swiper-nav' %}{% endcomment %}
				</div>
				{% render 'swiper-arrows', classNameWrapper: product_card_type %}
			</div>

			{%- for collection in collection_list -%}
				{% assign real_index = real_index | plus: 1 %}
				{% if collection.products != blank %}
					<div
						class="popular-products__content--wrapper collection-products {% if real_index == 1 %} active{% endif %} not-all-products-collections"
						id="product-carousel-main-{{ forloop.index }}"
						data-tab-content
						role="tabpanel"
						aria-labelledby="popular-tab-{{ forloop.index }}"
						tabindex="0"
					>
						<div
							class="popular-products__content swiper swiper--products product-carousel-swiper {{ class_slider_shadow_enabled }}"
							data-slider-shadow-enabled="{{enable_slider_shadow }}"
							data-columns-mobile="1"
							data-product-card-type="{{ product_card_type }}"
						>
							<div
								class="popular-products__wrapper popular-products__wrapper--4 popular-products__wrapper--1-mobile swiper-wrapper"
								data-count="{{ product_limit }}"
							>
								{%- for product in collection.products limit: product_count -%}
									{%- assign z_index = 1000 | minus: forloop.index -%}
									<div
										style="z-index: {{ z_index }};"
										class="popular-products__item {{ product_card_type }} collection-product-card {{ class_quickview }} swiper-slide"
									>
										{% if product_card_type == 'simple' %}
											{% render 'product-card',
												product_card_product: product,
												media_size: image_ratio,
												media_fit: image_fit,
												show_secondary_image: show_secondary_image,
												show_vendor: show_vendor,
												show_collection: show_collection,
												show_desc: show_desc,
												section_id: section.id,
												section: section,
												columns: 4,
												add_id: forloop.index,
												content_alignment: 'left',
												show_swatches: show_swatches
												heading_tag: section.settings.product_heading_tag
											%}
										{% else %}
											{% render 'product-card-featured',
												product: product,
												media_size: image_ratio,
												media_fit: image_fit,
												show_secondary_image: show_secondary_image,
												show_vendor: show_vendor,
												show_collection: show_collection,
												show_desc: show_desc,
												section_id: section.id,
												section: section,
												columns: 4,
												add_id: forloop.index,
												content_alignment: 'left',
												picker_type: picker_type,
												heading_tag: section.settings.product_heading_tag
											%}
										{% endif %}
									</div>
								{% endfor %}
							</div>

							{% render 'swiper-nav' %}
						</div>
						{% render 'swiper-arrows', classNameWrapper: product_card_type %}
					</div>
				{% endif %}
			{%- endfor -%}
		{% else %}
			<div
				class="popular-products__content--wrapper selected-products"
				role="tabpanel"
				aria-labelledby="1"
			>
				<div
					class="{% if enable_slider_shadow == true %}popular-products__content {% endif %} swiper swiper--products product-carousel-swiper {{ class_slider_shadow_enabled }}"
					data-slider-shadow-enabled="{{ enable_slider_shadow }}"
					data-columns-mobile="1"
					data-product-card-type="{{ product_card_type }}"
				>
					<div class="popular-products__wrapper popular-products__wrapper--4 popular-products__wrapper--1-mobile swiper-wrapper">
						{%- if product_list != blank -%}
							{%- for product in product_list -%}
								{%- assign z_index = 1000 | minus: forloop.index -%}
								<div
									style="z-index: {{ z_index }};"
									class="popular-products__item {{ product_card_type }} collection-product-card {{ class_quickview }} swiper-slide"
								>
									{% if product_card_type == 'simple' %}
										{% render 'product-card',
											product_card_product: product,
											media_size: image_ratio,
											media_fit: image_fit,
											show_secondary_image: show_secondary_image,
											show_vendor: show_vendor,
											show_collection: show_collection,
											show_desc: show_desc,
											section_id: section.id,
											columns: 4,
											add_id: forloop.index,
											content_alignment: 'left',
											show_swatches: show_swatches,
											heading_tag: section.settings.product_heading_tag
										%}
									{% else %}
										{% render 'product-card-featured',
											product: product,
											media_size: image_ratio,
											media_fit: image_fit,
											show_secondary_image: show_secondary_image,
											show_vendor: show_vendor,
											show_collection: show_collection,
											show_desc: show_desc,
											section_id: section.id,
											columns: 4,
											forloop_index: forloop.index,
											content_alignment: 'left',
											picker_type: picker_type,
											heading_tag: section.settings.product_heading_tag
										%}
									{% endif %}
								</div>
							{%- endfor -%}
						{%- else -%}
							{%- for i in (1..5) -%}
								<div class="popular-products__item popular-products__item_placeholder {{ product_card_type }} {{ class_product_card_featured_wrapper }} collection-popular-card collection-popular-card--placeholder swiper-slide">
									{% if product_card_type == 'simple' %}
										{% render 'product-card-placeholder',
											media_size: image_ratio,
											content_alignment: 'left',
											product_index: forloop.index,
											heading_tag: section.settings.product_heading_tag
										%}
									{% else %}
										{% render 'product-card-featured-placeholder',
											media_size: image_ratio,
											content_alignment: 'left',
											product_index: forloop.index,
											heading_tag: section.settings.product_heading_tag
										%}
									{% endif %}
								</div>
							{%- endfor -%}
						{%- endif -%}
					</div>

					{% render 'swiper-nav' %}
				</div>
				{% render 'swiper-arrows', classNameWrapper: product_card_type %}
			</div>
		{% endif %}
	</div>
</div>

<script>
	(function () {
		function adjustButtonPosition(height) {
			document
				.querySelectorAll(
					`#shopify-section-{{ section.id }} .swiper-buttons__wrapper`,
				)
				.forEach((button) => {
					button.style.top = height / 2 + 'px';
				});
		}

		function changePosition() {
			if (window.innerWidth < 750) return;

			const image = document.querySelector(
				`#shopify-section-{{ section.id }} .img_tag`,
			);

			if (image) {
				if (image.tagName === 'IMG') {
					if (image.complete) {
						adjustButtonPosition(image.offsetHeight);
					} else {
						image.addEventListener('load', function () {
							adjustButtonPosition(this.offsetHeight);
						});
					}
				} else if (image.tagName === 'svg') {
					const height = image.getBoundingClientRect().height;
					adjustButtonPosition(height);
				}
			}
		}

		changePosition();

		document.addEventListener('shopify:section:load', changePosition);

		let resizeTimeout;
		window.addEventListener('resize', function () {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(changePosition, 500);
		});
	})();
</script>

{% schema %}
{
	"name": "t:sections.popular-products.name",
	"tag": "section",
	"class": "popular-products-section spaced-section",
	"disabled_on": {
		"templates": ["password"],
		"groups": ["*"]
	},
	"settings": [
		{
			"type": "product_list",
			"id": "product_list",
			"label": "t:sections.popular-products.settings.product_list.label"
		},
		{
			"type": "collection_list",
			"id": "collection_list",
			"label": "t:sections.popular-products.settings.collections.label",
			"limit": 5
		},
		{
			"type": "select",
			"id": "product_card_type",
			"default": "simple",
			"label": "t:sections.popular-products.settings.product_card_type.label",
			"options": [
				{
					"value": "simple",
					"label": "t:sections.popular-products.settings.product_card_type.options__1.label"
				},
				{
					"value": "featured",
					"label": "t:sections.popular-products.settings.product_card_type.options__2.label"
				}
			]
		},
		{
			"type": "range",
			"id": "product_count",
			"min": 1,
			"max": 10,
			"step": 1,
			"default": 8,
			"label": "t:sections.popular-products.settings.product_count.label"
		},
		{
			"type": "checkbox",
			"id": "enable_slider_shadow",
			"default": false,
			"label": "t:sections.popular-products.settings.enable_slider_shadow.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.heading.header.content"
		},
		{
			"type": "text",
			"id": "section_heading",
			"default": "t:sections.popular-products.settings.heading.default",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "section_heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:sections.all.heading_size.options__4.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h3",
			"label": "t:sections.all.heading_size.label",
			"visible_if": "{{ section.settings.section_heading != blank }}"
		},
		{
			"type": "select",
			"id": "section_heading_tag",
			"default": "h3",
			"label": "t:sections.all.heading_tag.label",
			"info": "t:sections.all.heading_tag.info",
			"visible_if": "{{ section.settings.section_heading != blank }}",
			"options": [
				{
					"value": "h1",
					"label": "t:sections.all.heading_tag.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_tag.options__2.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_tag.options__3.label"
				},
				{
					"value": "h4",
					"label": "t:sections.all.heading_tag.options__4.label"
				},
				{
					"value": "h5",
					"label": "t:sections.all.heading_tag.options__5.label"
				},
				{
					"value": "h6",
					"label": "t:sections.all.heading_tag.options__6.label"
				},
				{
					"value": "div",
					"label": "t:sections.all.heading_tag.options__7.label"
				},
				{
					"value": "p",
					"label": "t:sections.all.heading_tag.options__8.label"
				},
				{
					"value": "span",
					"label": "t:sections.all.heading_tag.options__9.label"
				}
			]
		},
		{
			"type": "text",
			"id": "section_subheading",
			"default": "t:sections.popular-products.settings.heading.default",
			"label": "t:sections.all.section-header.subheading.label"
		},
		{
			"type": "checkbox",
			"id": "pulse_animation_text",
			"label": "t:sections.all.pulse_animation_text.label",
			"default": false
		},
		{
			"type": "select",
			"id": "section_heading_content_alignment",
			"default": "left",
			"label": "t:sections.all.content_alignment.label",
			"options": [
				{
					"value": "left",
					"label": "t:sections.all.content_alignment.options.options__2.label"
				},
				{
					"value": "center",
					"label": "t:sections.all.content_alignment.options.options__1.label"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "enable_mock_timer",
			"default": true,
			"label": "t:sections.countdown.settings.enable_mock_timer.label",
			"info": "t:sections.countdown.settings.enable_mock_timer.info"
		},
		{
			"type": "range",
			"id": "mock_date_picker_day",
			"min": 1,
			"max": 31,
			"step": 1,
			"default": 2,
			"label": "t:sections.countdown.settings.mock_date_picker_day.label",
			"visible_if": "{{ section.settings.enable_mock_timer }}"
		},
		{
			"type": "range",
			"id": "mock_date_picker_hours",
			"min": 0,
			"max": 23,
			"step": 1,
			"default": 3,
			"label": "t:sections.countdown.settings.mock_date_picker_hours.label",
			"visible_if": "{{ section.settings.enable_mock_timer }}"
		},
		{
			"type": "text",
			"id": "date_picker",
			"default": "2026-10-01",
			"info": "YYYY-MM-DD",
			"label": "t:sections.countdown.settings.date_picker.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "text",
			"id": "time_picker",
			"default": "00:00",
			"info": "hh:mm",
			"label": "t:sections.countdown.settings.time_picker.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "select",
			"id": "completed_countdown",
			"options": [
				{
					"value": "hide_section",
					"label": "t:sections.countdown.settings.completed_countdown.options_1.label"
				},
				{
					"value": "show_text",
					"label": "t:sections.countdown.settings.completed_countdown.options_2.label"
				}
			],
			"default": "show_text",
			"label": "t:sections.countdown.settings.completed_countdown.label"
		},
		{
			"type": "text",
			"id": "countdown_heading",
			"default": "Header after countdown",
			"info": "t:sections.countdown.settings.show_text",
			"label": "t:sections.countdown.settings.countdown_heading.label"
		},
		{
			"type": "header",
			"content": "t:sections.popular-products.settings.tabs.header"
		},
		{
			"type": "paragraph",
			"content": "t:sections.popular-products.settings.tabs.info"
		},
		{
			"type": "text",
			"id": "tabs_link_text",
			"default": "Link text",
			"label": "t:sections.popular-products.settings.view_all.label"
		},
		{
			"type": "url",
			"id": "tabs_link_url",
			"label": "t:sections.popular-products.settings.view_all.link_label"
		},
		{
			"type": "header",
			"content": "t:sections.all.card.header_card.content"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"default": "3/4",
			"label": "t:sections.all.image.aspect_ratio.label_secondary",
			"options": [
				{
					"value": "1/1",
					"label": "t:sections.all.image.ratio.options__3.label"
				},
				{
					"value": "3/4",
					"label": "t:sections.all.image.ratio.options__2.label"
				}
			]
