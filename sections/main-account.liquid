{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

<div class="customer account">
	<div class="container">
		<div class="page-header">
			<div class="page-header__inner">
				<div class="customer__top">
					<h1 class="main-page-title page-title title--page {{section.settings.section_heading_size}}">
						{% assign trimmed_first_name = customer.first_name | strip %}
						{{ 'customer.account.title' | t -}}
						{%- if trimmed_first_name != blank -%}
							, {{ trimmed_first_name -}}
						{%- endif %}
					</h1>

					<div class="button_wrapper custom-hover">
						<a
							class="title-link button button--secondary"
							href="{{ routes.account_logout_url }}"
						>
							<div class="button__content">
								<span
									class="button__label"
									data-label="{{- 'customer.log_out' | t | escape -}}"
								>
									{{- 'customer.log_out' | t -}}
								</span>
							</div>
							<span class="button_circle"> </span>
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="account__wrapper {% if customer.orders.size == 0 %} empty-order{% endif %} {% if customer.addresses_count == 0 %} empty-address-wrapper{% endif %}{% if customer.orders.size > 0 %} account__wrapper--between{% endif %}">
			<div class="account__left{% if customer.orders.size > 0 %} account__left--table{% endif %}">
				{% paginate customer.orders by 20 %}
					{%- if customer.orders.size > 0 -%}
						<span class=" subtitle subtitle-large">
							{{ 'customer.orders.title' | t }}
						</span>
						<h4 class=" h4">
							{{ 'customer.orders.your_orders' | t }}
						</h4>
						<div class="order-table">
							<div class="visually-hidden">
								{{ 'customer.orders.title' | t }}
							</div>
							<div class="row thead">
								<div id="ColumnOrder">
									{{ 'customer.orders.order_number' | t }}
								</div>
								<div id="ColumnDate">{{ 'customer.orders.date' | t }}</div>
								<div id="ColumnPayment">
									{{ 'customer.orders.payment_status' | t }}
								</div>
								<div id="ColumnFulfillment">
									{{ 'customer.orders.fulfillment_status' | t }}
								</div>
								<div id="ColumnTotal">{{ 'customer.orders.total' | t }}</div>
							</div>
							{%- for order in customer.orders -%}
								<a
									class="row tbody"
									href="{{ order.customer_url }}"
									aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
								>
									<span
										id="RowOrder"
										data-label="{{ 'customer.orders.order_number' | t }}"
									>
										{{ order.name }}
									</span>
									<span
										class="order-table-date"
										data-label="{{ 'customer.orders.date' | t }}"
									>
										{{ order.created_at | time_tag: format: 'date' }}
									</span>
									<span data-label="{{ 'customer.orders.payment_status' | t }}">
										{{ order.financial_status_label }}
									</span>
									<span data-label="{{ 'customer.orders.fulfillment_status' | t }}">
										{{ order.fulfillment_status_label }}
									</span>
									<span data-label="{{ 'customer.orders.total' | t }}">
										{{ order.total_price | money_with_currency }}
									</span>
								</a>
							{%- endfor -%}
						</div>
					{%- else -%}
						<div class="account-none">
							<div class="account-none__wrapper">
								{% render 'icon-order' %}

								<div>
									<span class="account__subtitle subtitle subtitle-large">
										{{ 'customer.orders.title' | t }}
									</span>
									<h6 class="h4">
										{{ 'customer.account.empty_order_heading' | t }}
									</h6>
									<div class="account-none__text large-font">
										{{ 'customer.account.empty_order_text' | t }}
									</div>
								</div>

								<div class="button_wrapper custom-hover">
									<a
										href="{{ routes.collections_url | sort_by: 'best-selling' }}"
										class="button button--{{section.settings.button_style}} account-none__button focus-inset"
										data-button-text="{{ 'customer.account.account_button_shop' | t }}"
										tabindex="0"
									>
										<div class="button__content">
											<span
												class="button__label"
												data-label="{{- 'customer.account.account_button_shop' | t | escape -}}"
											>
												{{- 'customer.account.account_button_shop' | t -}}
											</span>
										</div>
										<span class="button_circle"> </span>
									</a>
								</div>
							</div>
						</div>
					{%- endif -%}

					{%- if paginate.pages > 1 -%}
						{% render 'pagination', paginate: paginate %}
					{%- endif -%}
				{% endpaginate %}
			</div>

			<div class="account__right">
				{%- if customer.addresses_count > 0 -%}
					<div class="account-address-wrapper">
						<div class="account-address">
							<ul class="account-address__list account-address__default list-unstyled">
								<span class="account__subtitle subtitle subtitle-large">
									{{ 'customer.addresses.title' | t }}
								</span>

								{%- if customer.default_address.name != blank -%}
									<li class="account-address__item account-address__item-name h4">
										{{ customer.default_address.name }}
									</li>
								{%- endif -%}

								{%- if customer.default_address != blank -%}
									<li>
										{%- if customer.default_address.street != blank -%}
											<span class="account-address__item large-font">
												{{- customer.default_address.street -}}
											</span>
										{%- endif -%}

										{%- if customer.default_address.company != blank -%}
											<span class="account-address__item large-font">
												{{- customer.default_address.company -}}
											</span>
										{%- endif -%}

										{%- if customer.default_address.city != blank -%}
											<span class="account-address__item large-font">
												{{- customer.default_address.city -}}
											</span>
										{%- endif -%}

										{%- if customer.default_address.zip != blank -%}
											<span class="account-address__item large-font">
												{{- customer.default_address.zip -}}
											</span>
										{%- endif -%}

										{%- if customer.default_address.phone != blank -%}
											<span class="account-address__item large-font">
												{{- customer.default_address.phone -}}
											</span>
										{%- endif -%}

										{%- if customer.default_address.country != blank -%}
											<span class="account-address__item large-font">
												{{- customer.default_address.country -}}
											</span>
										{%- endif -%}
									</li>
								{%- endif -%}
							</ul>

							<div class="button_wrapper custom-hover">
								<a
									class="button button--{{section.settings.button_style}} account-address__link focus-inset"
									href="{{ routes.account_addresses_url }}"
									data-button-text="{{ 'customer.account.view_addresses' | t: addresses_count: customer.addresses_count }}"
									tabindex="0"
								>
									<div class="button__content">
										<span
											class="button__label"
											data-label="{{- 'customer.account.view_addresses' | t: addresses_count: customer.addresses_count | escape -}}"
										>
											{{-
												'customer.account.view_addresses'
												| t: addresses_count: customer.addresses_count
											-}}
										</span>
									</div>
									<span class="button_circle"> </span>
								</a>
							</div>
						</div>
					</div>
				{%- else -%}
					<div class="account-none empty-address">
						<div class="account-none__wrapper">
							{% render 'icon-mappin' %}

							<div class="account-none__content">
								<span class="account__subtitle subtitle subtitle-large">
									{{ 'customer.addresses.title' | t }}
								</span>
								<h6 class="h4">
									{{ 'customer.account.empty_address_heading' | t }}
								</h6>
								<div class="account-none__text large-font">
									{{ 'customer.account.empty_address_text' | t }}
								</div>
							</div>

							<div class="button_wrapper custom-hover">
								<a
									href="{{ routes.account_addresses_url }}"
									class="button button--{{section.settings.button_style}} account-none__button focus-inset"
									data-button-text="{{ 'customer.addresses.add_new' | t }}"
									tabindex="0"
								>
									<div class="button__content">
										<span
											class="button__label"
											data-label="{{- 'customer.addresses.add_new' | t | escape -}}"
										>
											{{- 'customer.addresses.add_new' | t -}}
										</span>
									</div>
									<span class="button_circle"> </span>
								</a>
							</div>
						</div>
					</div>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.main-account.name",
	"class": "spaced-section",
	"settings": [
		{
			"type": "header",
			"content": "t:sections.all.section-header.label"
		},
		{
			"type": "select",
			"id": "section_heading_size",
			"options": [
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h1",
			"label": "t:sections.all.heading_size.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header_button.content"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.button_style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.button_style.options__2.label"
				},
				{
					"value": "link",
					"label": "t:sections.all.button.button_style.options__3.label"
				},
				{
					"value": "link-second",
					"label": "t:sections.all.button.button_style.options__4.label"
				}
			],
			"default": "primary",
			"label": "t:sections.all.button.button_style.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},

		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "m",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	]
}
{% endschema %}
