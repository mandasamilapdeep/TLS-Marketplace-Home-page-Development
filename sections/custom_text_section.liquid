{% style %}
  #custom_text_section_{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #custom_text_section_{{ section.id }} .subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_desktop_font_size }}px;
    text-align: {{ section.settings.section_alignment }};
    display: block;
  }

  #custom_text_section_{{ section.id }} .title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_desktop_font_size }}px;
    margin-top: {{ section.settings.title_margin_top_desktop }}px;
    margin-bottom: {{ section.settings.title_margin_bottom_desktop }}px;
  }

  #custom_text_section_{{ section.id }} .title_second_part {
    background: {{ section.settings.title_second_part_gradient }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-left: 5px;
  }

  #custom_text_section_{{ section.id }} .text_box {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_desktop_font_size }}px;
    max-width: {{ section.settings.text_max_width }}px;
    margin: auto;
  }

  #custom_text_section_{{ section.id }} .text_box p {
    color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 767px){
    #custom_text_section_{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #custom_text_section_{{ section.id }} .subtitle {
      font-size: {{ section.settings.subtitle_mobile_font_size }}px;
    }

    #custom_text_section_{{ section.id }} .title {
      font-size: {{ section.settings.title_mobile_font_size }}px;
    }

    #custom_text_section_{{ section.id }} .text {
      font-size: {{ section.settings.text_mobile_font_size }}px;
      margin-top: {{ section.settings.title_margin_top_mobile }}px;
      margin-bottom: {{ section.settings.title_margin_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div id="custom_text_section_{{ section.id }}" style="text-align: {{ section.settings.section_alignment }}">
  <div class="container container_full">
    <div class="custom_text_section_inner">
      {% if section.settings.subtitle != blank %}
        <div class="subtitle_box">
          <p class="subtitle">{{ section.settings.subtitle }}</p>
          <span class="line"></span>
        </div>
      {% endif %}
      {% if section.settings.title_first_part != blank or section.settings.title_second_part != blank %}
        <div class="title_box">
          <h1 class="title">
            {{ section.settings.title_first_part -}}
            <span class="title_second_part">{{ section.settings.title_second_part }}</span>
          </h1>
        </div>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="text_box">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom text section",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Subtitle settings"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color"
    },
    {
      "type": "range",
      "id": "subtitle_desktop_font_size",
      "label": "Subtitle desktop font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "subtitle_mobile_font_size",
      "label": "Subtitle mobile font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 16
    },

    {
      "type": "header",
      "content": "Title settings"
    },
    {
      "type": "text",
      "id": "title_first_part",
      "label": "Title first part"
    },
    {
      "type": "text",
      "id": "title_second_part",
      "label": "Title second part"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color"
    },
    {
      "type": "color_background",
      "id": "title_second_part_gradient",
      "label": "Title second part gradient",
      "default": "linear-gradient(90deg, #a62b48 0%, #d2768d 100%)"
    },
    {
      "type": "range",
      "id": "title_desktop_font_size",
      "label": "Title desktop font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "title_mobile_font_size",
      "label": "Title mobile font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "title_margin_top_desktop",
      "label": "Title margin top desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "title_margin_bottom_desktop",
      "label": "Title margin bottom desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "title_margin_top_mobile",
      "label": "Title margin top mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "label": "Title margin bottom mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "Text settings"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "text_desktop_font_size",
      "label": "Text desktop font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "text_mobile_font_size",
      "label": "Text mobile font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width",
      "min": 300,
      "max": 1200,
      "step": 10,
      "default": 600
    },
    {
      "type": "header",
      "content": "section settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 50
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Custom text section"
    }
  ]
}
{% endschema %}
