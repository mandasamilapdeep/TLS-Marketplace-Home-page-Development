{{ 'testimonials-quote.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonials-quote.js' | asset_url }}" defer="defer"></script>
<script
	src="{{ 'magnetic-hover-effect.js' | asset_url }}"
	defer="defer"
></script>

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_heading_content_alignment = section.settings.section_heading_content_alignment
	assign pulse_subheading = section.settings.pulse_animation_text
	assign section_descr = section.settings.section_descr
	assign column_per_row = 3
	assign swiper_enable = false
	if section.blocks.size > 2
		assign swiper_enable = true
	endif

	assign class_swiper = ''
	assign class_swiper_wrapper = ''
	if swiper_enable
		assign class_swiper = 'swiper'
		assign class_swiper_wrapper = 'swiper-wrapper'
	endif
%}

<div class="testimonials-quote" id="testimonials-quote">
	<div class="container">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			description: section_descr,
			content_alignment: section_heading_content_alignment,
			pulse: pulse_subheading
		%}

		<div class="testimonials-quote__posts--wrapper">
			<div
				class="testimonials-quote__posts {{ class_swiper }}"
				data-column_per_row="{{ column_per_row }}"
			>
				<div
					class="testimonials-quote__posts-inner {{ class_swiper_wrapper }} testimonials-quote__posts-inner--{{ column_per_row }}"
				>
					{%- for block in section.blocks -%}
						{% render 'testimonial-quote',
							image_fit: block.settings.image_fit,
							enable_stars: block.settings.enable_stars,
							text_title: block.settings.text_title,
							text: block.settings.text,
							author_image: block.settings.image,
							author_name: block.settings.author_name,
							author_position: block.settings.author_position,
							rating: block.settings.rating,
							author_social_link: block.settings.author_social_link
						%}
					{%- endfor -%}
				</div>

				{%- if swiper_enable == true -%}
					<div class="testimonials-quote__nav no-js-hidden">
						<div
							class="testimonials-quote__nav-pagination swiper-pagination"
						></div>
					</div>
				{%- endif -%}
			</div>
			{%- if swiper_enable == true -%}
				<div class="swiper-buttons__wrapper">
					<div
						class="swiper-buttons__container"
					>
						<div class="swiper-buttons__box">
							<div class="swiper-button swiper-button-prev">
								<span>{% render 'icon-arrow' %}</span>
							</div>
							<div class="swiper-button swiper-button-next">
								<span>{% render 'icon-arrow' %}</span>
							</div>
						</div>
					</div>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

