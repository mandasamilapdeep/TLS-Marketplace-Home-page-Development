{{ 'section-product-markers.css' | asset_url | stylesheet_tag }}
<script
	src="{{ 'section-product-markers.js' | asset_url }}"
	defer="defer"
></script>
{% style %}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
	--letter-spacing: {{ section.settings.letter_spacing }}em;
	}
	#shopify-section-{{ section.id }} .have-overlay {
	--overlay-alpha : {{ section.settings.overlay_opacity }}%;

	position: relative;
	&::before {
		content: "";
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		z-index: -1;
		pointer-events: none;
		transition: all 0.4s ease;
		background: rgba(var(--color-overlay), var(--overlay-alpha));
	}
	}
{% endstyle %}

{% liquid
	assign backlight_animation = section.settings.backlight_animation
%}

<div
	class="product-markers background color-background-1 {% if section.settings.show_border_top %} product-markers--border-top{% endif %} {% if section.settings.show_border_bottom %} product-markers--border-bottom {% endif %}"
>
	<div class="product-markers__wrapper">
		<div class="container {% if backlight_animation %} backlight-led-animation__bg--new {% endif %}">
			<div class=" product-markers-container">
				{% if section.settings.section_heading != blank
					or section.settings.section_subheading != blank
					or section.settings.button_label != blank
				%}
					<div class="product-markers__header">
						{% render 'section-header',
							section_heading: section.settings.section_heading,
							section_subheading: section.settings.section_subheading,
							section_heading_size: section.settings.section_heading_size,
							section_heading_tag: section.settings.section_heading_tag,
							description: section.settings.description,
							pulse: section.settings.pulse_animation_text
						%}

						{%- if section.settings.button_label != blank -%}
							{% render 'button',
								btn_label: section.settings.button_label,
								btn_link: section.settings.button_link,
								btn_style: section.settings.button_style
							%}
						{% endif %}
					</div>
				{% endif %}

				{% comment %} test commit for exclude nad include {% endcomment %}

				<div class="product-markers__box">
					<div class="product-markers__img">
						<div class="product-markers__img-box">
							{% for block in section.blocks %}
								{% liquid
									assign x = block.settings.position_x
									assign y = block.settings.position_y
									if x >= 50
										assign horizontal_position = 'right'
										assign x = 100 | minus: x
									else
										assign horizontal_position = 'left'
									endif
									if y >= 50
										assign y = 100 | minus: y
										assign vertical_position = ' bottom'
									else
										assign vertical_position = ' top'
									endif

									assign marker_classes = horizontal_position | append: vertical_position
									if forloop.index == 1
										assign marker_classes = marker_classes | append: ' active'
									endif

									assign image_size = block.settings.image_size
									assign section_size = ''

									# Calculate section_size once for reuse
									case image_size
										when 'adapt'
											if block.settings.product != blank and block.settings.product.featured_media != blank
												assign section_size = 1 | divided_by: block.settings.product.featured_media.aspect_ratio | times: 100 | append: '%'
											elsif block.settings.video != blank
												assign section_size = 1 | divided_by: block.settings.video.aspect_ratio | times: 100 | append: '%'
											elsif block.settings.image != blank
												assign section_size = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | append: '%'
											endif
									endcase
								%}

								<div
									id="marker-button-{{ forloop.index }}"
									class="product-markers__marker js-product-markers__item {{ marker_classes }}"
									data-index="{{ forloop.index }}"
									style="{{ horizontal_position }} : {{ x }}%; {{ vertical_position }} : {{ y }}%;"
									tabindex="0"
									role="button"
									aria-label="View product {{ block.settings.product.title | escape }}"
									aria-expanded="false"
									aria-controls="marker-panel-{{ forloop.index }}"
								>
									<div class="card-wrapper">
										<div class="product-markers__card">
											<div
												data-index="{{ forloop.index }}"
												id="marker-panel-{{ forloop.index }}"
												class="product-markers__product js-product-markers__item-inner collection-product-card"
												role="region"
												aria-hidden="true"
												aria-labelledby="marker-button-{{ forloop.index }}"
											>
												{% if block.settings.product != blank %}
													<!-- Product media -->
													{% if block.settings.product.featured_media != blank
														or block.settings.product.media[1] != null
													%}
														{% liquid
															assign has_two_images = false
															if block.settings.product.featured_media != blank and block.settings.product.media[1] != null
																assign has_two_images = true
															endif
														%}

														<div class="product-markers__product_img {{ image_size }} {% if has_two_images %}has-two-images{% endif %}">
															<div>
																{% if block.settings.product.featured_media
																		!= blank
																%}
																	<div>
																		<a
																			href="{{ block.settings.product.url | default: '#' }}"
																			class="media media--transparent media--hover-effect"
																			style="--slide-height: {{ section_size }}; {% if image_size != 'adapt' %}aspect-ratio: {{ image_size }}{% endif %}"
																			aria-label="{{ block.settings.product.title }}"
																		>
																			{% assign image_height = block.settings.product.featured_media.width
																				| divided_by: block.settings.product.featured_media.aspect_ratio
																			%}
																			{% assign style = 'object-position: '
																				| append: block.settings.product.featured_media.presentation.focal_point
																				| append: ';object-fit: cover;'
																			%}
																			{{
																				block.settings.product.featured_media
																				| image_url: width: 1100
																				| image_tag:
																					loading: 'lazy',
																					width: block.settings.product.featured_media.width,
																					height: image_height,
																					sizes: '100vw (min-width: 767px) 50vw',
																					widths: '375, 550, 750, 1100',
																					class: 'jarallax-img media--first',
																					style: style
																			}}
																		</a>
																	</div>
																{% endif %}

																{%- if block.settings.product.media[1] != null
																-%}
																	<div>
																		<a
																			href="{{ block.settings.product.url | default: '#' }}"
																			class="media media--transparent media--hover-effect"
																			style="--slide-height: {{ section_size }}; {% if image_size != 'adapt' %}aspect-ratio: {{ image_size }}{% endif %}"
																			aria-label="{{ block.settings.product.title }}"
																		>
																			{% assign style = 'object-position: '
																				| append: block.settings.product.media[1].presentation.focal_point
																				| append: ';object-fit: cover;'
																			%}
																			{{
																				block.settings.product.media[1]
																				| image_url:
																					width: block.settings.product.media[1].width
																				| image_tag:
																					loading: 'lazy',
																					class: 'motion-reduce media--second',
																					widths: '360, 533, 720, 940',
																					sizes: sizes,
																					style: style
																			}}
																		</a>
																	</div>
																{%- endif -%}
															</div>
														</div>
													{% endif %}

													{%- if block.settings.show_vendor -%}
														<span class="visually-hidden">
															{{- 'accessibility.vendor' | t -}}
														</span>
														{% if settings.enable_vendor_link %}
															<a
																href="{{ block.settings.product.vendor | url_for_vendor }}"
																class="unstyled-link caption-with-letter-spacing vendor-link extra-small-font"
																aria-label="{{ block.settings.product.vendor }}"
															>
																{{ block.settings.product.vendor }}
															</a>
														{% else %}
															<div class="extra-small-font">
																{{ block.settings.product.vendor }}
															</div>
														{% endif %}
													{%- endif -%}

													<h6 class="product-heading large-font animated-link__underline--multirow">
														<a
															class="full-unstyled-link"
															href="{{ block.settings.product.url | default: '#' }}"
															title="{{ block.settings.product.title | escape }}"
															aria-label="{{ block.settings.product.title }}"
														>
															{{ block.settings.product.title | escape }}
														</a>
													</h6>

													{% render 'price',
														product: block.settings.product,
														price_class: ''
													%}
												{% else %}
													{% if block.settings.image != blank
														or block.settings.video != blank
													%}
														<div
															class="product-markers__product_img {{ image_size }}"
															style="--slide-height: {{ section_size }}; {% if image_size != 'adapt' %}aspect-ratio: {{ image_size }}{% endif %}"
														>
															{%- if block.settings.video != blank -%}
																{% liquid
																	assign video_height = block.settings.video.sources[0].width | divided_by: block.settings.video.aspect_ratio
																%}
																{{
																	block.settings.video
																	| video_tag:
																		width: block.settings.video.sources[0].width,
																		height: video_height,
																		autoplay: true,
																		loop: true,
																		controls: false,
																		muted: true
																}}
															{% endif %}
															{%- if block.settings.image != blank
																and block.settings.video == blank
															-%}
																{% assign image_height = block.settings.image.width
																	| divided_by: block.settings.image.aspect_ratio
																%}
																{{
																	block.settings.image
																	| image_url: width: 1100
																	| image_tag:
																		loading: 'lazy',
																		width: block.settings.image.width,
																		height: image_height,
																		sizes: '100vw (min-width: 767px) 50vw',
																		widths: '375, 550, 750, 1100',
																		class: 'jarallax-img'
																}}
															{%- endif -%}
														</div>
													{% endif %}

													{%- if block.settings.heading != blank -%}
														<h6 class="product-heading">
															{{ block.settings.heading }}
														</h6>
													{%- endif -%}

													{%- if block.settings.description != blank -%}
														<div class="product-description richtext">
															{{ block.settings.description }}
														</div>
													{%- endif -%}
												{% endif %}
											</div>
										</div>
									</div>

									{% render 'icon-circle', custom_class: 'marker-icon-circle' %}
								</div>
							{% endfor %}

							<div
								class="product-markers__overlay have-overlay product-markers__media"
								aria-hidden="true"
							>
								{%- if section.settings.image != blank -%}
									{% assign image_height = section.settings.image.width
										| divided_by: section.settings.image.aspect_ratio
									%}
									{{
										section.settings.image
										| image_url: width: 1780
										| image_tag:
											loading: 'lazy',
											width: section.settings.image.width,
											height: image_height,
											sizes: '100vw',
											widths: '375, 550, 750, 1100, 1500, 1780'
									}}
								{%- else -%}
									{{
										'hero-apparel-2'
										| placeholder_svg_tag: 'placeholder-svg placeholder'
									}}
								{%- endif -%}
							</div>
						</div>

						<!-- Mobile view -->
						<div class="product-markers-for-mobile">
							{%- for block in section.blocks -%}
								<div
									data-index="{{ forloop.index }}"
									id="marker-panel-{{ forloop.index }}"
									class="product-markers__product js-product-markers__item-inner collection-product-card"
									role="region"
									aria-hidden="true"
									aria-labelledby="marker-button-{{ forloop.index }}"
								>
									{% liquid
										assign image_size = block.settings.image_size
										assign section_size = ''

										# Calculate section_size for mobile view
										case image_size
											when 'adapt'
												if block.settings.product != blank and block.settings.product.featured_media != blank
													assign section_size = 1 | divided_by: block.settings.product.featured_media.aspect_ratio | times: 100 | append: '%'
												elsif block.settings.video != blank
													assign section_size = 1 | divided_by: block.settings.video.aspect_ratio | times: 100 | append: '%'
												elsif block.settings.image != blank
													assign section_size = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | append: '%'
												endif
										endcase
									%}

									{% if block.settings.product != blank %}
										<!-- Product media -->
										{% if block.settings.product.featured_media != blank
											or block.settings.product.media[1] != null
										%}
											{% liquid
												assign has_two_images = false
												if block.settings.product.featured_media != blank and block.settings.product.media[1] != null
													assign has_two_images = true
												endif
											%}

											<div class="product-markers__product_img {{ image_size }} {% if has_two_images %}has-two-images{% endif %}">
												<div>
													{% if block.settings.product.featured_media != blank
													%}
														<div>
															<a
																href="{{ block.settings.product.url | default: '#' }}"
																class="media media--transparent media--hover-effect"
																style="--slide-height: {{ section_size }}; {% if image_size != 'adapt' %}aspect-ratio: {{ image_size }}{% endif %}"
																aria-label="{{ block.settings.product.title }}"
															>
																{% assign image_height = block.settings.product.featured_media.width
																	| divided_by: block.settings.product.featured_media.aspect_ratio
																%}
																{% assign style = 'object-position: '
																	| append: block.settings.product.featured_media.presentation.focal_point
																	| append: ';object-fit: cover;'
																%}
																{{
																	block.settings.product.featured_media
																	| image_url: width: 1100
																	| image_tag:
																		loading: 'lazy',
																		width: block.settings.product.featured_media.width,
																		height: image_height,
																		sizes: '100vw (min-width: 767px) 50vw',
																		widths: '375, 550, 750, 1100',
																		class: 'jarallax-img media--first',
																		style: style
																}}
															</a>
														</div>
													{% endif %}

													{%- if block.settings.product.media[1] != null -%}
														<div>
															<a
																href="{{ block.settings.product.url | default: '#' }}"
																class="media media--transparent media--hover-effect"
																style="--slide-height: {{ section_size }}; {% if image_size != 'adapt' %}aspect-ratio: {{ image_size }}{% endif %}"
																aria-label="{{ block.settings.product.title }}"
															>
																{% assign style = 'object-position: '
																	| append: block.settings.product.media[1].presentation.focal_point
																	| append: ';object-fit: cover;'
																%}
																{{
																	block.settings.product.media[1]
																	| image_url:
																		width: block.settings.product.media[1].width
																	| image_tag:
																		loading: 'lazy',
																		class: 'motion-reduce media--second',
																		widths: '360, 533, 720, 940',
																		sizes: sizes,
																		style: style
																}}
															</a>
														</div>
													{%- endif -%}
												</div>
											</div>
										{% endif %}
									{% else %}
										<!-- Block image or video -->
										{% if block.settings.image != blank
											or block.settings.video != blank
										%}
											<div
												class="product-markers__product_img {{ image_size }}"
												style="--slide-height: {{ section_size }}; {% if image_size != 'adapt' %}aspect-ratio: {{ image_size }}{% endif %}"
											>
												{%- if block.settings.video != blank -%}
													{% liquid
														assign video_height = block.settings.video.sources[0].width | divided_by: block.settings.video.aspect_ratio
													%}
													{{
														block.settings.video
														| video_tag:
															width: block.settings.video.sources[0].width,
															height: video_height,
															autoplay: true,
															loop: true,
															controls: false,
															muted: true
													}}
												{% endif %}
												{%- if block.settings.image != blank
													and block.settings.video == blank
												-%}
													{% assign image_height = block.settings.image.width
														| divided_by: block.settings.image.aspect_ratio
													%}
													{{
														block.settings.image
														| image_url: width: 1100
														| image_tag:
															loading: 'lazy',
															width: block.settings.image.width,
															height: image_height,
															sizes: '100vw (min-width: 767px) 50vw',
															widths: '375, 550, 750, 1100',
															class: 'jarallax-img'
													}}
												{%- endif -%}
											</div>
										{% endif %}
									{% endif %}

									<h6 class="product-heading">
										{%- if block.settings.product != blank -%}
											{{ block.settings.product.title }}
										{%- elsif block.settings.heading != blank -%}
											{{ block.settings.heading }}
										{%- endif -%}
									</h6>
									{%- if block.settings.product == blank -%}
										<div class="product-description">
											{%- if block.settings.description != blank -%}
												{{ block.settings.description }}
											{%- endif -%}
										</div>
									{%- endif -%}
									{% if block.settings.product != blank %}
										{% render 'price',
											product: block.settings.product,
											price_class: ''
										%}
									{% endif %}
								</div>
							{% endfor %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.product_markers.name",
	"tag": "section",
	"class": "product-markers-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "backlight_animation",
			"default": true,
			"label": "t:sections.all.backlight_animation.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-header.label"
		},
		{
			"type": "text",
			"id": "section_subheading",
			"default": "t:sections.product_markers.subheading.default",
			"label": "t:sections.all.section-header.subheading.label"
		},
		{
			"type": "checkbox",
			"id": "pulse_animation_text",
			"label": "t:sections.all.pulse_animation_text.label",
			"default": false
		},
		{
			"type": "text",
			"id": "section_heading",
			"default": "t:sections.product_markers.heading.default",
			"label": "t:sections.all.section-header.heading.label"
		},
		{
			"type": "select",
			"id": "section_heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:sections.all.heading_size.options__4.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h1",
			"label": "t:sections.all.heading_size.label",
			"visible_if": "{{ section.settings.section_heading != blank }}"
		},
		{
			"type": "select",
			"id": "section_heading_tag",
			"default": "h3",
			"label": "t:sections.all.heading_tag.label",
			"info": "t:sections.all.heading_tag.info",
			"visible_if": "{{ section.settings.section_heading != blank }}",
			"options": [
				{
					"value": "h1",
					"label": "t:sections.all.heading_tag.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_tag.options__2.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_tag.options__3.label"
				},
				{
					"value": "h4",
					"label": "t:sections.all.heading_tag.options__4.label"
				},
				{
					"value": "h5",
					"label": "t:sections.all.heading_tag.options__5.label"
				},
				{
					"value": "h6",
					"label": "t:sections.all.heading_tag.options__6.label"
				},
				{
					"value": "div",
					"label": "t:sections.all.heading_tag.options__7.label"
				},
				{
					"value": "p",
					"label": "t:sections.all.heading_tag.options__8.label"
				},
				{
					"value": "span",
					"label": "t:sections.all.heading_tag.options__9.label"
				}
			]
		},
		{
			"type": "inline_richtext",
			"id": "description",
			"default": "t:sections.product_markers.description.default",
			"label": "t:sections.all.text.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header_button.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Learn More",
			"label": "t:sections.all.button.button_label.label",
			"info": "t:sections.all.button.button_label.info"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.button_link.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.button_style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.button_style.options__2.label"
				},
				{
					"value": "link",
					"label": "t:sections.all.button.button_style.options__3.label"
				},
				{
					"value": "link-second",
					"label": "t:sections.all.button.button_style.options__4.label"
				}
			],
			"default": "primary",
			"label": "t:sections.all.button.button_style.label"
		},
