{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-blog.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign post_limit = section.settings.post_limit
	assign column_per_row = section.settings.columns_per_row
	assign image_ratio = section.settings.image_ratio
	assign swipe_on_mobile = section.settings.swipe_on_mobile
	assign columns_mobile = section.settings.columns_mobile
%}

<div class="blog">
	<div class="container">
		{% if section.settings.section_heading != blank
			or section.settings.section_subheading != blank
			or section.settings.description != blank
			or section.settings.section_button_label != blank
		%}
			<div class="section-header">
				<div class="section-header__wrapper">
					{%- if section.settings.section_subheading != blank -%}
						<span class="section-header__subtitle subtitle {% if section.settings.pulse_animation_text == true %} subtitle_dot {% endif %}">
							{{ section.settings.section_subheading }}
						</span>
					{% endif %}
					{%- if section.settings.section_heading != blank -%}
						<{{ section.settings.section_heading_tag | default: 'h3' }} 
							class="section-header__title {{ section.settings.section_heading_size }}"
						>
							{{ section.settings.section_heading }}
						</{{ section.settings.section_heading_tag | default: 'h3' }}>
					{% endif %}
					{%- if section.settings.description != blank -%}
						<span class="richtext">{{ section.settings.description }}</span>
					{% endif %}
				</div>
				{% render 'button',
					btn_label: section.settings.section_button_label,
					btn_link: section.settings.section_button_link,
					btn_style: section.settings.button_style
				%}
			</div>
		{% endif %}

		<div
			class="blog__posts {% if swipe_on_mobile and post_limit > 1 %}swiper swiper--articles{% endif %}"
			data-columns-mobile="{{columns_mobile}}"
		>
			<div class="blog__posts-wrapper blog__posts-wrapper--{{ column_per_row }} blog__posts-wrapper--{{columns_mobile}}-mobile {% if swipe_on_mobile and post_limit > 1 %}swiper-wrapper{% endif %}">
				{%- if section.settings.blog != blank
					and section.settings.blog.articles_count > 0
				-%}
					{%- for article in section.settings.blog.articles
						limit: post_limit
					-%}
						{% style %}
							#shopify-section-{{ section.id }} [data-id="{{ article.id }}"].blog__post {
								--aspect-ratio: {{ image_ratio }};
							}
						{% endstyle %}
						<div
							class="blog__post article {% if swipe_on_mobile and post_limit > 1 %}swiper-slide{% endif %}"
							data-id="{{ article.id }}"
						>
							{%
								render 'article-card',
								blog: section.settings.blog,
								article: article,
								heading_tag: section.settings.blog_heading_tag,
								show_image: section.settings.show_image,
								show_tags: section.settings.show_tags,
								show_date: section.settings.show_date,
								show_author: section.settings.show_author,
								show_excerpt: section.settings.show_excerpt,
								show_count_comments: section.settings.show_count_comments,
								article-card__title-size: 'h5'
							%}
						</div>
					{%- endfor -%}
				{%- else -%}
					{% style %}
						#shopify-section-{{ section.id }} .blog__post {
							--aspect-ratio: {{ image_ratio }};
						}
					{% endstyle %}
					{% for i in (1..post_limit) %}
						<div class="blog__post article {% if swipe_on_mobile and post_limit > 1 %}swiper-slide{% endif %}">
							<article class="article-card">
								<div class="article-card__image-wrapper">
									<div class="article-card__image">
										{{
											'blog-apparel-1'
											| placeholder_svg_tag: 'placeholder-svg placeholder'
										}}
									</div>
								</div>
								<header class="article-card__header">
									<h4 class="article-card__title h4">
										{{ 'sections.featured_blog.onboarding_title' | t }}
									</h4>
									<p class="article-card__excerpt">
										{{ 'sections.featured_blog.onboarding_content' | t }}
									</p>
								</header>
							</article>
						</div>
					{% endfor %}
				{% endif %}
			</div>

			{%- if swipe_on_mobile and post_limit > 1 -%}
				<div class="blog__nav no-js-hidden">
					<div class="blog__nav-pagination swiper-pagination"></div>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.featured-blog.name",
	"tag": "section",
	"class": "spaced-section section-featured-blog",
	"enabled_on": {
