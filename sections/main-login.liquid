{{ 'auth-user.css' | asset_url | stylesheet_tag }}

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign text = section.settings.text
	assign heading = section.settings.heading
	assign heading_size = section.settings.heading_size
%}

<div
	class="customer login"
>
	<div class="login__wrapper">
		<div class="container login__container">
			<div class="login__col color-background-1">
				<div class="login__reset" id="recover">
					<div class="page-header">
						<div class="page-header__inner">
							<h2 class="title--page login__title" tabindex="-1">
								{{ 'customer.recover_password.title' | t }}
							</h2>
							<p>{{ 'customer.recover_password.subtext' | t }}</p>
						</div>
					</div>
					<div>
						{%- form 'recover_customer_password' -%}
							{% assign recover_success = form.posted_successfully? %}
							<div class="field">
								<input
									dir="ltr"
									type="email"
									value=""
									name="email"
									id="RecoverEmail"
									autocorrect="off"
									autocapitalize="off"
									autocomplete="email"
									{% if form.errors %}
										aria-invalid="true"
										aria-describedby="RecoverEmail-email-error"
										autofocus
									{% endif %}
									placeholder="example@email.com"
									tabindex="0"
								>
								{% comment %}
									<label for="RecoverEmail">
										{{- 'customer.login_page.email' | t -}}
									</label>
								{% endcomment %}
							</div>

							<div class="login__buttons">
								<div class="button_wrapper custom-hover">
									<button
										class="button button--primary  login__sign-in focus-inset"
										data-button-text="{{ 'customer.login_page.submit' | t }}"
										tabindex="0"
									>
										<div class="button__content">
											<span
												class="button__label"
												data-label="{{- 'customer.login_page.submit' | t | escape -}}"
											>
												{{- 'customer.login_page.submit' | t -}}
											</span>
										</div>
										<span class="button_circle"> </span>
									</button>
								</div>

								<div class="button_wrapper custom-hover">
									<a
										class="button button--secondary  login__sign-in anchor focus-inset"
										href="#login"
										aria-label="login link"
									>
										<div class="button__content">
											<span
												class="button__label"
												data-label="{{- 'customer.login_page.cancel' | t | escape -}}"
											>
												{{- 'customer.login_page.cancel' | t -}}
											</span>
										</div>
										<span class="button_circle"> </span>
									</a>
								</div>
							</div>
						{%- endform -%}
					</div>
				</div>

				<div class="login__form" id="login">
					<div class="page-header">
						<div class="page-header__inner">
							{%- if heading != blank -%}
								<h1
									class="title--page login__title {{ heading_size }}"
									tabindex="-1"
								>
									{{ heading }}
								</h1>
							{%- endif -%}
							<div class="login__tabs">
								<div class="button_wrapper custom-hover">
									<a
										class="button button--primary register__create-acc focus-inset"
										data-button-text="{{ 'customer.register.submit' | t }}"
										tabindex="0"
									>
										<div class="button__content">
											<span
												class="button__label"
												data-label="{{- 'customer.login_page.title' | t | escape -}}"
											>
												{{- 'customer.login_page.title' | t -}}
											</span>
										</div>
										<span class="button_circle"> </span>
									</a>
								</div>

								<a
									href="{{ routes.account_register_url }}"
									class="login-tab__link"
									tabindex="0"
									aria-label="login tab link"
								>
									{{ 'customer.register.submit' | t }}
								</a>
							</div>
							{% if text != blank %}
								<div class="page-header__text richtext__content">
									{{ text }}
								</div>
							{% endif %}

							{%- if recover_success == true -%}
								<h3 class="form__message" tabindex="-1" autofocus>
									{{ 'customer.recover_password.success' | t }}
								</h3>
							{%- endif -%}
						</div>
					</div>
					{%- form 'customer_login' -%}
						<div class="field login__field login__email">
							<input
								dir="ltr"
								type="email"
								name="customer[email]"
								class="field__input focus-inset"
								id="CustomerEmail"
								autocomplete="email"
								autocorrect="off"
								autocapitalize="off"
								required
								{% if form.errors contains 'form' %}
									aria-invalid="true"
									aria-describedby="LoginForm-email-error"
								{% endif %}
								placeholder="example@email.com"
								tabindex="0"
							>
						</div>
						{% unless template.name == 'register' %}
							{{ form.errors | default_errors }}
						{% endunless %}

						{%- if form.password_needed -%}
							<div class="field field--pass login__field">
								<div class="button-pass-visibility">
									{% render 'icon-eye' %}
									{% render 'icon-eye-close' %}
								</div>
								<input
									type="password"
									value=""
									name="customer[password]"
									class="field__input focus-inset"
									id="CustomerPassword"
									autocomplete="current-password"
									{% if form.errors contains 'form' %}
										aria-invalid="true"
									{% endif %}
									required
									placeholder="{{ 'customer.login_page.password_placeholder' | t }}"
									tabindex="0"
								>
							</div>
							{% unless template.name == 'register' %}
								{{ form.errors | default_errors }}
							{% endunless %}
							<a
								href="#recover"
								class="anchor login__forgot-password focus-inset"
								aria-label="recover password link"
							>
								<span>{{ 'customer.login_page.forgot_password' | t }}</span>
							</a>
						{%- endif -%}

						<div class="button_wrapper custom-hover login__buttons">
							<button
								class="button button--primary login__sign-in focus-inset "
								data-button-text="{{ 'customer.login_page.title' | t }}"
								tabindex="0"
							>
								<div class="button__content">
									<span
										class="button__label"
										data-label="{{- 'customer.login_page.title' | t | escape -}}"
									>
										{{- 'customer.login_page.title' | t -}}
									</span>
								</div>
								<span class="button_circle"> </span>
							</button>
						</div>
					{%- endform -%}
				</div>

				{%- if shop.checkout.guest_login -%}
					<div class="login__guest">
						<div class="login__title">
							{{ 'customer.login_page.guest_title' | t }}
						</div>

						{%- form 'guest_login' -%}
							<button
								class="button button--primary focus-inset"
								data-button-text="{{ 'customer.login_page.guest_continue' | t }}"
							>
								<span>{{ 'customer.login_page.guest_continue' | t }}</span>
							</button>
						{%- endform -%}
					</div>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

<script>
	window.onload = () => {
		typeof PasswordViewer !== 'undefined' && new PasswordViewer();
	};
</script>

{% schema %}
{
	"name": "t:sections.main-login.name",
	"tag": "section",
	"class": "spaced-section login-section",
	"settings": [
		{
			"type": "header",
			"content": "t:sections.all.content_options.header.content"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "t:sections.all.heading.label",
			"default": "Here Can Be Your Main Title"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:sections.all.heading_size.options__4.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h2",
			"label": "t:sections.all.heading_size.label"
		},
		{
			"type": "inline_richtext",
			"id": "text",
			"default": "Details Go Here",
			"label": "t:sections.all.text.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	]
}
{% endschema %}
