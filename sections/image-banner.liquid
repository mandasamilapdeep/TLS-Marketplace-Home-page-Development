{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lazyload-fade-scale.js' | asset_url }}" defer="defer"></script>

{% liquid
	assign section_layout = 'overlay'
	assign section_size = section.settings.section_size
	assign image_ratio = section.settings.image_ratio
	assign pulse_animation_text = section.settings.pulse_animation_text
	assign enable_animation = section.settings.enable_animation
	assign color_scheme = 'background-1'
	assign ticker_text = section.settings.ticker_text
	assign subheading = section.settings.subheading
	assign heading = section.settings.heading
	assign text = section.settings.text
	assign button_label = section.settings.button_label
	assign button_link = section.settings.button_link
	assign button_style = section.settings.button_style
	assign transparent_text_stroke = section.settings.transparent_text_stroke
	assign ticker_speed = section.settings.ticker_speed
	assign ticker_size = section.settings.ticker_size
	assign backlight_animation = section.settings.backlight_animation
	assign heading_size = section.settings.heading_size
	assign heading_tag = section.settings.heading_tag

	if image_ratio == 'adapt'
		if section.settings.image == blank
			assign aspect_ratio = 0
			assign padding_bottom = 0
		else
			assign aspect_ratio = section.settings.image.aspect_ratio
			if section_size == 'full' and section_layout == 'standard'
				assign padding_bottom = 'calc((50vw - var(--scrollbar-width, "0px") / 2) / (var(--aspect_ratio)))'
			elsif section_size == 'full' and section_layout == 'overlay'
				assign padding_bottom = 'calc((100vw - var(--scrollbar-width, "0px")) / (var(--aspect_ratio)))'
			else
				assign padding_bottom = 'calc(100% / (var(--aspect_ratio)))'
			endif
		endif
	elsif image_ratio == 'large'
		assign padding_bottom = 'calc(100vh - var(--header-height, "0px"))'
	else
		assign aspect_ratio = image_ratio
		if section_size == 'full' and section_layout == 'standard'
			assign padding_bottom = 'calc((50vw - var(--scrollbar-width, "0px") / 2) / (var(--aspect_ratio)))'
		elsif section_size == 'full' and section_layout == 'overlay'
			assign padding_bottom = 'calc((100vw - var(--scrollbar-width, "0px")) / (var(--aspect_ratio)))'
		else
			assign padding_bottom = 'calc(100% / (var(--aspect_ratio)))'
		endif
	endif

	assign class_backlight_animation = ''
	if backlight_animation
		assign class_backlight_animation = 'backlight-led-animation__bg--new'
	endif
%}

{% style %}
	{% render 'section-margin' %}

	#shopify-section-{{ section.id }} .image-banner {
	  --aspect_ratio: {{ aspect_ratio }};
		--image-position-mobile: {{ section.settings.image_position }}
	}

	#shopify-section-{{ section.id }} .image-banner__overlay {
	  opacity: {{ section.settings.overlay_opacity_mobile }};
	}

	@media screen and (min-width: 990px) {
		#shopify-section-{{ section.id }} .image-banner__overlay {
		 	opacity: {{ section.settings.overlay_opacity }};
		}
	}

	{%- if section_layout == 'overlay' -%}
	  #shopify-section-{{ section.id }} .image-banner__container::after {
	    content: "";
	    display: block;
	    width: 0;
	    padding-bottom: {{ padding_bottom }};
	  }
	{%- endif -%}
	{% if section_size == 'full' %}
		#shopify-section-{{ section.id }} .marquee-ticker-container {
				overflow: visible;
		}
	{% endif %}
{% endstyle %}

<div
	class="image-banner color-{{ color_scheme }} {{ section_layout }} {{ class_backlight_animation }} "
	data-is-animation="{{ enable_animation }}"
>
	<div
		class="image-banner__container {% if section_size == 'container' %} container{% else %} section-full-size{% endif %}"
	>
		<div
			class="image-banner__wrapper {% if section_size != 'container' %} container{% endif %}"
		>
			<div
				class="image-banner__media  animate-on-scroll--image"
			>
				{% liquid
					assign width_adapt_ratio = 1
					if section.settings.image.width > section.settings.image.height
						assign width_adapt_ratio = 550 | times: section.settings.image.aspect_ratio | round: 2
					endif

					if section_size == 'full'
						assign desktop_width = '100vw'
					else
						assign desktop_width = 'calc(100vw - 64px * 2)'
					endif
				%}
				{% capture sizes %}
				(min-width: 1100px) {{ desktop_width }},
				{% if width_adapt_ratio != 1 %}
					{{ width_adapt_ratio }}px
				{% else %}
					100vw
				{% endif %}
			{% endcapture %}
				{%- if section.settings.image != blank -%}
					{% liquid
						assign fetch_priority = 'auto'
						assign image_loading = 'lazy'
						if section.index == 1
							assign fetch_priority = 'high'
							assign image_loading = 'eager'
						endif
					%}
					{{
						section.settings.image
						| image_url: width: section.settings.image.width
						| image_tag:
							loading: image_loading,
							fetchpriority: fetch_priority,
							sizes: sizes,
							widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
					}}
				{% else %}
					{{ 'hero-apparel-2' | placeholder_svg_tag }}
				{%- endif -%}
			</div>
			<span class="image-banner__overlay"></span>
			<a
				href="{{ button_link }}"
				class="image-banner__link-overlay"
				aria-label="{{ heading }}"
			></a>
			<div
				class="image-banner__content"
			>
				<div class="image-banner__content--top">
					<a
						href="{{ button_link }}"
						class="image-banner__link-overlay"
						aria-label="{{ heading }}"
					></a>
					{% render 'subtitle',
						text: subheading,
						pulse: pulse_animation_text,
						className: 'image-banner__subheading subheading subtitle-large'
					%}
					{%- if heading != blank -%}
						<{{ heading_tag | default: 'h1' }}
							class="image-banner__heading {{ heading_size }}"
						>
							{{ heading }}
						</{{ heading_tag | default: 'h1' }}>
					{%- endif -%}
					{%- if text != blank -%}
						<div class="image-banner__text richtext__content richtext_custom large-font">
							{{ text }}
						</div>
					{%- endif -%}
					<div>
						{%
							render 'button',
							btn_label: button_label,
							btn_link: button_link,
							btn_style: button_style,
						%}
					</div>
				</div>
				{% render 'marquee-ticker-new',
					id: section.id,
					ticker_text: ticker_text,
					transparent_text_stroke: transparent_text_stroke,
					ticker_speed: ticker_speed,
					ticker_size: ticker_size,
					pause_on_hover: false,
					change_directon: true
				%}
			</div>
		</div>
	</div>
</div>

