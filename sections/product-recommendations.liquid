<link
	rel="stylesheet"
	href="{{ 'component-card.css' | asset_url }}"
	media="print"
	onload="this.media='all'"
>

<link
	rel="stylesheet"
	href="{{ 'section-product-recommendations.css' | asset_url }}"
	media="print"
	onload="this.media='all'"
>

<noscript>
	{{- 'section-product-recommendations.css' | asset_url | stylesheet_tag -}}
</noscript>

{%- if settings.quickview_show
	or settings.show_on_mobile
	or settings.type_color_swatch == 'custom'
-%}
	{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if settings.quickview_show or settings.show_on_mobile -%}
	<link
		rel="stylesheet"
		href="{{ 'component-deferred-media.css' | asset_url }}"
		media="all"
	>
	<link
		rel="preload"
		href="{{ 'quick-add.css' | asset_url }}"
		as="style"
		onload="this.onload=null;this.rel='stylesheet'"
	>
{%- endif -%}

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign swipe_on_mobile = section.settings.swipe_on_mobile
%}

<product-recommendations
	class="product-recommendations"
	data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}"
	role="region"
	aria-labelledby="product-recommendations-heading-{{ section.id }}"
>
	<div class="container">
		{% render 'section-header',
			section_heading: section.settings.section_heading,
			section_heading_size: section.settings.section_heading_size,
			section_heading_tag: section.settings.section_heading_tag,
			section_subheading: section.settings.subtitle,
			description: '',
			content_alignment: 'left',
			pulse: section.settings.pulse_animation_text,
			id: 'product-recommendations-heading-#{section.id}'
		%}

		{% if recommendations.performed and recommendations.products_count > 0 %}
			<div
				class="product-recommendations__content{% if swipe_on_mobile %} swiper swiper--recomend-products{% endif %}"
				data-columns-mobile="2"
				aria-live="polite"
			>
				<ul class="product-recommendations__wrapper product-recommendations__wrapper--{{ section.settings.columns_per_row }} list-unstyled{% if swipe_on_mobile %} swiper-wrapper{% endif %}">
					{% for recommendation in recommendations.products
						limit: section.settings.products_limit
					%}
						{%- assign z_index = 1000 | minus: forloop.index -%}
						<li
							class="product-recommendations__item collection-product-card quickview{%- if settings.quickview_hover -%}--hover{% endif %} {% if swipe_on_mobile %}swiper-slide{% endif %}"
							style="z-index: {{ z_index }};"
						>
							{% render 'product-card',
								product_card_product: recommendation,
								media_size: section.settings.image_ratio,
								media_fit: section.settings.image_fit,
								show_secondary_image: section.settings.show_secondary_image,
								show_vendor: section.settings.show_vendor,
								show_collection: section.settings.show_collection,
								show_desc: section.settings.show_desc,
								section_id: section.id,
								add_id: forloop.index,
								content_alignment: 'left',
								heading_tag: section.settings.product_heading_tag
							%}
						</li>
					{%- endfor -%}
				</ul>

				{%- if swipe_on_mobile -%}
					<div class="swipe-on-mobile__nav no-js-hidden">
						<div
							class="product-recommendations__pagination swiper-pagination"
						></div>
					</div>
				{%- endif -%}
			</div>
		{% else %}
			<div
				class="product-recommendations__empty"
				style="display: none;"
				role="status"
				aria-live="polite"
			>
				<span>
					{{ 'sections.product_recommendations.recommendations_empty' | t }}
				</span>
			</div>
		{% endif %}

		<div
			class="product-recommendations__loading"
			style="display: none;"
			role="status"
			aria-live="polite"
		>
			{% render 'icon-spinner' %}
		</div>
	</div>
</product-recommendations>

