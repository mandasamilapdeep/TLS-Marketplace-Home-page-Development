{{ 'section-card-slider.css' | asset_url | stylesheet_tag }}

{% style %}
	{% render 'section-margin' %}
	.section-{{ section.id }}-padding {
		--columns-per-row: {{ section.settings.columns_per_row | default: 4 }};
		{% if section.settings.columns_per_row == 6 %}
			@media screen and (min-width: 1100px) and (max-width: 1359px) {
				--columns-per-row: 5;
			}
		{% endif %}
	}
{% endstyle %}

<script src="{{ 'card-slider.js' | asset_url }}" defer="defer"></script>

<div
	class="card-slider section-{{ section.id }}-padding"
	id="CardSlider-{{ section.id }}"
>
	<div class="container">
		{% render 'section-header',
			section_heading: section.settings.heading,
			section_subheading: section.settings.subheading,
			section_heading_size: section.settings.section_heading_size,
			section_heading_tag: section.settings.section_heading_tag,
			pulse: section.settings.pulse_animation_text
		%}

		<div
			class="card-slider__wrapper js-appearance-animation"
			data-autoplay="{{ section.settings.autoplay }}"
			data-speed="{{ section.settings.slideshow_speed }}"
			data-delay="{{ section.settings.slideshow_delay }}"
			data-per-row="{{ section.settings.columns_per_row }}"
			data-stop-autoplay="{{ section.settings.stop_autoplay }}"
		>
			<div class="card-slider__container swiper">
				<div class="card-slider__slides swiper-wrapper">
					{% for block in section.blocks %}
						{% liquid
							assign anim_delay_coeff = 0.1
							if section.blocks.size > 12
								assign anim_delay_coeff = 0.05
							elsif section.blocks.size > 24
								assign anim_delay_coeff = 0.025
							endif
						%}
						<div
							class="card-slider__slide swiper-slide"
							style="--info-card-anim-delay: {{ forloop.index | minus: 1 | times: anim_delay_coeff }}s;"
							{{ block.shopify_attributes }}
						>
							{% render 'info-card',
								image: block.settings.image,
								heading: block.settings.heading,
								heading_size: block.settings.heading_size,
								heading_tag: block.settings.heading_tag,
								button_label: block.settings.button_label,
								button_link: block.settings.button_link,
								button_style: section.settings.button_style,
								image_ratio: section.settings.image_ratio,
								image_fit: 'cover',
								forloop: forloop
							%}
						</div>
					{% endfor %}
				</div>
			</div>

			<div class="card-slider__navigation">
				<div class="card-slider__button card-slider__button--prev swiper-button-disabled swiper-button--large">
					{% render 'icon-arrow' %}
				</div>
				<div class="card-slider__button card-slider__button--next swiper-button--large">
					{% render 'icon-arrow' %}
				</div>
			</div>

			<div class="swipe-on-mobile__nav no-js-hidden">
				<div class="card-slider__pagination swiper-pagination"></div>
			</div>

			<div class="js-info-card-hover-effect"></div>
		</div>
	</div>
</div>

