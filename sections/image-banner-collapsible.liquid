{{ 'section-image-banner-collapsible.css' | asset_url | stylesheet_tag }}

<script src="{{ 'collapsible-content.js' | asset_url }}" defer="defer"></script>

{% liquid
	assign section_heading = section.settings.section_heading
	assign section_subheading = section.settings.section_subheading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign pulse_subheading = section.settings.pulse_animation_text
	assign image_size = section.settings.image_size
	assign button_style = section.settings.button_style
	assign button_label = section.settings.button_label
	assign button_link = section.settings.button_link
	assign link_link = section.settings.link_link
	assign link_label = section.settings.link_label
	assign buttons_alignment = section.settings.buttons_alignment

	assign image_size = section.settings.image_size

	case image_size
		when 'adapt'
			assign section_size = 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | append: '%'
			assign slide_class = image_size
		when '1/1'
			assign section_size = '100%'
			assign slide_class = image_size
		when '3/2'
			assign section_size = '60%'
			assign slide_class = image_size
		when '4/3'
			assign section_size = '75%'
			assign slide_class = image_size
		when '16/9'
			assign section_size = '56%'
			assign slide_class = image_size
		when '21/9'
			assign section_size = '42.8%'
			assign slide_class = image_size
		when 'large'
			assign section_size = '100vh'
			assign slide_class = image_size
		else
			assign section_size = 'calc(100vh - var(--header-height) - var(--announcement-height))'
			assign slide_class = image_size
	endcase
%}

{%- style -%}
	 {% render 'section-margin' %}

	#shopify-section-{{ section.id }} .image-banner__overlay {
	  opacity: {{ section.settings.overlay_opacity_mobile }};
	}

	@media screen and (min-width: 990px) {
		#shopify-section-{{ section.id }} .image-banner__overlay {
		 	opacity: {{ section.settings.overlay_opacity }};
		}
	}
{%- endstyle -%}

<div
	class="image-banner-collapsible {{ slide_class }} collapsible-content"
	style="--slide-height: {{ section_size }};"
>
	<div class="container section-{{ section.id }}-padding">
		<div class="image-banner-collapsible-header-content-wrapper">
			{% render 'section-header',
				section_heading: section_heading,
				section_heading_size: section_heading_size,
				section_heading_tag: section_heading_tag,
				section_subheading: section_subheading,
				description: section.settings.section_descr,
				pulse: pulse_subheading
			%}

			<div class="collapsible-content-main-container">
				<div class="collapsible-content__content">
					<div class="collapsible-content__items">
						{%- for block in section.blocks -%}
							<div
								class="collapsible-content__item{% if block.settings.default_open %} active{% endif %}"
								{{ block.shopify_attributes }}
							>
								<button
									class="collapsible-content__toggle focus-inset button--unstyled"
									aria-label="{{ block.settings.question | escape }}"
								>
									<div class="collapsible-content__toggle-group">
										{%- if block.settings.question != blank -%}
											<{{ block.settings.accordion_heading_tag | default: 'h5' }} class="collapsible-content__question h5">
												{{ block.settings.question | escape }}
											</{{ block.settings.accordion_heading_tag | default: 'h5' }}>
										{%- endif -%}
									</div>
									<div class="collapsible-content__icon">
										{% render 'icon-close-faq' %}
										{% render 'icon-plus-faq' %}
									</div>
								</button>

								{%- if block.settings.answer != blank -%}
									<div
										class="collapsible-content__answer"
										{% if block.settings.default_open %}
											style="display: block;"
										{% endif %}
									>
										<div class="collapsible-content__answer-inner richtext__content richtext_custom">
											{{ block.settings.answer }}
										</div>
									</div>
								{%- endif -%}
							</div>
						{%- endfor -%}
					</div>
				</div>

				{%- if link_label != blank or button_label != blank -%}
					<div class="faq-button-container {{ buttons_alignment }}">
						{% render 'button',
							btn_label: button_label,
							btn_link: button_link,
							btn_style: button_style,
							add_classes: 'multicolumn-card__button focus-inset'
						%}
						<span class="richtext_custom">
							<a
								href="{{ link_link }}"
								class="faq-button-container__link"
								aria-label="{{ button_label | escape }}"
							>
								{{ link_label }}
							</a>
						</span>
					</div>
				{%- endif -%}
			</div>
		</div>
	</div>
	<div class="image-banner-collapsible__bg">
		{%- if section.settings.image != blank -%}
			{% assign image_height = section.settings.image.width
				| divided_by: section.settings.image.aspect_ratio
			%}

			{{
				section.settings.image
				| image_url: width: 3840
				| image_tag:
					fetchpriority: 'high',
					loading: 'eager',
					width: section.settings.image.width,
					height: image_height,
					sizes: '100vw (min-width: 767px) 50vw',
					widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
					class: 'jarallax-img'
			}}
		{% else %}
			{{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder' }}
		{%- endif -%}
		<span class="image-banner__overlay"></span>
	</div>
</div>

