{{ 'section-simple-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'simple-cards.js' | asset_url }}" defer="defer"></script>

{% style %}
	{% render 'section-margin' %}
{% endstyle %}

{% liquid
	assign columns_per_row = section.settings.columns_per_row
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_descr = section.settings.section_descr
	assign pulse_subheading = section.settings.pulse_animation_text
	assign swipe_on_mobile = section.settings.swipe_on_mobile
	assign image_ratio = section.settings.image_ratio
%}

<div class="simple-cards" id="simple-cards-section">
	<div class="container">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			description: section_descr,
			pulse: pulse_subheading
		%}
	</div>
	<div class="container simple-media__container">
		<div class="simple-media__wrapper">
			<div class="simple-media-list {% if swipe_on_mobile and section.blocks.size > 1 %}swiper swiper--media{% endif %}">
				<div
					class="simple-media-list__wrapper simple-media-list__wrapper--{{ columns_per_row }} {% if swipe_on_mobile and section.blocks.size > 1 %} swiper-wrapper{% endif %}"
					style="--indent_value: 1.6rem;"
				>
					{%- for block in section.blocks -%}
						<div class="simple-card-container {% if swipe_on_mobile and section.blocks.size > 1 %}swiper-slide{% endif %}">
							{% style %}
										#shopify-section-{{ section.id }} [data-id="{{ block.id }}"].simple-card {
										    {% if image_ratio != 'adapt'  %}
										      --aspect-ratio: {{ image_ratio }};
										    {% elsif image_ratio == 'adapt' and block.settings.image != blank %}
										      --aspect-ratio: {{ block.settings.image.aspect_ratio }};
													{% else %}
								--aspect-ratio: 1;
										    {% endif %}
										  }
							{% endstyle %}
							<div
								class="simple-card {{ image_ratio }}"
								data-id="{{ block.id }}"
								{{ block.shopify_attributes }}
							>
								<div class="simple-card__image">
									{%- capture sizes -%}
                    (min-width: 1100px) calc((100vw - 64px * 2)), calc((100vw - 20px * 2))
                  {%- endcapture -%}

									{%- if block.settings.image != blank -%}
										{{
											block.settings.image
											| image_url: width: block.settings.image.width
											| image_tag:
												loading: 'lazy',
												width: block.settings.image.width,
												height: block.settings.image.height,
												sizes: sizes,
												widths: '360, 535, 720, 940, 1070, 1200, 1500, 1780, 2000, 2400, 2800, 3200'
										}}
									{%- else -%}
										{{
											'product-apparel-2'
											| placeholder_svg_tag: 'placeholder-svg'
										}}
									{%- endif -%}
								</div>
							</div>
							<div class="simple-card__content">
								{%- if block.settings.heading != blank
									or block.settings.text != blank
								-%}
									<div class="simple-card__info">
										{%- if block.settings.heading != blank -%}
											<{{ block.settings.card_heading_tag | default: 'h2' }} class="simple-card__heading {{ block.settings.heading_size }}">
												{{ block.settings.heading | escape }}
											</{{ block.settings.card_heading_tag | default: 'h2' }}>
										{%- endif -%}
										{%- if block.settings.text != blank -%}
											<div class="simple-card__text richtext__content richtext">
												{{ block.settings.text }}
											</div>
										{%- endif -%}
									</div>
								{%- endif -%}
							</div>
						</div>
					{%- endfor -%}
				</div>

				{%- if swipe_on_mobile and section.blocks.size > 1 -%}
					<div class="swipe-on-mobile__nav no-js-hidden">
						<div class="simple-media__pagination swiper-pagination"></div>
					</div>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

