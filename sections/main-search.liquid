{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}
{{ 'template-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
	{{ 'component-facets.css' | asset_url | stylesheet_tag }}
	<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'icon-cancel.js' | asset_url }}" defer="defer"></script>

{%- if settings.quickview_show
	or settings.show_on_mobile
	or settings.type_color_swatch == 'custom'
-%}
	{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{%- if settings.quickview_show or settings.show_on_mobile -%}
	<link
		rel="stylesheet"
		href="{{ 'component-deferred-media.css' | asset_url }}"
		media="all"
	>
	<link
		rel="preload"
		href="{{ 'quick-add.css' | asset_url }}"
		as="style"
		onload="this.onload=null;this.rel='stylesheet'"
	>
{%- endif -%}

{%- liquid
	assign sort_by = search.sort_by | default: search.default_sort_by
	assign terms = search.terms | escape
	assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

<div class="template-search{% if search.performed == true and search.results_count == 0 and terms != blank %} template-search--empty{% endif %}">
	<div class="template-search__header">
		<div class="container">
			<div class="page-header">
				<div class="page-header__inner">
					{%- if search.performed -%}
						<h1 class="main-page-title page-title title--page h2">
							{{ 'templates.search.title' | t }}: {{ terms }}
						</h1>
					{%- else -%}
						<h1 class="main-page-title page-title title--page h2">
							{{ 'general.search.search' | t }}
						</h1>
					{%- endif -%}

					{%- if search.performed
						and search.results_count == 0
						and search.filters == empty
					-%}
						<p class="search__form-text large-font" role="status">
							{{ 'templates.search.no_results' | t: terms: search.terms }}
						</p>
						{% comment %}
							{% elsif search.performed and search.results_count > 0 %}
							<p class="search__form-text large-font" role="status">{{ 'templates.search.results' | t: count: search.results_count }}</p>
						{% endcomment %}
					{%- endif -%}
				</div>
			</div>
			<div class="template-search__search">
				{% comment %}
					{%- if settings.predictive_search_enabled -%}
					  <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
					{%- endif -%}
				{% endcomment %}
				{%- if search.performed
					and search.results_count == 0
					and search.filters == empty
				-%}
					<div class="search-wrapper">
				{% endif %}

				<form
					action="{{ routes.search_url }}"
					method="get"
					role="search"
					class="search"
				>
					<div class="field">
						<button
							class="search__button button focus-inset"
							aria-label="{{ 'general.search.search' | t }}"
						>
							{% render 'icon-search' %}
						</button>
						<input
							dir="ltr"
							class="search__input field__input focus-inset"
							id="Search-In-Template"
							type="search"
							name="q"
							value="{{ search.terms | escape }}"
							placeholder="{{ 'general.search.placeholder' | t }}"
							tabindex="0"
						>
						<label class="visually-hidden" for="Search-In-Template">
							{{- 'general.search.search' | t -}}
						</label>
						<input name="options[prefix]" type="hidden" value="last">

						<div class="search-buttons-wrapper">
							<span
								class="button reset__button field__button"
								aria-label="{{ 'general.search.reset' | t }}"
							>
								{% render 'icon-cancel' %}
							</span>

							<div class="button_wrapper custom-hover">
								<button
									class="search__button--primary button focus-inset"
									aria-label="{{ 'general.search.search' | t }}"
									tabindex="0"
								>
									<div class="button__content">
										<span
											class="button__label"
											data-label="{{- 'general.search.search' | t | escape -}}"
										>
											{{ 'general.search.search' | t }}
										</span>
									</div>
									<span class="button_circle"> </span>
								</button>
							</div>
						</div>
					</div>
					{% comment %}
						{%- if settings.predictive_search_enabled -%}
						  <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
						    <div class="predictive-search__loading-state">
						      {% render 'icon-spinner' %}
						    </div>
						  </div>
						  <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
						{%- endif -%}
					{% endcomment %}
				</form>

				{%- if search.performed
					and search.results_count == 0
					and search.filters == empty
				-%}
					</div>
				{% endif %}
				{% comment %}
					{%- if settings.predictive_search_enabled -%}
					  </predictive-search>
					{%- endif -%}
				{% endcomment %}
			</div>
		</div>
	</div>
	{%- if search.performed -%}
		{% liquid
			assign filter_show = false
			for filter in search.filters
				if filter.range_max != 0
					assign filter_show = true
				endif
			endfor
		%}
		<div class="container">
			<div class="collection-wrapper {% if section.settings.enable_filtering == false and section.settings.enable_sorting == false %} collection-wrapper_no-facets{% endif %}{% if filter_show == false and section.settings.enable_sorting == false %} collection-wrapper_no-facets{% endif %}">
				{%- liquid
					assign show_facets = false

					# Show if sorting is enabled
					if section.settings.enable_sorting
						assign show_facets = true
					endif

					# Show if filtering is enabled AND filters exist
					if section.settings.enable_filtering and search.filters != empty
						assign show_facets = true
					endif
				-%}

				{%- if show_facets -%}
					{% render 'facets',
						results: search,
						enable_filtering: section.settings.enable_filtering,
						enable_sorting: section.settings.enable_sorting,
						filter_type: 'drawer',
						image_filter_ratio: section.settings.image_filter_ratio,
						image_filter_fit: section.settings.image_filter_fit,
						image_filter_columns: section.settings.image_filter_columns
					%}
				{%- endif -%}

				<div
					id="ProductGridContainer"
					class="products-grid{% if section.settings.enable_filtering == false or filter_show == false and section.settings.enable_sorting == false %} products-grid_no-filter{% endif %}"
				>
					{% paginate search.results by 8 %}
						{%- if search.results.size == 0 and search.filters != empty -%}
							<div
								class="template-search__results collection collection-product"
								id="product-grid"
								data-id="{{ section.id }}"
							>
								<div class="loading-overlay">
									<div class="loading-overlay__spinner">
										{% render 'icon-spinner' %}
									</div>
								</div>
								<div class="title-wrapper center title-wrapper-empty">
									<h2 class="title title--primary">
										{{ 'sections.collection_template.empty_results' | t }}
										<br>
										{{
											'sections.collection_template.results_use_fewer_filters_html'
											| t: link: search_url, class: 'underlined-link link'
										}}
									</h2>
								</div>
							</div>
						{%- else -%}
							<div
								class="template-search__results collection collection-product"
								id="product-grid"
								data-id="{{ section.id }}"
							>
								<div class="loading-overlay">
									<div class="loading-overlay__spinner">
										{% render 'icon-spinner' %}
									</div>
								</div>

								{% liquid
									assign search_products = search.results | where: 'object_type', 'product'
									assign search_products_size = search_products | size
									assign search_articles = search.results | where: 'object_type', 'article'
									assign search_articles_size = search_articles | size
									assign search_pages = search.results | where: 'object_type', 'page'
									assign search_pages_size = search_pages | size
								%}

								{% if search_products_size != 0 %}
									<div class="search-results__top first">
										<h3 class="search-results__title h3">
											{{ 'templates.search.item_count.other' | t: count: '' }}
										</h3>
									</div>
									<ul
										class="
											collection-product-list
											collection-product-list--{{ section.settings.columns_mobile }}-mobile
											{% if section.settings.enable_filtering %} collection-results_filters {% endif %}
										"
										role="list"
									>
										{%- for item in search_products -%}
											<li class="collection-product-card template-search__item {% if settings.quickview_hover %}quickview--hover{% endif %}">
												{% render 'product-card',
													product_card_product: item,
													media_size: section.settings.image_ratio,
													media_fit: section.settings.image_fit,
													show_secondary_image: section.settings.show_secondary_image,
													show_vendor: section.settings.show_vendor,
													show_collection: section.settings.show_collection,
													show_desc: section.settings.show_desc,
													content_alignment: 'left'
												%}
											</li>
										{%- endfor -%}
									</ul>
								{% endif %}

								{% if search_articles_size != 0 %}
									<div class="search-results__top {% if search_products_size == 0 %} first {% endif %}">
										<h3 class="search-results__title h3">
											{{
												'templates.search.article_count.other'
												| t: count: ''
											}}
										</h3>
									</div>
									<ul
										class="collection-results collection-results_articles collection-results--{{ section.settings.columns_mobile }}-mobile {% if section.settings.enable_filtering == false or filter_show == false %} collection-results_no-filter {%- endif -%}"
										role="list"
										style="--aspect-ratio: {{ section.settings.blog_image_ratio }};"
									>
										{%- for item in search_articles -%}
											{%- case item.object_type -%}
												{%- when 'article' -%}
													<li class="template-search__item article">
														{% render 'article-card',
															article: item,
															show_image: true,
															show_tags: false,
															show_date: section.settings.article_show_date,
															show_author: section.settings.article_show_author,
															show_excerpt: section.settings.article_show_desc
														%}
													</li>
											{%- endcase -%}
										{%- endfor -%}
									</ul>
								{% endif %}

								{% if search_pages_size != 0 %}
									<div class="search-results__top {% if search_products_size == 0 and search_articles_size == 0 %} first {% endif %}">
										<h3 class="search-results__title h3">
											{{ 'templates.search.page_count.other' | t: count: '' }}
										</h3>
									</div>
									<ul
										class="collection-results collection-results--{{ section.settings.columns_mobile }}-mobile {% if section.settings.enable_filtering == false or filter_show == false %} collection-results_no-filter {%- endif -%}"
										role="list"
									>
										{%- for item in search_pages -%}
											{%- case item.object_type -%}
												{%- when 'page' -%}
													<li class="template-search__item template-search__page">
														<a
															href="{{ item.url }}"
															class="card-page__wrapper"
															aria-label="{{ item.title | truncate: 50 | escape }}"
														>
															<div class="card-page">
																<span class="icon-wrapper">
																	{% render 'icon-page' %}
																</span>
																<div class="card-page__content">
																	<h4 class="card-page__title h4">
																		{{ item.title | truncate: 50 | escape }}
																	</h4>
																</div>
															</div>
														</a>
													</li>
											{%- endcase -%}
										{%- endfor -%}
									</ul>
								{% endif %}
								{%- if paginate.pages > 1 -%}
									{% render 'pagination', paginate: paginate %}
								{%- endif -%}
							</div>
						{%- endif -%}
					{% endpaginate %}
				</div>
			</div>
		</div>
	{%- endif -%}
</div>

{% schema %}
{
	"name": "t:sections.main-search.name",
	"tag": "section",
	"class": "section-search",
	"settings": [
		{
			"type": "header",
			"content": "t:sections.main-search.settings.header__1.content"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "16/9",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "3/4",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "1/1",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "3/4",
			"label": "t:sections.all.card.image_ratio.label"
		},
		{
			"type": "select",
			"id": "image_fit",
			"label": "t:sections.all.card.image_fit.label",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.card.image_fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.card.image_fit.options__2.label"
				}
			],
			"default": "cover"
		},
		{
			"type": "checkbox",
			"id": "show_secondary_image",
			"default": false,
			"label": "t:sections.all.card.show_secondary_image.label"
		},
		{
			"type": "checkbox",
			"id": "show_vendor",
			"default": true,
			"label": "t:sections.all.card.show_vendor.label"
		},
		{
			"type": "checkbox",
			"id": "show_collection",
			"default": false,
			"label": "t:sections.all.card.show_collection.label"
		},
		{
			"type": "checkbox",
			"id": "show_desc",
			"default": false,
			"label": "t:sections.all.card.show_desc.label",
			"info": "t:sections.all.card.show_desc.info"
		},
		{
			"type": "header",
			"content": "t:sections.main-search.settings.header__2.content"
		},
		{
			"type": "select",
			"id": "blog_image_ratio",
			"options": [
				{
					"value": "16/9",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "3/4",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "1/1",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "16/9",
			"label": "t:sections.all.card.image_ratio.label"
		},

		{
			"type": "checkbox",
			"id": "article_show_date",
			"default": true,
			"label": "t:sections.main-search.settings.article_show_date.label"
		},
		{
			"type": "checkbox",
			"id": "article_show_author",
			"default": false,
			"label": "t:sections.main-search.settings.article_show_author.label"
		},
		{
			"type": "checkbox",
			"id": "article_show_desc",
			"default": true,
			"label": "t:sections.main-search.settings.article_show_desc.label"
		},

		{
			"type": "header",
			"content": "t:sections.main-collection-product-grid.settings.header__1.content"
		},
		{
			"type": "checkbox",
			"id": "enable_filtering",
			"default": false,
			"label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
			"info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
		},
		{
			"type": "checkbox",
			"id": "enable_sorting",
			"default": false,
			"label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection-product-grid.settings.image_filter.content"
		},
		{
			"type": "select",
			"id": "image_filter_ratio",
			"options": [
				{
					"value": "3/2",
					"label": "t:sections.all.card.image_ratio.options__1.label"
				},
				{
					"value": "4/5",
					"label": "t:sections.all.card.image_ratio.options__2.label"
				},
				{
					"value": "1/1",
					"label": "t:sections.all.card.image_ratio.options__3.label"
				}
			],
			"default": "4/5",
			"label": "t:sections.all.card.image_ratio.label"
		},
		{
			"type": "select",
			"id": "image_filter_fit",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.card.image_fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.card.image_fit.options__2.label"
				}
			],
			"default": "cover",
			"label": "t:sections.all.card.image_fit.label"
		},
		{
			"type": "range",
			"id": "image_filter_columns",
			"min": 1,
			"max": 5,
			"step": 1,
			"default": 2,
			"label": "t:sections.main-collection-product-grid.settings.image_filter_columns.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection-product-grid.settings.header_mobile.content"
		},
		{
			"type": "select",
			"id": "columns_mobile",
			"default": "2",
			"label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
			"options": [
				{
					"value": "1",
					"label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
				},
				{
					"value": "2",
					"label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
				}
			]
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "l",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	]
}
{% endschema %}
