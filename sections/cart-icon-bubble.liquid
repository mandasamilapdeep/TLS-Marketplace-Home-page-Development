<div class="{% if request.page_type != 'cart' %}header__cart {% else %} header__cart--page{% endif %}">
	<a
		href="{{ routes.cart_url }}"
		class="header__icon header__icon--cart {% if cart.item_count > 0 %}header__cart-has-items{% endif %} link link--text focus-inset"
		id="cart-icon-bubble"
		aria-label="{{ 'general.cart.view' | t }}"
	>
		{%- liquid
			render 'icon-cart'
		-%}
		<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
		{%- if cart != empty -%}
			<div class="cart-count-bubble {% if cart.item_count >= 100 %} cart-count-bubble-very-long{% endif %}">
				{%- if cart.item_count < 100 -%}
					<span aria-hidden="true">{{ cart.item_count }}</span>
				{%- else -%}
					<span class="cart-count-bubble-very-long-number" aria-hidden="true"
						>99+</span
					>
				{%- endif -%}
				<span class="visually-hidden">
					{{- 'sections.header.cart_count' | t: count: cart.item_count -}}
				</span>
			</div>
		{%- endif -%}
	</a>
</div>
