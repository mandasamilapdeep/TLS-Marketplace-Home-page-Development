{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'component-main-product-info.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-product.css' | asset_url | stylesheet_tag }}
{{
	'component-card.css'
	| asset_url
	| stylesheet_tag: preload: true, deferred: true
}}
{{
	'section-product-recommendations.css'
	| asset_url
	| stylesheet_tag: preload: true, deferred: true
}}

{%- style -%}
	{% render 'section-margin' %}
	{% render 'section-padding' %}
{%- endstyle -%}

{% liquid
	assign quickview_show = settings.quickview_show
	assign show_on_mobile = settings.show_on_mobile
	assign enable_vendor_link = settings.enable_vendor_link
	assign badge_soldout_show = settings.badge_soldout_show
	assign badge_sale_show = settings.badge_sale_show
	assign badge_sale_type = settings.badge_sale_type
	assign badge_custom_show = settings.badge_custom_show
	assign product = section.settings.product_item
%}

{%- if quickview_show or show_on_mobile -%}
	{{
		'quick-add.css'
		| asset_url
		| stylesheet_tag: preload: true, deferred: true
	}}
{%- endif -%}

{%- assign first_3d_model = product.media
	| where: 'media_type', 'model'
	| first
-%}
{%- if first_3d_model -%}
	{{ 'component-product-model.css' | asset_url | stylesheet_tag }}
	<link
		id="ModelViewerStyle"
		rel="stylesheet"
		href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
		media="print"
		onload="this.media='all'"
	>
	<link
		id="ModelViewerOverride"
		rel="stylesheet"
		href="{{ 'component-model-viewer-ui.css' | asset_url }}"
		media="print"
		onload="this.media='all'"
	>
	<script type="application/json" id="ProductJSON-{{ product.id }}">
		{{ product.media | where: 'media_type', 'model' | json }}
	</script>
	<script src="{{ 'product-model.js' | asset_url }}" defer></script>
{%- endif -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'copy.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'update-slider.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'main-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'main-product-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'lava-lamp.js' | asset_url }}" defer="defer"></script>

{% liquid
	assign product_outer_classes = 'product__outer'
	assign product_outer_classes = product_outer_classes | append: ' product__outer--thumbs-aside'
	assign product_media_class = 'product--no-media'
	assign desktop_alignment = 'left'
	assign mobile_alignment = 'before'
	assign title = section.settings.title
	assign heading_size = section.settings.heading_size
	assign heading_tag = section.settings.heading_tag
	assign subtitle = section.settings.subtitle
	assign pulse_animation_text = section.settings.pulse_animation_text

	if desktop_alignment == 'right'
		assign product_outer_classes = product_outer_classes | append: ' product__outer--desktop-order'
	endif

	if mobile_alignment == 'after'
		assign product_outer_classes = product_outer_classes | append: ' product__outer--mobile-order'
	endif

	if product.media.size > 0
		assign product_media_class = 'row'
	endif
%}

<section
	id="MainProduct-{{ section.id }}"
	class="main-product section-{{ section.id }}-padding"
	data-section="{{ section.id }}"
>
	<div class="product {{ product_media_class }} container">
		{% render 'section-header',
			section_heading: title,
			section_heading_size: heading_size,
			section_heading_tag: heading_tag,
			section_subheading: subtitle,
			description: '',
			content_alignment: 'left',
			pulse: pulse_animation_text
		%}
		<div class="{{ product_outer_classes }}">
			{% render 'main-product-media', product: product, section: section %}

			<div
				id="ProductInfo-{{ section.id }}"
				data-section="{{ section.id }}"
				class="product__info-container"
			>
				<div class="product__info-container--col without-buy-box">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when 'vendor_name' -%}
								{% render 'main-product-info-vendor-name',
									text: block.settings.text,
									vendor: product.vendor,
									enable_vendor_link: enable_vendor_link,
									shopify_attributes: block.shopify_attributes
								%}
							{%- when 'product_title' -%}
								{% render 'main-product-info-heading',
									badges_type: block.settings.badges_type,
									badge_soldout_show: badge_soldout_show,
									shopify_attributes: block.shopify_attributes,
									product_title: product.title,
									product_available: product.available,
									badge_sale_show: badge_sale_show,
									badges_color: 'background-1',
									compare_at_price: product.compare_at_price,
									product_price: product.price,
									badge_sale_type: badge_sale_type,
									badge_custom_show: false,
									product_metafields: product.metafields,
									show_badges: block.settings.show_badges,
									heading_tag: block.settings.section_heading_tag
								%}
							{%- when 'short_description' -%}
								{% assign long_description_link = product.url
									| append: '#description'
								%}
								{% render 'main-product-short-description',
									shopify_attributes: block.shopify_attributes,
									show_read_more: true,
									long_description_link: long_description_link,
									product: product
								%}
							{%- when 'variant_picker' -%}
								<div class="product-parameters">
									{% unless product.has_only_default_variant %}
										{% if block.settings.picker_type == 'button' %}
											{% comment %}---------------------------- -------------- ---------------------------{% endcomment %}
											{% comment %}---------------------------- VARIANT RADIOS ---------------------------{% endcomment %}
											{% comment %}---------------------------- -------------- ---------------------------{% endcomment %}
											<variant-radios
												id="variant-radios-{{ section.id }}"
												class="no-js-hidden"
												role="radiogroup"
												aria-labelledby="VariantGroupLabel-{{ section.id }}"
												data-section="{{ section.id }}"
												data-url="{{ product.url }}"
												data-update-url="false"
												{{ block.shopify_attributes }}
											>
												{%- for option in product.options_with_values -%}
													{% liquid
														assign color_trigger = settings.trigger_swatch | append: '<br />' | append: settings.trigger_swatch_other | strip | newline_to_br | split: '<br />'
														assign name_option = option.name | handle | strip

														# check is color option or not
														assign is_color_option = false
														# for custom swatch type
														if settings.type_color_swatch == 'custom'
															for item in color_trigger
																assign item_temp = item | handle | strip
																if name_option == item_temp
																	assign is_color_option = true
																endif
															endfor
														endif

														# for standart swatch type
														if settings.type_color_swatch == 'standart'
															for value in option.values
																if value.swatch.color != blank
																	assign is_color_option = true
																endif
															endfor
														endif
													%}

													<fieldset
														class="product-form__controls{% if is_color_option %} product-form__controls--colors{% endif %}"
														id="SingleOptionSelector-{{ forloop.index0 }}"
													>
														<div class="product-form__group-wrapper">
															<legend
																id="VariantGroupLabel-{{ section.id }}-{{ forloop.index0 }}"
																class="product-form__group-name"
															>
																{{ option.name }}:
																<span class="selected-value">
																	{{- option.selected_value -}}
																</span>
															</legend>
															<div class="product-form__controls-group">
																{% render 'product-variant-options',
																	product: product,
																	option: option,
																	block: block,
																	show_color_swatch: is_color_option
																%}
															</div>
														</div>
													</fieldset>
												{%- endfor -%}

												<script type="application/json">
													{{ product.variants | json }}
												</script>
											</variant-radios>
										{% else %}
											{% render 'main-product-variant-selects',
												section: section,
												settings: settings,
												product: product,
												block: block,
												show_swatches: block.settings.show_swatches
											%}
										{% endif %}
									{% endunless %}
								</div>
						{%- endcase -%}
					{%- endfor -%}

					{% if product != blank %}
						<a
							href="{{ product.url }}"
							class="view-full-details__link animated-link__underline--reverse"
							aria-label="{{ product.title | escape }}"
						>
							{{ 'products.product.view_full_details' | t }}
						</a>
					{% endif %}
				</div>

				<div class="product__info-container--col">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when 'buy_box' -%}
								{% comment %}
									{% render 'buy-box',
										block: block,
										product: product,
										section: section
									%}
								{% endcomment %}

								{% comment %}---------------------------- ------- ---------------------------{% endcomment %}
								{% comment %}---------------------------- BUY BOX ---------------------------{% endcomment %}
								{% comment %}---------------------------- ------- ---------------------------{% endcomment %}

								{% liquid
									assign product_form_id = 'product-form-' | append: section.id
									assign variant = product.selected_or_first_available_variant
									assign show_discount_badge = false

									if variant.compare_at_price > variant.price and block.settings.show_discount
										assign show_discount_badge = true
									endif

									assign class_is_showed_discount_badge = ''
									if show_discount_badge or block.settings.show_tax_info or block.settings.show_shipping
										assign class_is_showed_discount_badge = 'is-showed-discount-badge'
									endif
								%}

								{% if variant != blank %}
									<div class="buy-box__wrapper">
										<div class="buy-box container {{ class_is_showed_discount_badge }}">
											<div class="buy-box-price-wrapper">
												<div
													class="no-js-hidden price-wrapper"
													id="price-{{ section.id }}"
													{{ block.shopify_attributes }}
												>
													{%- render 'price',
														product: product,
														use_variant: true,
														show_badges: false,
														price_class: 'price--product'
													-%}

													{% if show_discount_badge %}
														<div class="badge discount-badge">
															<span class="discount-text">
																-
																{{-
																	variant.compare_at_price
																	| minus: variant.price
																	| times: 100.0
																	| divided_by: variant.compare_at_price
																	| round
																-}}
																%
															</span>
														</div>
													{% endif %}
												</div>

												{% if block.settings.show_tax_info
													or block.settings.show_shipping
												%}
													<div class="product__tax">
														{%- if cart.taxes_included
															and block.settings.show_tax_info
														-%}
															{{ 'products.product.include_taxes' | t }}
														{%- endif -%}
														{%- if shop.shipping_policy.body != blank
															and block.settings.show_shipping
														-%}
															{{
																'products.product.shipping_policy_html'
																| t: link: shop.shipping_policy.url
															}}
														{%- endif -%}
													</div>
												{% endif %}

												<div
													class="installment-wrapper"
													{{ block.shopify_attributes }}
												>
													{%- assign product_form_installment_id = 'product-form-installment-'
														| append: section.id
													-%}
													{%- form 'product',
														product,
														id: product_form_installment_id,
														class: 'installment caption-large'
													-%}
														<input
															type="hidden"
															name="id"
															value="{{ product.selected_or_first_available_variant.id }}"
														>
														{{ form | payment_terms }}
													{%- endform -%}
												</div>
											</div>

											<div
												class="product__buy-buttons"
												{{ block.shopify_attributes }}
											>
												{%- liquid
													assign gift_card_recipient_feature_active = false
													if block.settings.show_gift_card_recipient and product.gift_card?
														assign gift_card_recipient_feature_active = true
													endif

													assign show_dynamic_checkout = false
													if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
														assign show_dynamic_checkout = true
													endif
												-%}

												<product-form
													class="product-form"
													role="form"
													aria-describedby="product-form-instructions-{{ section.id }}"
													data-hide-errors="{{ gift_card_recipient_feature_active }}"
												>
													<div
														class="product-form__error-message-wrapper"
														role="alert"
														id="product-form-instructions-{{ section.id }}"
														class="visually-hidden"
														hidden
													>
														{%- render 'icon-error' -%}
														<span class="product-form__error-message"></span>
													</div>
													{%- form 'product',
														product,
														id: product_form_id,
														class: 'form',
														novalidate: 'novalidate',
														data-type: 'add-to-cart-form'
													-%}
														<input
															type="hidden"
															name="id"
															value="{{ product.selected_or_first_available_variant.id }}"
															{% if product.selected_or_first_available_variant.available
																	== false
															%}
																disabled
															{% endif %}
														>

														{%- if gift_card_recipient_feature_active -%}
															{%- render 'gift-card-recipient-form',
																product: product,
																form: form,
																section: section
															-%}
														{%- endif -%}

														<div class="product-form__buttons">
															<div class="product-form__buttons-row">
																{% if block.settings.show_quantity %}
																	<div
																		class="product-form__input product-form__quantity no-js-hidden"
																		{{ block.shopify_attributes }}
																	>
																		{%- assign cart_qty = cart
																			| item_count_for_variant: product.selected_or_first_available_variant.id
																		-%}
																		<quantity-input class="quantity">
																			<button
																				class="quantity__button quantity__button--minus no-js-hidden focus-inset "
																				name="minus"
																				type="button"
																				tabindex="0"
																			>
																				<span class="visually-hidden">
																					{{-
																						'products.product.quantity.decrease'
																						| t: product: product.title
																						| escape
																					-}}
																				</span>
																				{% render 'icon-minus' %}
																			</button>
																			<input
																				dir="ltr"
																				class="quantity__input focus-inset"
																				type="number"
																				name="quantity"
																				id="Quantity-{{ section.id }}"
																				data-cart-quantity="{{ cart_qty }}"
																				data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
																				min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
																				{% if product.selected_or_first_available_variant.quantity_rule.max
																						!= null
																				%}
																					data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
																					max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
																				{% endif %}
																				step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
																				value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
																				form="{{ product_form_id }}"
																				tabindex="0"
																			>
																			<label
																				class="visually-hidden"
																				for="Quantity-{{ section.id }}"
																			>
																				{{
																					'products.product.quantity.label'
																					| t
																				}}
																			</label>
																			<button
																				class="quantity__button quantity__button--plus no-js-hidden focus-inset"
																				name="plus"
																				type="button"
																				tabindex="0"
																			>
																				<span class="visually-hidden">
																					{{-
																						'products.product.quantity.increase'
																						| t: product: product.title
																						| escape
																					-}}
																				</span>
																				{% render 'icon-plus' %}
																			</button>
																		</quantity-input>
																		<div class="quantity__rules caption">
																			{%- if product.selected_or_first_available_variant.quantity_rule.increment
																					> 1
																			-%}
																				<span class="divider">
																					{{-
																						'products.product.quantity.multiples_of'
																						| t:
																							quantity: product.selected_or_first_available_variant.quantity_rule.increment
																					-}}
																				</span>
																			{%- endif -%}
																			{%- if product.selected_or_first_available_variant.quantity_rule.min
																					> 1
																			-%}
																				<span class="divider">
																					{{-
																						'products.product.quantity.minimum_of'
																						| t:
																							quantity: product.selected_or_first_available_variant.quantity_rule.min
																					-}}
																				</span>
																			{%- endif -%}
																			{%- if product.selected_or_first_available_variant.quantity_rule.max
																					!= null
																			-%}
																				<span class="divider">
																					{{-
																						'products.product.quantity.maximum_of'
																						| t:
																							quantity: product.selected_or_first_available_variant.quantity_rule.max
																					-}}
																				</span>
																			{%- endif -%}
																		</div>
																	</div>
																{% endif %}
																<div class="button_wrapper {% if show_dynamic_checkout == false %}custom-hover{% endif %}">
																	<button
																		type="submit"
																		name="add"
																		tabindex="0"
																		class="product-form__submit kk button button--{% if show_dynamic_checkout %}secondary {% else %}primary {% endif %} "
																		aria-label="{{ 'products.product.add_to_cart' | t }} {{ product.title | escape }}"
																		{% if product.selected_or_first_available_variant.available
																				== false
																		%}
																			disabled
																		{% else %}
																			data-button-text="{{ 'products.product.add_to_cart' | t }}"
																		{% endif %}
																	>
																		{%- if product.selected_or_first_available_variant.available -%}
																			<div class="button__content">
																				<span
																					class="button__label"
																					data-label="{{- 'products.product.add_to_cart' | t | escape -}}"
																				>
																					{{
																						'products.product.add_to_cart'
																						| t
																					}}
																				</span>
																			</div>
																		{%- else -%}
																			<div class="button__content">
																				<span
																					class="button__label"
																					data-label="{{- 'products.product.sold_out' | t | escape -}}"
																				>
																					{{ 'products.product.sold_out' | t }}
																				</span>
																			</div>
																		{%- endif -%}
																		<div class="loading-overlay__spinner hidden">
																			{%- render 'icon-spinner' -%}
																		</div>
																		{% if show_dynamic_checkout == false %}
																			<span class="button_circle"> </span>
																		{% endif %}
																	</button>
																</div>
															</div>
															{%- if show_dynamic_checkout -%}
																<div
																	class="product-form__checkout no-js-hidden"
																	style="{% if product.selected_or_first_available_variant.available == false %} opacity: 0.5; pointer-events: none;{% endif %}"
																	{% if product.selected_or_first_available_variant.available
																			== false
																	%}
																		aria-disabled="true"
																	{% endif %}
																	tabindex="0"
																>
																	{{ form | payment_button }}
																</div>
															{%- endif -%}
														</div>
													{%- endform -%}
												</product-form>
											</div>
										</div>
									</div>
								{% else %}
									<div class="buy-box__wrapper">
										<div class="buy-box product-form__buttons">
											{%- render 'price',
												product: product,
												use_variant: true,
												show_badges: false,
												price_class: 'price--product'
											-%}
											<div class="product-form__buttons-row">
												{% if block.settings.show_quantity %}
													<div class="product-form__input product-form__quantity no-js-hidden">
														{%- assign cart_qty = 1 -%}
														<div class="quantity">
															<button
																class="quantity__button no-js-hidden disabled"
																name="minus"
																type="button"
																tabindex="0"
																disabled
															>
																<span class="visually-hidden">
																	{{-
																		'products.product.quantity.increase'
																		| escape
																	-}}
																</span>
																{% render 'icon-minus' %}
															</button>
															<div
																class="quantity__input"
																style="display: flex; align-items: center; justify-content: center;"
															>
																1
															</div>
															<button
																class="quantity__button no-js-hidden disabled"
																name="plus"
																type="button"
																tabindex="0"
																disabled
															>
																<span class="visually-hidden">
																	{{-
																		'products.product.quantity.increase'
																		| t: product: product.title
																		| escape
																	-}}
																</span>
																{% render 'icon-plus' %}
															</button>
														</div>
													</div>
												{% endif %}
												<div class="button_wrapper custom-hover">
													<button
														type="submit"
														name="add"
														class="product-form__submit mlnj button button--{% if show_dynamic_checkout %}secondary {% else %}primary {% endif %} button--primary-size"
														disabled
														tabindex="0"
														aria-label="{{ 'products.product.add_to_cart' | t }} {{ product.title | escape }}"
													>
														<div class="button__content">
															<span>
																{{ 'products.product.add_to_cart' | t }}
															</span>
														</div>
														<span class="button_circle"> </span>
													</button>
												</div>
											</div>
										</div>
									</div>
								{% endif %}
							{%- when 'countdown' -%}
								<div class="main-product__countdown">
									{% if block.settings.contdown_heading != blank %}
										<p class="main-product__countdown--heading h5">
											{{ block.settings.contdown_heading }}
										</p>
									{% endif %}
									{% render 'countdown',
										id: section.id,
										section_settings: block.settings,
										with_bg: true,
										countdown_heading: block.settings.text_after_countdown,
										enable_mock_timer: block.settings.enable_mock_timer,
										mock_date_picker_day: block.settings.mock_date_picker_day,
										mock_date_picker_hours: block.settings.mock_date_picker_hours
									%}
								</div>
							{%- when 'inventory' -%}
								{% render 'main-product-inventory',
									block: block,
									product: product
								%}
							{%- when 'pickup_availability' -%}
								{% render 'main-product-pickup-availability',
									block: block,
									shop: shop,
									product: product
								%}
							{% when 'express_shipping' %}
								{% render 'main-product-express-shipping', block: block %}
						{%- endcase -%}
					{%- endfor -%}
				</div>
			</div>
		</div>
	</div>

	{% render 'main-product-modal', product: product, section: section %}
</section>

