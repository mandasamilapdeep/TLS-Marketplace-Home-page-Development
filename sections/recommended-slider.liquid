{{ 'section-recommended-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'recommended-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-margin' %}
	{%- assign overlay_opacity = section.settings.overlay_opacity -%}

	  #shopify-section-{{ section.id }} .recommended-slider__content .recommended-slider__overlay {
	    opacity: {{ section.settings.overlay_opacity_mobile }};
	  }

		@media screen and (min-width: 990px) {
			 #shopify-section-{{ section.id }} .recommended-slider__content .recommended-slider__overlay {
				opacity: {{ section.settings.overlay_opacity }};
			}
		}

		[data-id="shopify-section-{{ section.id }}"] {
	     {% if section.settings.columns_per_row > 2 %}
	       --columns-per-row: 2;
	     {% else %}
	       --columns-per-row: {{ section.settings.columns_per_row | default: 2 }};
	     {% endif %}
	     @media screen and (min-width: 990px) {
	       {% if section.settings.columns_per_row > 3 %}
	         --columns-per-row: 3;
	       {% else %}
	         --columns-per-row: {{ section.settings.columns_per_row | default: 3 }};
	       {% endif %}
	     }
	     @media screen and (min-width: 1360px) {
	       --columns-per-row: {{ section.settings.columns_per_row | default: 3 }};
	     }
	   }
{%- endstyle -%}

{% liquid
	assign slideshow_speed = section.settings.slideshow_speed
	assign autoplay = section.settings.is_autoplay
	assign stop_autoplay = section.settings.stop_autoplay
	assign slideshow_delay = section.settings.slideshow_delay
%}

<div
	class="recommended-slider"
	data-id="shopify-section-{{ section.id }}"
	data-autoplay="{{ autoplay }}"
	data-stop-autoplay="{{ stop_autoplay }}"
	data-speed="{{ slideshow_speed }}"
	data-delay="{{ slideshow_delay }}"
	data-per-row="{{ section.settings.columns_per_row }}"
>
	<div class="container">
		<div class="recommended-slider__wrapper">
			<div class="recommended-slider__content">
				<div class="recommended-slider__content_text {% if section.settings.image != blank and overlay_opacity != 1 %} slider-has-image{% endif %}">
					{% if section.settings.subheading != blank %}
						<span class="recommended-slider__content_subtitle subtitle {% if section.settings.pulse_animation_text == true %} subtitle_dot {% endif %}">
							{{- section.settings.subheading -}}
						</span>
					{% endif %}
					{% if section.settings.heading != blank %}
						<{{ section.settings.heading_tag | default: 'h2' }} class="recommended-slider__content_heading {{ section.settings.heading_size }}">
							{{ section.settings.heading }}
						</{{ section.settings.heading_tag | default: 'h2' }}>
					{% endif %}
					{% if section.settings.descr != blank %}
						<p class="recommended-slider__content_descr large-font">
							{{ section.settings.descr }}
						</p>
					{% endif %}
				</div>
				<div class="recommended-slider__content_author">
					{% if section.settings.author_image != blank %}
						<div class="recommended-slider__content_img {% if section.settings.image_in_circle %}image-in-circle{% endif %}">
							{%- assign widths = '360, 535, 720, 940, 1070, 1200, 1500, 1780, 2000, 2400, 2800, 3200' -%}
							{%- capture sizes -%}
								(min-width: 1100px) calc((100vw - 128px)), calc((100vw - 40px))
								{%- endcapture -%}
							{{
								section.settings.author_image
								| image_url: width: section.settings.author_image.width
								| image_tag: loading: 'lazy', sizes: sizes, widths: widths
							}}
						</div>
					{% endif %}
					{% if section.settings.author_name != blank
						or section.settings.author_position != blank
					%}
						<div class="recommended-slider__content_info">
							{% if section.settings.author_name != blank %}
								<span class="recommended-slider__content_author-name richtext_custom">
									{{ section.settings.author_name }}
								</span>
							{% endif %}
							{% if section.settings.author_position != blank %}
								<span class="recommended-slider__content_author-position ">
									{{- section.settings.author_position -}}
								</span>
							{% endif %}
						</div>
					{% endif %}
				</div>
				<div class="recommended-slider__content_image">
					{%- if section.settings.image != blank -%}
						{%- capture sizes -%}
							(min-width: 1100px) calc((50vw - 64px)), calc((100vw - 40px))
						{%- endcapture -%}
						{%- assign widths = '360, 535, 720, 940, 1070, 1200, 1400, 1600' -%}
						{{
							section.settings.image
							| image_url: width: section.settings.image.width
							| image_tag: loading: 'lazy', sizes: sizes, widths: widths
						}}
					{%- endif -%}
					<span class="recommended-slider__overlay"></span>
				</div>
			</div>
			<div class="recommended-slider__slider">
				<div class="swiper">
					<div class="swiper-wrapper">
						{% if section.settings.product_list != blank %}
							{% for product in section.settings.product_list %}
								<div class="recommended-slider__item collection-product-card quickview{%- if settings.quickview_hover -%}--hover{% endif %} swiper-slide">
									{% render 'product-card',
										product_card_product: product,
										media_size: section.settings.image_ratio,
										media_fit: section.settings.image_fit,
										show_secondary_image: section.settings.show_secondary_image,
										show_vendor: section.settings.show_vendor,
										show_collection: section.settings.show_collection,
										show_desc: section.settings.show_desc,
										section_id: section.id,
										columns: 4,
										add_id: forloop.index,
										content_alignment: 'left',
										show_swatches: section.settings.show_swatches,
										heading_tag: section.settings.product_heading_tag
									%}
								</div>
							{% endfor %}
						{%- else -%}
							{%- for i in (1..3) -%}
								<div class="recommended-slider__item collection-popular-card collection-popular-card--placeholder swiper-slide">
									{% render 'product-card-placeholder',
										media_size: section.settings.image_ratio,
										content_alignment: 'left',
										product_index: forloop.index,
										heading_tag: section.settings.product_heading_tag
									%}
								</div>
							{%- endfor -%}
						{% endif %}
					</div>
					<div class="swipe-on-mobile__nav no-js-hidden">
						<div class="recommended-slider__pagination swiper-pagination"></div>
					</div>
				</div>
				<div
					class="swiper-button swiper-button-prev"
					data-slider-id="{{ section.id }}"
				>
					<span>{% render 'icon-arrow' %}</span>
				</div>
				<div
					class="swiper-button swiper-button-next"
					data-slider-id="{{ section.id }}"
				>
					<span>{% render 'icon-arrow' %}</span>
				</div>

				<script>
					(function () {
						function adjustButtonPosition(height) {
							document
								.querySelectorAll(
									`#shopify-section-{{ section.id }} .swiper-button`,
								)
								.forEach((button) => {
									button.style.top = height / 2 + 'px';
								});
						}

						function changePosition() {
							if (window.innerWidth < 750) return;

							const image = document.querySelector(
								`#shopify-section-{{ section.id }} .img_tag`,
							);

							if (image) {
								if (image.tagName === 'IMG') {
									if (image.complete) {
										adjustButtonPosition(image.offsetHeight);
									} else {
										image.addEventListener('load', function () {
											adjustButtonPosition(this.offsetHeight);
										});
									}
								} else if (image.tagName === 'svg') {
									const height = image.getBoundingClientRect().height;
									adjustButtonPosition(height);
								}
							}
						}

						changePosition();

						document.addEventListener('shopify:section:load', changePosition);

						let resizeTimeout;
						window.addEventListener('resize', function () {
							clearTimeout(resizeTimeout);
							resizeTimeout = setTimeout(changePosition, 500);
						});
					})();
				</script>
			</div>
		</div>
	</div>
</div>

