{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{{- 'component-rte.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'copy.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign post_limit = section.settings.post_limit
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
%}

<article
	class="article-template"
	itemscope
	itemtype="http://schema.org/BlogPosting"
>
	{% if section.settings.layout == 'overlay' %}
		{%- for block in section.blocks -%}
			{%- case block.type -%}
				{%- when 'article-header' -%}
					<header
						class="article-template__block article-template__block-overlay container article-template__header"
						style="--article_header_overlay_opacity: {{ block.settings.article_header_overlay_opacity }};"
						{{ block.shopify_attributes }}
					>
						<div class="article-template__header-image-wrapper 1">
							<a
								href="{{ block.settings.header_button_link }}"
								class="article-template__header__link-overlay"
								aria-label="{{ block.settings.header_button_label }}"
							></a>
							<div
								class="article-template__header-image"
								style="--aspect-ratio: {% if block.settings.header_show_image and article.image != blank %}{% if block.settings.article_image_ratio == 'adapt' %}{{ article.image.aspect_ratio }}{% else %}{{ block.settings.article_image_ratio }}{% endif %}{% endif %};"
							>
								<div class="article-template__header-wrapper">
									{%- if block.settings.header_show_tags
										or block.settings.header_show_date
										or block.settings.header_show_author
										or block.settings.header_button_label != blank
									-%}
										<div class="article-template__header-meta">
											{% render 'button',
												btn_label: block.settings.header_button_label,
												btn_link: block.settings.header_button_link,
												btn_style: block.settings.header_button_style
											%}
											{%- if block.settings.header_show_tags
												and article.tags != blank
											-%}
												<div class="article-template__tags small-font">
													{% for tag in article.tags %}
														<div class="article-template__tag">
															<a href="{{ blog.url }}/tagged/{{ tag | handle }}">
																<span title="{{ tag }}">
																	{{- tag }}
																</span>
															</a>
														</div>
														{% if forloop.last == false %}
															<span class="article-template__tags-separator">
																|
															</span>
														{% endif %}
													{% endfor %}
												</div>
											{%- endif -%}
											{%- if block.settings.header_show_date
												or block.settings.header_show_author
											-%}
												<div class="article-template__header-info small-font">
													{%- if block.settings.header_show_author -%}
														<div class="article-template__author">
															<span>
																{{- 'general.blog.author' | t -}}
															</span>
															<span>
																{{- article.author -}}
															</span>
														</div>
													{%- endif -%}
													{%- if block.settings.header_show_date -%}
														<span class="article-template__date">
															{{-
																article.published_at
																| date: '%b / %d / %Y'
															-}}
														</span>
													{%- endif -%}
												</div>
											{%- endif -%}
										</div>
									{%- endif -%}
									<div
										style="margin-top: auto;"
									>
										<h1
											class="article-template__header-title {{ block.settings.article_heading_size }}"
											id="Article-{{ article.id }}"
										>
											{{ article.title | escape }}
										</h1>
										{%- if block.settings.header_show_excerpt
											and article.excerpt.size > 0
										-%}
											<p class="article-template__excerpt">
												{{ article.excerpt }}
											</p>
										{%- endif -%}
									</div>

									<a
										href="{{ block.settings.header_button_link }}"
										class="article-template__header__link-overlay"
										aria-label="{{ block.settings.header_button_label }}"
									></a>
								</div>
								{% if block.settings.header_show_image
									and article.image != blank
								%}
									{{
										article.image
										| image_url: width: article.image.width
										| image_tag:
											loading: 'lazy',
											sizes: '100vw',
											widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
									}}
								{% endif %}
							</div>
						</div>
					</header>
			{%- endcase -%}
		{%- endfor -%}
	{% endif %}
	<div class="article-blocks-wrapper container">
		<div
			class="
																												article-blocks-wrapper-left {% if section.settings.popular_image != blank	or section.settings.blog != blank	and section.settings.blog.articles_count > 0 %} has-popular-section {% else %} centered{% endif %}
			"
		>
			{%- for block in section.blocks -%}
				{%- case block.type -%}
					{%- when '@app' -%}
						<div
							class="container page-width--narrow"
							{{ block.shopify_attributes }}
						>
							{% render block %}
						</div>
					{%- when 'article-header' -%}
						{% if section.settings.layout == 'standard' %}
							<header
								class="article-template__block article-template__header"
								{{ block.shopify_attributes }}
								style="--article_header_overlay_opacity: {{ block.settings.article_header_overlay_opacity }};"
							>
								<div class=" article-template__header-wrapper 2">
									{%- if block.settings.header_show_tags
										or block.settings.header_show_date
										or block.settings.header_show_author
										or block.settings.header_button_label != blank
									-%}
										<div class="article-template__header-meta">
											{% render 'button',
												btn_label: block.settings.header_button_label,
												btn_link: block.settings.header_button_link,
												btn_style: block.settings.header_button_style
											%}
											{%- if block.settings.header_show_tags
												and article.tags != blank
											-%}
												<div class="article-template__tags small-font">
													{% for tag in article.tags %}
														<div class="article-template__tag">
															<a href="{{ blog.url }}/tagged/{{ tag | handle }}">
																<span title="{{ tag }}">
																	{{- tag }}
																</span>
															</a>
														</div>
														{% if forloop.last == false %}
															<span class="article-template__tags-separator">
																|
															</span>
														{% endif %}
													{% endfor %}
												</div>
											{%- endif -%}
											{%- if block.settings.header_show_date
												or block.settings.header_show_author
											-%}
												<div class="article-template__header-info small-font">
													{%- if block.settings.header_show_author -%}
														<div class="article-template__author">
															<span>
																{{- 'general.blog.author' | t -}}
															</span>
															<span>
																{{- article.author -}}
															</span>
														</div>
													{%- endif -%}
													{%- if block.settings.header_show_date -%}
														<span class="article-template__date">
															{{-
																article.published_at
																| date: '%b / %d / %Y'
															-}}
														</span>
													{%- endif -%}
												</div>
											{%- endif -%}
										</div>
									{%- endif -%}
									<h1
										class="article-template__header-title {{ block.settings.article_heading_size }}"
										id="Article-{{ article.id }}"
									>
										{{ article.title | escape }}
									</h1>
									{%- if block.settings.header_show_excerpt
										and article.excerpt.size > 0
									-%}
										<p class="article-template__excerpt">
											{{ article.excerpt }}
										</p>
									{%- endif -%}
								</div>
								{% if block.settings.header_show_image
									and article.image != blank
								%}
									{%- liquid
										if block.settings.article_image_ratio == 'adapt'
											assign aspect_ratio = article.image.aspect_ratio
										else
											assign aspect_ratio = block.settings.article_image_ratio
										endif
									-%}
									<div class=" article-template__header-image-wrapper">
										<a
											href="{{ block.settings.header_button_link }}"
											class="article-template__header__link-overlay"
											aria-label="{{ block.settings.header_button_label }}"
										></a>
										<div
											class="article-template__header-image"
											style="--aspect-ratio: {{aspect_ratio}};"
										>
											{{
												article.image
												| image_url: width: article.image.width
												| image_tag:
													loading: 'lazy',
													sizes: '100vw',
													widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
											}}
										</div>
									</div>
								{% endif %}
							</header>
						{% endif %}
					{%- when 'content' -%}
						<div
							class="article-template__block article-template__content"
							itemprop="articleBody"
							{{ block.shopify_attributes }}
						>
							<div class="article-template__content-wrapper">
								<div class="article-template__content-rte rte {% if settings.rte_style == "custom" %}custom_rte custom_blog_post_rte{% endif %}">
									{{ article.content }}
								</div>
							</div>
						</div>
					{%- when 'article-footer' -%}
						<div
							class="article-template__block article-template__footer"
							{{ block.shopify_attributes }}
						>
							{% if block.settings.footer_show_share %}
								{%- if block.settings.footer_show_share_facebook
									or block.settings.footer_show_share_twitter
									or block.settings.footer_show_share_telegram
									or block.settings.footer_show_share_copy
								-%}
									<div class="article-template__share">
										<ul class="share-buttons-simple">
											<h4 class="share-buttons-simple-label">
												{{ 'general.share.share' | t }}
											</h4>
											{%- if block.settings.footer_show_share_facebook -%}
												<li class="share-buttons-simple__item">
													<a
														href="https://www.facebook.com/sharer.php?u={{ shop.url | append: article.url }}"
														class="share-buttons-simple__button facebook-btn focus-inset"
														target="_blank"
														aria-label="facebook"
													>
														<div class="share-buttons-simple__icon-wrapper">
															{% render 'icon-facebook' %}
														</div>

														<span class="large-font animated-link__underline share-buttons-simple__button-text"
															>Facebook</span
														>
													</a>
												</li>
											{%- endif -%}

											{%- if block.settings.footer_show_share_telegram -%}
												<li class="share-buttons-simple__item">
													<a
														href="https://t.me/share/url?url={{ shop.url | append: article.url }}&text={{ article.title | escape }}"
														class="share-buttons-simple__button telegram-btn focus-inset"
														target="_blank"
														aria-label="telegram"
													>
														<div class="share-buttons-simple__icon-wrapper">
															{% render 'icon-telegram' %}
														</div>

														<span class="large-font animated-link__underline share-buttons-simple__button-text"
															>Telegram</span
														>
													</a>
												</li>
											{%- endif -%}

											{%- if block.settings.footer_show_share_twitter -%}
												<li class="share-buttons-simple__item">
													<a
														href="https://twitter.com/share?url={{ shop.url | append: article.url }}&text={{ article.title | escape }}"
														class="share-buttons-simple__button twitter-btn focus-inset"
														target="_blank"
														aria-label="twitter"
													>
														<div class="share-buttons-simple__icon-wrapper">
															{% render 'icon-twitter' %}
														</div>

														<span class="large-font animated-link__underline share-buttons-simple__button-text"
															>X</span
														>
													</a>
												</li>
											{%- endif -%}

											{%- if block.settings.footer_show_share_copy -%}
												<li class="share-buttons-simple__item">
													<a
														href="{{ shop.url | append: article.url }}"
														class="share-buttons-simple__button copy-btn focus-inset"
														data-notification="{{ 'general.notification.copied_link' | t }}"
														aria-label="copy button"
													>
														<div class="share-buttons-simple__icon-wrapper">
															{% render 'icon-copy-link' %}
														</div>

														<span class="large-font animated-link__underline share-buttons-simple__button-text">
															{{- 'general.share.copy_to_clipboard' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
										</ul>
									</div>
								{%- endif -%}
							{% endif %}

							{%- if block.settings.footer_show_author
								or block.settings.footer_show_tags
								or block.settings.footer_show_date
								or block.settings.footer_button_label != blank
							-%}
								<div class="article-template__footer-wrapper">
									<div class="article-template__footer-meta">
										{% render 'button',
											btn_label: block.settings.footer_button_label,
											btn_link: block.settings.footer_button_link,
											btn_style: block.settings.footer_button_style
										%}
										{%- if block.settings.footer_show_tags
											and article.tags != blank
										-%}
											<div class="article-template__tags small-font">
												{% for tag in article.tags %}
													<div class="article-template__tag">
														<a href="{{ blog.url }}/tagged/{{ tag | handle }}">
															<span title="{{ tag }}">
																{{- tag }}
															</span>
														</a>
													</div>
													{% if forloop.last == false %}
														<span class="article-template__tags-separator">
															|
														</span>
													{% endif %}
												{% endfor %}
											</div>
										{%- endif -%}

										{%- if block.settings.footer_show_date -%}
											<span class="article-template__date">
												<span class="article-template__date-text">
													{{- 'general.blog.update' | t | append: ':' }}
												</span>
												{{- article.updated_at | date: '%b / %d / %Y' -}}
											</span>
										{%- endif -%}

										{%- if block.settings.footer_show_author -%}
											<div class="article-template__author">
												<span>
													{{- 'general.blog.author' | t -}}
												</span>
												<span>
													{{- article.author -}}
												</span>
											</div>
										{%- endif -%}
									</div>
								</div>
							{% endif %}
						</div>
				{%- endcase -%}
			{%- endfor -%}
		</div>

		{% if section.settings.popular_image != blank
			or section.settings.blog != blank
			and section.settings.blog.articles_count > 0
		%}
			<div class="article-blocks-wrapper-right">
				{%- if section.settings.blog != blank
					and section.settings.blog.articles_count > 0
				-%}
					<div class="most-popular-blog__posts-wrapper">
						{%- if section_heading != blank -%}
							<h3 class="section-header__title {{ section_heading_size }}">
								{{ section_heading }}
							</h3>
						{% endif %}
						{%- for article in section.settings.blog.articles
							limit: post_limit
						-%}
							<div
								class="most-popular-blog__post article"
								data-id="{{ article.id }}"
							>
								{% render 'article-card',
									blog: section.settings.blog,
									article: article,
									show_image: section.settings.show_image,
									show_date: section.settings.show_date,
									show_author: section.settings.show_author,
									article-card__title-size: 'h5'
								%}
							</div>
						{%- endfor -%}
					</div>
				{% endif %}
				{% if section.settings.popular_image != blank %}
					<div
						class=" article-popular-image-wrapper"
						style="--popular_image_overlay_opacity: {{ section.settings.popular_image_overlay_opacity }};"
					>
						<div
							class="article-popular-image"
							style="--aspect-ratio: 3/4;"
						>
							<a
								href="{{ section.settings.button_link }}"
								class="article-template__header__link-overlay"
								aria-label="{{ section.settings.button_labe }}"
							></a>
							<div class="most-popular-content-inner">
								{% if section.settings.text != blank %}
									<div class="subtitle richtext	{% if section.settings.pulse_animation_text %} subtitle_dot{% endif %} {% if settings.rte_style == "custom" %} custom_rte{% endif %}">
										<span>
											{{ section.settings.text }}
										</span>
									</div>
								{% endif %}
								<div class="popular-articles-header-button-wrapper">
									{% if section.settings.heading != blank %}
										<h2 class="rich-text__heading {{ section.settings.popular-heading_size }}">
											{{ section.settings.heading }}
										</h2>
									{% endif %}

									{%- if section.settings.button_label != blank -%}
										<span>
											<a
												href="{{ section.settings.button_link }}"
												class="button button--{{ section.settings.button_style }} focus-inset"
												aria-label="{{ section.settings.button_label }}"
											>
												<span>{{- section.settings.button_label }}</span>
											</a>
										</span>
									{% endif %}
								</div>
							</div>
							{{
								section.settings.popular_image
								| image_url: width: section.settings.popular_image.width
								| image_tag:
									loading: 'lazy',
									sizes: '50vw',
									widths: '375, 550, 750'
							}}
						</div>
					</div>
				{% endif %}
			</div>
		{% endif %}
	</div>

	{%- if blog.comments_enabled? -%}
		<div class="article-template__comment-wrapper">
			<div id="comments" class="article-template__comment-container">
				{%- if article.comments_count > 0 -%}
					{%- assign anchorId = '#Comments-' | append: article.id -%}

					<h3 id="Comments-{{ article.id }}" tabindex="-1">
						{{ 'blogs.article.comments' | t: count: article.comments_count }}
					</h3>
					{% paginate article.comments by 5 %}
						<div class="article-template__comments">
							{%- if comment.status == 'pending' and comment.content -%}
								<article
									id="{{ comment.id }}"
									class="article-template__comments-comment"
								>
									{{ comment.content }}
									<footer class="right">
										<span class="circle-divider caption-with-letter-spacing">
											{{- comment.author -}}
										</span>
									</footer>
								</article>
							{%- endif -%}

							{%- for comment in article.comments -%}
								<article
									id="{{ comment.id }}"
									class="article-template__comments-comment"
								>
									{{ comment.content }}
									<footer class="right">
										<span class="circle-divider caption-with-letter-spacing">
											{{- comment.author -}}
										</span>
										<span class="caption-with-letter-spacing">
											{{- comment.created_at | time_tag: format: 'date' -}}
										</span>
									</footer>
								</article>
							{%- endfor -%}
							{% render 'pagination', paginate: paginate, anchor: anchorId %}
						</div>
					{% endpaginate %}
				{%- endif -%}
				{% form 'new_comment', article %}
					{%- liquid
						assign post_message = 'blogs.article.success'
						if blog.moderated? and comment.status == 'unapproved'
							assign post_message = 'blogs.article.success_moderated'
						endif
					-%}
					<h3>{{ 'blogs.article.comment_form_title' | t }}</h3>
					{%- if form.errors -%}
						<div class="form__message" role="alert">
							<h4
								class="form-status caption-large text-body"
								tabindex="-1"
								autofocus
							>
								{%- render 'icon-error' -%}
								{{ 'templates.contact.form.error_heading' | t }}
							</h4>
						</div>
						<ul class="form-status-list caption-large">
							{%- for field in form.errors -%}
								<li>
									<a
										href="#CommentForm-{{ field }}"
										class="link"
										aria-label="comment form error link"
									>
										{%- if form.errors.translated_fields[field]
												contains 'author'
										-%}
											{{ 'blogs.article.name' | t }}
										{%- elsif form.errors.translated_fields[field]
												contains 'body'
										-%}
											{{ 'blogs.article.message' | t }}
										{%- else -%}
											{{ form.errors.translated_fields[field] }}
										{%- endif -%}
										{{ form.errors.messages[field] }}
									</a>
								</li>
							{%- endfor -%}
						</ul>
					{%- elsif form.posted_successfully? -%}
						<div class="form-status-list form__message" role="status">
							<h4 class="form-status" tabindex="-1" autofocus>
								{% render 'icon-success' %}
								{{ post_message | t }}
							</h4>
						</div>
					{%- endif -%}

					<div
						{% if blog.moderated? == false %}
							class="article-template__comments-fields"
						{% endif %}
					>
						<div class="article-template__comment-fields">
							<div class="field field--with-error">
								<input
									dir="ltr"
									type="text"
									name="comment[author]"
									id="CommentForm-author"
									class="field__input focus-inset"
									autocomplete="name"
									value="{{ form.author }}"
									aria-required="true"
									required
									{% if form.errors contains 'author' %}
										aria-invalid="true"
										aria-describedby="CommentForm-author-error"
									{% endif %}
									tabindex="0"
								>
								<label for="CommentForm-author">
									{{- 'blogs.article.name' | t -}}
								</label>
								{%- if form.errors contains 'author' -%}
									<small id="CommentForm-author-error">
										<span class="form__message">
											{%- render 'icon-error' -%}
											{{- 'blogs.article.name' | t }}
											{{ form.errors.messages.author }}.</span
										>
									</small>
								{%- endif -%}
							</div>
							<div class="field field--with-error">
								<input
									dir="ltr"
									type="email"
									name="comment[email]"
									id="CommentForm-email"
									class="field__input focus-inset"
									autocomplete="email"
									value="{{ form.email }}"
									autocorrect="off"
									autocapitalize="off"
									aria-required="true"
									required
									{% if form.errors contains 'email' %}
										aria-invalid="true"
										aria-describedby="CommentForm-email-error"
									{% endif %}
									tabindex="0"
								>
								<label for="CommentForm-email">
									{{- 'blogs.article.email' | t -}}
								</label>
								{%- if form.errors contains 'email' -%}
									<small id="CommentForm-email-error">
										<span class="form__message">
											{%- render 'icon-error' -%}
											{{- 'blogs.article.email' | t }}
											{{ form.errors.messages.email }}.</span
										>
									</small>
								{%- endif -%}
							</div>
						</div>
						<div class="field field--with-error">
							<textarea
								rows="5"
								name="comment[body]"
								id="CommentForm-body"
								class="text-area field__input focus-inset"
								aria-required="true"
								required
								{% if form.errors contains 'body' %}
									aria-invalid="true"
									aria-describedby="CommentForm-body-error"
								{% endif %}
							>{{ form.body }}</textarea>
							<label for="CommentForm-body">
								{{- 'blogs.article.message' | t -}}
							</label>
						</div>
						{%- if form.errors contains 'body' -%}
							<small id="CommentForm-body-error">
								<span class="form__message">
									{%- render 'icon-error' -%}
									{{- 'blogs.article.message' | t }}
									{{ form.errors.messages.body }}.</span
								>
							</small>
						{%- endif -%}
					</div>
					{%- if blog.moderated? -%}
						<p class="article-template__comment-warning caption">
							{{ 'blogs.article.moderated' | t }}
						</p>
					{%- endif -%}

					<div class="button_wrapper custom-hover">
						<button
							type="submit"
							class="button button--primary  focus-inset"
							data-button-text="{{ 'blogs.article.post' | t }}"
							tabindex="0"
						>
							<div class="button__content">
								<span
									class="button__label"
									data-label="{{- 'blogs.article.post' | t | escape -}}"
								>
									{{- 'blogs.article.post' | t -}}
								</span>
							</div>
							<span class="button_circle"> </span>
						</button>
					</div>
				{% endform %}
			</div>
		</div>
	{%- endif -%}
</article>

<script type="application/ld+json">
	{
	  "@context": "http://schema.org",
	  "@type": "Article",
	  "articleBody": {{ article.content | strip_html | json }},
	  "mainEntityOfPage": {
	    "@type": "WebPage",
	    "@id": {{ request.origin | append: page.url | json }}
	  },
	  "headline": {{ article.title | json }},
	  {% if article.excerpt != blank %}
	    "description": {{ article.excerpt | strip_html | json }},
	  {% endif %}
	  {% if article.image %}
				{% assign image_size = article.image.width | append: 'x' %}
	    "image": [
	      {{ article | image_url: image_size | prepend: "https:" | json }}
	    ],
	  {% endif %}
	  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
	  "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
	  "author": {
	    "@type": "Person",
	    "name": {{ article.author | json }}
	  },
	  "publisher": {
	    "@type": "Organization",
	    {% if settings.share_image %}
					{% assign image_size = settings.share_image.width | append: 'x' %}
	      "logo": {
	        "@type": "ImageObject",
	        "height": {{ settings.share_image.height | json }},
	        "url": {{ settings.share_image | image_url: image_size | prepend: "https:" | json }},
	        "width": {{ settings.share_image.width | json }}
	      },
	    {% endif %}
	    "name": {{ shop.name | json }}
	  }
	}
</script>

