{{ 'section-descriptions-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{%- style -%}
	.cards-grid__wrapper {
		grid-template-columns: 1fr;
	}

	 @media screen and (min-width: 750px) {
		.cards-grid__wrapper {
			grid-template-columns: repeat(auto-fit, minmax(45%, 1fr));
		}
	}

	@media screen and (max-width: 989px) {
		.cards-grid__item {
			grid-column-start: 1 !important;
			grid-column-end: 2 !important;
			grid-row-start: auto !important;
			grid-row-end: auto !important;
		}
	}

	 @media screen and (max-width: 1099px) {
		.cards-grid__item {
			grid-column-start: auto !important;
			grid-column-end: auto !important;
			grid-row-start: auto !important;
			grid-row-end: auto !important;
		}
	}

	@media screen and (min-width: 1100px) {
	  #shopify-section-{{ section.id }} .cards-grid__wrapper {
			grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
	  }
	}
{%- endstyle -%}

{% liquid
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_heading_content_alignment = section.settings.section_heading_content_alignment
	assign pulse_animation_text = section.settings.pulse_animation_text
	assign description = section.settings.description
%}

<div class="cards-grid" id="description-grid-section">
	<div class="container">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			content_alignment: section_heading_content_alignment,
			pulse: pulse_animation_text,
			description: description
		%}
		<div class="cards-grid__wrapper">
			{%- for block in section.blocks -%}
				<div
					class="cards-grid__item color-background-1"
					{{ block.shopify_attributes }}
					data-id="{{ block.id }}"
					style="grid-column-start: {{ block.settings.column_start }}; grid-column-end: {{ block.settings.column_end }};"
				>
					{% assign column_span = block.settings.column_end
						| minus: block.settings.column_start
					%}
					{% assign is_narrow_card = true %}
					{% if section.settings.columns == 4 and column_span == 1 %}
						{% assign is_narrow_card = false %}
					{% endif %}

					{% if block.settings.value != blank %}
						<div class="value__wrapper">
							<div class="value">
								{{ block.settings.value }}
							</div>
							<p class="superscript">{{ block.settings.superscript }}</p>
						</div>
					{% endif %}

					{%- if block.settings.heading != blank -%}
						<{{ block.settings.heading_tag | default: 'h5' }}
							class="cards-grid__heading {{ block.settings.heading_size }} {% if is_narrow_card  %}cards-grid__item--narrow{% endif %}"
						>
							{{ block.settings.heading }}
						</{{ block.settings.heading_tag | default: 'h5' }}>
					{%- endif -%}

					{%- if block.settings.text != blank -%}
						<div class="richtext__content extra-large-font cards-grid-text {% if is_narrow_card %}cards-grid__item--narrow{% endif %}">
							{{ block.settings.text }}
						</div>
					{%- endif -%}
				</div>
			{%- endfor -%}
		</div>
	</div>
</div>

