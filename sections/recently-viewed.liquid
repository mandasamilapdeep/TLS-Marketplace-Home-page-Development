{{ 'section-products-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{% liquid
	assign quickview_hover = settings.quickview_hover
	assign show_on_mobile = settings.show_on_mobile
	assign quickview_show = settings.quickview_show
	assign type_color_swatch = settings.type_color_swatch
%}

{%- if quickview_show or show_on_mobile or type_color_swatch == 'custom' -%}
	{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if quickview_show or show_on_mobile -%}
	{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
	{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
	{% render 'section-margin' %}

	.recently-viewed__empty {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: center;
  }
  .recently-viewed__empty span {
    max-width: 550px;
    text-align: center;
  }
  .recently-viewed--empty .recently-viewed__empty {
    display: flex;
  }
  .recently-viewed .loading-overlay {
    inset: 0;
    z-index: 6;
    display: none;
    width: 100%;
    padding: 0 5rem;
  }
  .recently-viewed.recently-viewed--loading .loading-overlay {
    display: block;
  }
  .recently-viewed.recently-viewed--loading .loading-overlay .loading-overlay__spinner {
    top: 50%;
    transform: translateY(-50%);
  }
  .recently-viewed.recently-viewed--loading .popular-products__navigation,
  .recently-viewed.recently-viewed--empty .popular-products__navigation {
    display: none;
  }
{%- endstyle -%}

{% liquid
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_heading_content_alignment = section.settings.section_heading_content_alignment
	assign pulse_animation_text = section.settings.pulse_animation_text
	assign swipe_on_mobile = section.settings.swipe_on_mobile
	assign columns_mobile = section.settings.columns_mobile
	assign products_per_page = section.settings.products_per_page
	assign columns_per_row = section.settings.columns_per_row
	assign quickview_hover = settings.quickview_hover
	assign show_swatches = section.settings.show_swatches
	assign image_ratio = section.settings.image_ratio
	assign image_fit = section.settings.image_fit
	assign show_secondary_image = section.settings.show_secondary_image
	assign show_vendor = section.settings.show_vendor
	assign show_collection = section.settings.show_collection
	assign show_desc = section.settings.show_desc
	assign columns_per_row = section.settings.columns_per_row

	assign class_swipe_products_grid = ''
	if swipe_on_mobile
		assign class_swipe_products_grid = 'swiper--products-grid'
	endif

	assign class_quickview_hover = ''
	if quickview_hover
		assign class_quickview_hover = 'quickview--hover'
	endif
%}

<div
	class="products-grid recently-viewed recently-viewed--loading {% if search.performed %} recently-viewed--search-perfomed{% endif %}"
	data-base-url="{{ routes.search_url }}?section_id={{section.id}}&type=product"
  data-products-limit="{{ section.settings.products_limit }}"
  data-expiration-days="{{ settings.recently_product_record_lifetime }}"
  {% if request.page_type == 'product' and product != blank %}
    data-current-page-product-id="{{ product.id }}"
  {% endif %}
	data-slider-mobile="{{ swipe_on_mobile }}"
	role="region"
	aria-label="{{ section_heading | escape }}"
>
	<div class="container">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			content_alignment: section_heading_content_alignment,
			pulse: pulse_animation_text,
			id: 'products-grid-heading'
		%}

		<div class="products-grid__content">
			<div class="loading-overlay" aria-busy="true">
				<div class="loading-overlay__spinner">
					{% render 'icon-spinner' %}
				</div>
			</div>

			<div class="recently-viewed__empty body-large">
				<span class="body-large">{{- 'sections.recently_viewed.empty_message' | t -}}</span>
			</div>

			<div
				class="{{ class_swipe_products_grid }}"
				data-columns-mobile="{{ columns_mobile }}"
			>
				<ul
					class="products-grid__wrapper products-grid__wrapper--{{ columns_per_row }} products-grid__wrapper--{{ columns_mobile }}-mobile"
					role="list"
					aria-labelledby="products-grid-heading"
				>
					{% liquid
						paginate search.results by 50
							assign product_list = search.results | where: 'object_type', 'product'
						endpaginate
					%}
					
					{%- for product in product_list limit: products_per_page -%}
						<li
							role="listitem"
							class="collection-product-card {{ class_quickview_hover }}"
						>
							{% render 'product-card',
								product_card_product: product,
								media_size: image_ratio,
								media_fit: image_fit,
								show_secondary_image: show_secondary_image,
								show_vendor: show_vendor,
								show_collection: show_collection,
								show_desc: show_desc,
								section_id: section.id,
								columns: columns_per_row,
								add_id: forloop.index,
								content_alignment: 'left',
								show_swatches: show_swatches,
								heading_tag: section.settings.product_heading_tag
							%}
						</li>
					{%- endfor -%}
				</ul>

				{%- if swipe_on_mobile -%}
					{% render 'swiper-nav' %}
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
