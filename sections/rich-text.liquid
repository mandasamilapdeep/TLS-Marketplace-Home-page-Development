{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_heading_content_alignment = section.settings.section_heading_content_alignment
	assign pulse_subheading = section.settings.pulse_animation_text
%}

<div class="rich-text container ">
	<div class="rich-text__wrapper {% if section_heading == blank %} without-heading{% endif %}">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			description: '',
			content_alignment: section_heading_content_alignment,
			pulse: pulse_subheading,
		%}
		{% if section.settings.text != blank %}
			<div
				class="rich-text__text"
			>
				{{ section.settings.text }}
			</div>
		{% endif %}
	</div>
</div>

{% schema %}
{
	"name": "t:sections.rich-text.name",
	"tag": "section",
	"class": "spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "inline_richtext",
			"id": "section_heading",
			"default": "t:sections.all.richtext_section.heading.default",
			"label": "t:sections.all.richtext_section.heading.label"
		},
		{
			"type": "select",
			"id": "section_heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:sections.all.heading_size.options__4.label"
				},
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
			],
			"default": "h3",
			"label": "t:sections.all.heading_size.label",
			"visible_if": "{{ section.settings.section_heading != blank }}",
		},
		{
			"type": "select",
			"id": "section_heading_tag",
			"default": "h3",
			"label": "t:sections.all.heading_tag.label",
			"info": "t:sections.all.heading_tag.info",
			"visible_if": "{{ section.settings.section_heading != blank }}",
			"options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        },
        {
          "value": "p",
          "label": "t:sections.all.heading_tag.options__8.label"
        },
				{
          "value": "span",
          "label": "t:sections.all.heading_tag.options__9.label"
        }
      ]
		},
		{
			"type": "text",
			"id": "section_subheading",
			"default": "t:sections.all.richtext_section.subheading.default",
			"label": "t:sections.all.richtext_section.subheading.label"
		},
		{
			"type": "checkbox",
			"id": "pulse_animation_text",
			"label": "t:sections.all.pulse_animation_text.label",
			"default": false,
			"visible_if": "{{ section.settings.section_subheading != blank }}"
		},
		{
			"type": "richtext",
			"id": "text",
			"label": "t:sections.all.richtext_section.description.label",
			"default": "t:sections.all.richtext_section.description.default"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.rich-text.presets.name"
		}
	]
}
{% endschema %}
