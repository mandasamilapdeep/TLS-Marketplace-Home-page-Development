{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

<div class="contact-form contact-form__content--{{ section.settings.content_alignment }}">
	<div class="container contact-form__container">
		{%- if section.settings.subheading != blank -%}
			<span class="contact-form__subtitle subtitle {% if section.settings.pulse_animation_text %}subtitle_dot{% endif %}">
				{{ section.settings.subheading }}
			</span>
		{%- endif -%}
		{%- if section.settings.heading != blank -%}
			<{{ section.settings.heading_tag | default: 'h2' }} 
				class="contact-form__title {{ section.settings.heading_size }}"
			>
				{{ section.settings.heading }}
			</{{ section.settings.heading_tag | default: 'h2' }}>
		{%- endif -%}
		{%- if section.settings.text != blank -%}
			<p class="contact-form__text">
				{{ section.settings.text }}
			</p>
		{%- endif -%}
		<div class="contact-form__inner">
			<div class="contact-form__wrapper">
				{%- form 'contact', id: 'ContactForm' -%}
					{%- if form.posted_successfully? -%}
						<div
							class="form-status form-status-list form__message"
							tabindex="-1"
							autofocus
						>
							{% render 'icon-success' %}
							{{ 'templates.contact.form.post_success' | t }}
						</div>
					{%- elsif form.errors -%}
					{%- endif -%}
					<div class="contact-form__flex">
						<div class="field field__name">
							<input
								class="field__input focus-inset"
								autocomplete="name"
								type="text"
								dir="ltr"
								id="ContactForm-name"
								name="contact[{{ 'templates.contact.form.name' | t }}]"
								oninput="this.classList.toggle('has-content', this.value.length > 0)"
								onfocus="this.classList.toggle('has-content', this.value.length > 0)"
								onblur="this.classList.toggle('has-content', this.value.length > 0)"
								value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
								placeholder=""
								required
								tabindex="0"
							>
							<label
								class="field__label required-field hidden"
								for="ContactForm-name"
								placeholder="{{ 'templates.contact.form.name' | t }}"
							>
								{{ 'templates.contact.form.name' | t }}
							</label>
						</div>
						<div class="field">
							<input
								type="tel"
								id="ContactForm-phone"
								class="field__input  focus-inset"
								autocomplete="tel"
								oninput="this.classList.toggle('has-content', this.value.length > 0)"
								name="contact[{{ 'templates.contact.form.phone' | t }}]"
								pattern="[0-9\-]*"
								value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
								placeholder=""
								tabindex="0"
							>
							<label
								class="field__label required-field hidden"
								for="ContactForm-phone"
								placeholder="{{ 'templates.contact.form.phone' | t }}"
							>
								{{- 'templates.contact.form.phone' | t -}}
							</label>
						</div>
					</div>
					<div class="field field--with-error">
						<input
							autocomplete="email"
							type="email"
							dir="ltr"
							id="ContactForm-email"
							class="field__input focus-inset"
							name="contact[email]"
							spellcheck="false"
							autocapitalize="off"
							oninput="this.classList.toggle('has-content', this.value.length > 0)"
							value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
							aria-required="true"
							{% if form.errors contains 'email' %}
								aria-invalid="true"
								aria-describedby="ContactForm-email-error"
							{% endif %}
							placeholder=""
							required
							tabindex="0"
						>
						<label
							class="field__label required-field hidden"
							for="ContactForm-email"
							placeholder="{{ 'templates.contact.form.email' | t }}"
						>
							{{ 'templates.contact.form.email' | t }}
						</label>
						{%- if form.errors contains 'email' -%}
							<small
								class="contact-form__field-error"
								id="ContactForm-email-error"
							>
								<span class="visually-hidden">
									{{- 'accessibility.error' | t -}}
								</span>
								<span class="form__message">
									{{- form.errors.translated_fields.email | capitalize }}
									{{ form.errors.messages.email -}}
								</span>
							</small>
						{%- endif -%}
					</div>
					<div class="field field-last">
						<textarea
							id="ContactForm-body"
							class="text-area field__input  focus-inset"
							name="contact[{{ 'templates.contact.form.comment' | t }}]"
							placeholder=""
							oninput="this.classList.toggle('has-content', this.value.length > 0)"
							aria-required="true"
							required
							tabindex="0"
						>
              {{- form.body -}}
            </textarea>
						<label
							class="form__label field__label required-field hidden"
							for="ContactForm-body"
							placeholder="{{ 'templates.contact.form.comment' | t }}"
						>
							{{- 'templates.contact.form.comment' | t -}}
						</label>
					</div>
					<div class="contact-form__bottom">
						<button
							type="submit"
							class="button button--{{ section.settings.button_style }}  focus-inset"
							data-button-text="{{ 'templates.contact.form.send' | t }}"
							tabindex="0"
						>
							<span>{{ 'templates.contact.form.send' | t }}</span>
						</button>

						{% if section.settings.additional_text != blank %}
							<div class="contact-form__add-text richtext_custom">
								{{ section.settings.additional_text }}
							</div>
						{% endif %}
					</div>
				{%- endform -%}
			</div>
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		// Email validation function
		function isValidEmail(email) {
			return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
		}

		// Email validation on form submit
		var form = document.getElementById('ContactForm');
		if (form) {
			var emailInput = form.querySelector('input[type="email"]');
			var errorMsg = document.getElementById('ContactForm-email-error');

			form.addEventListener('submit', function (e) {
				if (emailInput) {
					var email = emailInput.value.trim();
					if (!isValidEmail(email)) {
						e.preventDefault();
						emailInput.setAttribute('aria-invalid', 'true');
						if (errorMsg) {
							errorMsg.style.display = '';
							errorMsg.innerHTML =
								'<span class="visually-hidden">Error:</span> <span class="form__message">Please enter a valid email address.</span>';
						} else {
							alert('Please enter a valid email address.');
						}
					} else {
						emailInput.removeAttribute('aria-invalid');
						if (errorMsg) errorMsg.style.display = 'none';
					}
				}
			});
		}

		// Label visibility toggle for all required fields
		var labels = document.querySelectorAll('.required-field');
		labels.forEach(function (label) {
			var inputElem = null;
			if (label.hasAttribute('for')) {
				inputElem = document.getElementById(label.getAttribute('for'));
			}

			function toggleVisibility() {
				if (inputElem && inputElem.value && inputElem.value.length > 0) {
					label.classList.add('hidden');
				} else {
					label.classList.remove('hidden');
				}
			}

			if (inputElem) {
				toggleVisibility();
				inputElem.addEventListener('blur', toggleVisibility);
				inputElem.addEventListener('focus', toggleVisibility);
				inputElem.addEventListener('input', toggleVisibility);
			}
		});
	});
</script>

