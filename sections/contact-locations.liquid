					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "m",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"blocks": [
		{
			"type": "location",
			"name": "Location",
			"settings": [
				{
					"type": "text",
					"id": "location_address",
					"default": "t:sections.contact-locations.blocks.settings.address.default",
					"label": "t:sections.contact-locations.blocks.settings.address.label"
				},
				{
					"type": "text",
					"id": "phone_number",
					"default": "t:sections.contact-locations.blocks.settings.phone_number.default",
					"label": "t:sections.contact-locations.blocks.settings.phone_number.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.contact-locations.name",
			"blocks": [
				{
					"type": "location"
				},
				{
					"type": "location"
				},
				{
					"type": "location"
				}
			]
		}
