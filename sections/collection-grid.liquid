{{ 'section-collection-grid.css' | asset_url | stylesheet_tag }}

<script
	src="{{ 'magnetic-hover-effect.js' | asset_url }}"
	defer="defer"
></script>

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

<div class="collection-grid">
	<div class="container">
		{% render 'section-header',
			section_heading: section.settings.heading,
			section_subheading: section.settings.subheading,
			section_heading_size: section.settings.section_heading_size,
			section_heading_tag: section.settings.section_heading_tag,
			pulse: section.settings.pulse_animation_text
		%}
		<div class="collection-grid__wrapper">
			{% for block in section.blocks %}
				<div
					class="collection-grid__item collection-grid__item--{{ forloop.index }} {% if section.settings.magnetic_hover_effect %} magnetic-hover-effect {% endif %}"
					{{ block.shopify_attributes }}
				>
					{% render 'collection-card',
						block_collection: block.settings.collection,
						block_color_scheme: 'background-1',
						media_size: block.settings.image_ratio,
						media_size_mobile: block.settings.image_ratio_mobile,
						media_fit: block.settings.object_fit,
						url: block.settings.collection.url,
						heading_size: block.settings.heading_size,
						heading_tag: block.settings.heading_tag,
						collection_title: block.settings.collection.title,
						collection_desc: block.settings.collection.description,
						custom_desc: block.settings.description,
						collection_image: block.settings.collection.image,
						text_center: block.settings.text_center,
						show_collection_desc: block.settings.show_descr,
						btn_label: block.settings.btn_label,
						btn_link: block.settings.collection.url,
						btn_style: block.settings.btn_style,
						overlay_opacity: block.settings.overlay_opacity,
						overlay_opacity_mobile: block.settings.overlay_opacity_mobile,
						additional_image: block.settings.additional_image,
						index: forloop.index
					%}
				</div>
			{% endfor %}
		</div>
	</div>
</div>

