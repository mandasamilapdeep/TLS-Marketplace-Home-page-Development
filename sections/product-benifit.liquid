{% stylesheet %}
.product-benefit-wrapper{
  width:100%;
  margin:18px 0;
}

.product-benefit-box{
  padding:18px 22px;
  border-radius:16px;
  background: {{ section.settings.bg_color }};
  border:1px solid {{ section.settings.border_color }};
}

.product-benefit-heading{
  margin:0 0 10px;
  color:{{ section.settings.heading_color }};
  font-size:{{ section.settings.heading_size }}px;
  font-weight:700;
  line-height:1.2;
}

.product-benefit-text{
  margin:0;
  color:{{ section.settings.text_color }};
  font-size:{{ section.settings.text_size }}px;
  line-height:1.6;
  font-weight:500;
}

@media screen and (max-width:768px){

  .product-benefit-box{
    padding:16px;
    border-radius:12px;
  }

  .product-benefit-heading{
    font-size:{{ section.settings.heading_size_mobile }}px;
  }

  .product-benefit-text{
    font-size:{{ section.settings.text_size_mobile }}px;
  }
}
{% endstylesheet %}

<div class="product-benefit-wrapper">
  <div class="product-benefit-box">

    {% if section.settings.heading != blank %}
      <h3 class="product-benefit-heading">
        {{ section.settings.heading }}
      </h3>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="product-benefit-text">
        {{ section.settings.description }}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Product Benefit Explain",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why This Product Works"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Uses high-quality ingredients and advanced formulation to support better daily performance so you feel healthier and more energized.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading Size Desktop",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Text Size Desktop",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading Size Mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size Mobile",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product Benefit Explain"
    }
  ]
}
{% endschema %}