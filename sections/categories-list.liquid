{{ 'section-categories-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'categories-list.js' | asset_url }}" defer="defer"></script>
<script
	src="{{ 'magnetic-hover-effect.js' | asset_url }}"
	defer="defer"
></script>

{%- style -%}
	{% render 'section-margin' %}
{%- endstyle -%}

{% liquid
	assign column_per_row = section.settings.columns_per_row
	assign image_ratio = section.settings.image_ratio
	assign object_fit = section.settings.object_fit
	assign swipe_on_mobile = section.settings.swipe_on_mobile
	assign columns_mobile = section.settings.columns_mobile
	assign section_heading = section.settings.section_heading
	assign section_heading_size = section.settings.section_heading_size
	assign section_heading_tag = section.settings.section_heading_tag
	assign section_subheading = section.settings.section_subheading
	assign section_heading_content_alignment = section.settings.section_heading_content_alignment
	assign pulse_subheading = section.settings.pulse_animation_text
	assign section_descr = section.settings.section_descr
	assign item_content_alignment = section.settings.collection_list_item_content_alignment
	assign button_style = section.settings.button_style
	assign magnetic_hover_effect = section.settings.magnetic_hover_effect
	assign shop_now = 'general.card.shop__now' | t
%}

<div class="categories-list">
	<div class="container">
		{% render 'section-header',
			section_heading: section_heading,
			section_heading_size: section_heading_size,
			section_heading_tag: section_heading_tag,
			section_subheading: section_subheading,
			description: section_descr,
			content_alignment: section_heading_content_alignment,
			pulse: pulse_subheading
		%}

		<div
			class="categories-list__content {% if swipe_on_mobile and section.blocks.size > 1 %}swiper swiper--collections{% endif %}"
			data-columns-mobile="{{columns_mobile}}"
		>
			<div
				class="
					categories-list__wrapper categories-list__wrapper--overlay
					categories-list__wrapper--{{ column_per_row }}
					categories-list__wrapper--{{columns_mobile}}-mobile
					{% if swipe_on_mobile and section.blocks.size > 1 %} swiper-wrapper{% endif %}
				"
			>
				{%- for block in section.blocks -%}
					{% liquid
						if block.settings.image != blank
							assign collection_image = block.settings.image
						else
							assign collection_image = block.settings.collection.featured_image
						endif
					%}

					{% style %}
						#shopify-section-{{ section.id }} [data-id="{{ block.id }}"].categories-list__item {
						    --opacity-overlay: {{ block.settings.overlay_opacity }};
						    {% if image_ratio != 'large' %}
						      --aspect-ratio: {{ image_ratio }};
						    {% endif %}
						  }
					{% endstyle %}

					<div
						class="
							 categories-list__item
							{% if magnetic_hover_effect %} magnetic-hover-effect {% endif %}
							{% if swipe_on_mobile and section.blocks.size > 1 %}swiper-slide{% endif %}
						"
						{{ block.shopify_attributes }}
						data-id="{{ block.id }}"
					>
						<div class="categories-list__item-inner color-background-3 {{ image_ratio }}">
							<div class="categories-list__image">
								{% if collection_image != blank %}
									{%- capture style -%}
                      object-fit: {{ object_fit }};
                    {%- endcapture -%}
									{{
										collection_image
										| image_url: width: collection_image.width
										| image_tag:
											loading: 'lazy',
											widths: '360, 535, 720, 940, 1070, 1200, 1500, 1780, 2000, 2400, 2800, 3200',
											style: style
									}}
								{% else %}
									{% assign collection_index = forloop.index
										| modulo: 3
										| plus: 1
									%}
									{{
										'collection-apparel-'
										| append: collection_index
										| placeholder_svg_tag: 'placeholder-svg'
									}}
								{% endif %}

								<span class="categories-list__overlay"></span>
							</div>
							<div class="item-inner--info {{item_content_alignment}}">
								<div>
									<{{ block.settings.heading_tag | default: 'h4' }} 
										class="categories-list__item-title--inner {{ block.settings.heading_size }}"
									>
										{% if block.settings.collection != blank %}
											<span>{{ block.settings.collection.title }}</span>
										{% else %}
											<span>
												{{- 'general.card.collection_name' | t -}}
											</span>
										{% endif %}
									</{{ block.settings.heading_tag | default: 'h4' }}>

									<span class="collection_list__item-desc">
										{{- block.settings.description -}}
									</span>
								</div>

								{% if block.settings.collection != blank %}
									{% render 'button',
										btn_label: shop_now,
										btn_link: block.settings.collection.url,
										btn_style: button_style,
										add_classes: 'categories-list__link focus-inset'
									%}
								{% endif %}
							</div>

							{% if block.settings.collection != blank %}
								<a
									href="{{ block.settings.collection.url }}"
									class="card-link-overlay"
									aria-label="{{ block.settings.collection.title | escape }}"
								></a>
							{% endif %}
						</div>
					</div>
				{%- endfor -%}
			</div>

			{%- if swipe_on_mobile and section.blocks.size > 1 -%}
				<div class="swipe-on-mobile__nav no-js-hidden">
					<div class="categories-list__pagination swiper-pagination"></div>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

