{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card-overlay.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- if settings.pagination_type == 'load_more'
	or settings.pagination_type == 'infinite_scroll'
-%}
	<script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
	{% render 'section-margin' %}

	{%- assign image_ratio = section.settings.image_ratio -%}
	{%- assign overlay_image_ratio = section.settings.overlay_image_ratio -%}
	{%- assign overlay_opacity = section.settings.overlay_opacity -%}

	{%- for article in blog.articles -%}
	  #shopify-section-{{ section.id }} [data-id="{{ article.id }}"].blog-articles__article {
	  --aspect-ratio: {{ image_ratio }};
	  }

	  #shopify-section-{{ section.id }} [data-id="{{ article.id }}"].blog-articles__article.blog-articles__article--featured {
	    --overlay-opacity: {{ overlay_opacity }};
	    {% if overlay_image_ratio != 'adapt' %}
	      --aspect-ratio: {{ overlay_image_ratio }};
	    {% elsif article.image %}
	      --aspect-ratio: {{ article.image.aspect_ratio }};
	    {% endif %}
	  }

			/* Override overlay opacity on mobile - no loop needed! */
	 @media screen and (max-width: 576px) {
	  #shopify-section-{{ section.id }} [data-id="{{ article.id }}"].blog-articles__article.blog-articles__article--featured {
	     --overlay-opacity: 0.5;
	   }
	 }
	{%- endfor -%}
{%- endstyle -%}

{% liquid
	assign article_per_page = section.settings.posts_per_page
	assign backlight_animation = section.settings.backlight_animation

	assign class_backlight_animation = ''
	if backlight_animation
		assign class_backlight_animation = 'backlight-led-animation__bg--new'
	endif
%}

<div class="main-blog">
	<div class="container">
		{% render 'section-header',
			section_heading: blog.title,
			description: section.settings.description,
			section_heading_size: section.settings.section_heading_size
		%}
	</div>

	{% if blog.articles_count > 0 %}
		<div class="main-blog__articles container overlay">
			{% if section.settings.featured_article %}
				{% paginate blog.articles by article_per_page %}
					{% if paginate.current_page == 1 %}
						{% for article in blog.articles %}
							{% if article.id == section.settings.featured_article.id %}
								<li
									class="blog-articles__article article blog-articles__article--featured blog-articles__article--featured-selected  {{ class_backlight_animation }}"
									data-id="{{ article.id }}"
								>
									{%- render 'article-card-overlay',
										article: article,
										show_image: true,
										show_tags: section.settings.show_tags_overlay,
										show_date: section.settings.show_date_overlay,
										show_author: section.settings.show_author_overlay,
										show_excerpt: section.settings.show_excerpt_overlay,
										overlay_enable: true,
										color_scheme: section.settings.color_scheme
									-%}
								</li>
								{% break %}
							{% endif %}
						{% endfor %}
					{% endif %}
				{% endpaginate %}
			{% endif %}

			{% paginate blog.articles by article_per_page %}
				<ul class="blog-articles load-more-grid blog-articles--{{ section.settings.columns_mobile }}-mobile">
					{% for article in blog.articles limit: section.settings.post_limit %}
						{% unless section.settings.featured_article
							and article.id == section.settings.featured_article.id
						%}
							{% if forloop.index == 1
								and section.settings.featured_article == blank
								and paginate.current_page == 1
							%}
								<li
									class="blog-articles__article article blog-articles__article--featured  {{ class_backlight_animation }}"
									data-id="{{ article.id }}"
								>
									{%- render 'article-card-overlay',
										article: article,
										show_image: true,
										show_tags: section.settings.show_tags_overlay,
										show_date: section.settings.show_date_overlay,
										show_author: section.settings.show_author_overlay,
										show_excerpt: section.settings.show_excerpt_overlay,
										overlay_enable: true,
										color_scheme: section.settings.color_scheme
									-%}
								</li>
							{% else %}
								<li
									class="blog-articles__article article"
									data-id="{{ article.id }}"
								>
									{%- render 'article-card',
										article: article,
										show_image: section.settings.show_image,
										show_tags: section.settings.show_tags,
										show_date: section.settings.show_date,
										show_author: section.settings.show_author,
										show_excerpt: section.settings.show_excerpt
									-%}
								</li>
							{% endif %}
						{% endunless %}
					{% endfor %}
				</ul>

				{% if paginate.pages > 1 %}
					{% if settings.pagination_type == 'load_more' %}
						{% render 'load-more',
							next_url: paginate.next.url,
							count_pages: paginate.pages,
							current_page: paginate.current_page
						%}
						<div class="js-hidden">
							{% render 'pagination', paginate: paginate %}
						</div>
					{% elsif settings.pagination_type == 'infinite_scroll' %}
						{% render 'infinite-scroll',
							next_url: paginate.next.url,
							count_pages: paginate.pages,
							current_page: paginate.current_page
						%}
						<div class="js-hidden">
							{% render 'pagination', paginate: paginate %}
						</div>
					{% else %}
						{% render 'pagination', paginate: paginate %}
					{% endif %}
				{% endif %}
			{% endpaginate %}
		</div>
	{% endif %}
</div>

