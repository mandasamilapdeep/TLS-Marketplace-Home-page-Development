{% doc %}
  @prompt
    create pop up with text image and button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-popup-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-popup-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-popup-container-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.popup_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    max-width: {{ block.settings.popup_max_width }}px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    transform: scale(0.9);
    transition: transform 0.3s ease;
    z-index: 9999;
    display: block;
  }

  .ai-popup-overlay-{{ ai_gen_id }}.active .ai-popup-container-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.close_button_spacing }}px;
    right: {{ block.settings.close_button_spacing }}px;
    background-color: {{ block.settings.close_button_background }};
    border: none;
    width: {{ block.settings.close_button_size }}px;
    height: {{ block.settings.close_button_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background-color 0.3s ease;
  }

  .ai-popup-close-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.close_button_hover_background }};
  }

  .ai-popup-close-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.close_button_size }}px * 0.5);
    height: calc({{ block.settings.close_button_size }}px * 0.5);
    stroke: {{ block.settings.close_button_color }};
  }

  .ai-popup-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-popup-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-popup-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-popup-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-popup-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-popup-text-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-popup-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    line-height: 1.2;
  }

  .ai-popup-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-popup-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    align-self: flex-start;
  }

  .ai-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-popup-trigger-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.trigger_button_background }};
    color: {{ block.settings.trigger_button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-popup-trigger-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.trigger_button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-popup-container-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-popup-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-popup-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-popup-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<popup-component-{{ ai_gen_id }} class="ai-popup-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_trigger_button %}
    <button class="ai-popup-trigger-{{ ai_gen_id }}" aria-label="Open popup">
      {{ block.settings.trigger_button_text }}
    </button>
  {% endif %}

  <div class="ai-popup-overlay-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-labelledby="popup-heading-{{ ai_gen_id }}">
    <div class="ai-popup-container-{{ ai_gen_id }}">
      <button class="ai-popup-close-{{ ai_gen_id }}" aria-label="Close popup">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="ai-popup-content-{{ ai_gen_id }}">
        <div class="ai-popup-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.popup_image %}
            <img
              src="{{ block.settings.popup_image | image_url: width: 1000 }}"
              alt="{{ block.settings.popup_image.alt | escape }}"
              class="ai-popup-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.popup_image.width }}"
              height="{{ block.settings.popup_image.height }}"
            >
          {% else %}
            <div class="ai-popup-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-popup-text-content-{{ ai_gen_id }}">
          {% if block.settings.popup_heading != blank %}
            <h2 id="popup-heading-{{ ai_gen_id }}" class="ai-popup-heading-{{ ai_gen_id }}">
              {{ block.settings.popup_heading }}
            </h2>
          {% endif %}

          {% if block.settings.popup_text != blank %}
            <div class="ai-popup-text-{{ ai_gen_id }}">
              {{ block.settings.popup_text }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank %}
            <a href="{{ block.settings.button_link }}" class="ai-popup-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</popup-component-{{ ai_gen_id }}>

<script>
  (function() {
    class PopupComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.overlay = this.querySelector('.ai-popup-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-popup-close-{{ ai_gen_id }}');
        this.triggerButton = this.querySelector('.ai-popup-trigger-{{ ai_gen_id }}');
        this.autoOpen = {{ block.settings.auto_open }};
        this.autoOpenDelay = {{ block.settings.auto_open_delay }};

        this.setupEventListeners();

        if (this.autoOpen) {
          setTimeout(() => {
            this.openPopup();
          }, this.autoOpenDelay * 1000);
        }
      }

      setupEventListeners() {
        if (this.triggerButton) {
          this.triggerButton.addEventListener('click', () => {
            this.openPopup();
          });
        }

        this.closeButton.addEventListener('click', () => {
          this.closePopup();
        });

        this.overlay.addEventListener('click', (e) => {
          if (e.target === this.overlay) {
            this.closePopup();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.overlay.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      openPopup() {
        this.overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closePopup() {
        this.overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('popup-component-{{ ai_gen_id }}', PopupComponent{{ ai_gen_id }});
  })();
</script>

