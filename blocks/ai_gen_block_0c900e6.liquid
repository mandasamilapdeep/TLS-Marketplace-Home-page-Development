{% doc %}
  @prompt
    Copy "Image banner with icons" section. create icon placement controls and controls to modify section height and internal padding. Create controls for icon text alignment, make background image cover entire section, move icons to lower center and text to upper center. Make background behind icons transparent, place icons above the icon text, centered, add controls for top internal padding and bottom internal padding. add banner image for mobile., add controls for icon image upload, enable subheading content width control, fix icon layout on mobile, have icons on bottom center, enable icon text to be multiple lines so all fit inline on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-banner-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .ai-image-banner-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-banner-image-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-image-banner-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-image-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-image-banner-text-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    text-align: {{ block.settings.content_alignment }};
    padding-left: {{ block.settings.content_padding_horizontal }}px;
    padding-right: {{ block.settings.content_padding_horizontal }}px;
    padding-top: {{ block.settings.content_padding_top }}px;
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-image-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
  }

  .ai-image-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 auto;
    line-height: 1.4;
    max-width: {{ block.settings.subheading_max_width }}px;
  }

  .ai-image-banner-icons-wrapper-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: center;
    padding-left: {{ block.settings.content_padding_horizontal }}px;
    padding-right: {{ block.settings.content_padding_horizontal }}px;
    padding-bottom: {{ block.settings.content_padding_bottom }}px;
  }

  .ai-image-banner-icons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.icon_gap }}px;
    {% if block.settings.icon_placement == 'below_content' %}
      flex-direction: column;
      align-items: center;
    {% elsif block.settings.icon_placement == 'inline' %}
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    {% elsif block.settings.icon_placement == 'grid' %}
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      justify-items: center;
    {% endif %}
  }

  .ai-image-banner-icon-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    flex-direction: column;
    text-align: center;
  }

  .ai-image-banner-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
  }

  .ai-image-banner-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-image-banner-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-image-banner-icon-text-{{ ai_gen_id }} {
    color: {{ block.settings.icon_text_color }};
    font-size: {{ block.settings.icon_text_size }}px;
    line-height: 1.3;
    margin: 0;
    max-width: {{ block.settings.icon_text_max_width }}px;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 0;
    left: 0;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-image-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.banner_height_mobile }}px;
    }

    .ai-image-banner-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-image-banner-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-image-banner-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-image-banner-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.8);
    }

    .ai-image-banner-text-content-{{ ai_gen_id }} {
      padding-left: {{ block.settings.content_padding_horizontal_mobile }}px;
      padding-right: {{ block.settings.content_padding_horizontal_mobile }}px;
      padding-top: {{ block.settings.content_padding_top_mobile }}px;
    }

    .ai-image-banner-icons-wrapper-{{ ai_gen_id }} {
      padding-left: {{ block.settings.content_padding_horizontal_mobile }}px;
      padding-right: {{ block.settings.content_padding_horizontal_mobile }}px;
      padding-bottom: {{ block.settings.content_padding_bottom_mobile }}px;
    }

    .ai-image-banner-icons-{{ ai_gen_id }} {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-end;
    }

    .ai-image-banner-icon-item-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
      flex: 0 0 auto;
    }

    .ai-image-banner-icon-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.icon_text_size }}px * 0.9);
      max-width: {{ block.settings.icon_text_max_width_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-image-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-banner-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-image-banner-image-{{ ai_gen_id }} ai-image-banner-image-desktop-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
          Next, add a banner image
        </div>
      </div>
    {% endif %}

    {% if block.settings.image_mobile %}
      <img
        src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
        alt="{{ block.settings.image_mobile.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image_mobile.width }}"
        height="{{ block.settings.image_mobile.height }}"
        class="ai-image-banner-image-{{ ai_gen_id }} ai-image-banner-image-mobile-{{ ai_gen_id }}"
      >
    {% elsif block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 1000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-image-banner-image-{{ ai_gen_id }} ai-image-banner-image-mobile-{{ ai_gen_id }}"
      >
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-image-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-image-banner-text-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-image-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
        <a href="/collections/all" style="display:inline-block;margin-top:20px;padding:14px 36px;background-color:#07cbdc;color:#ffffff;text-decoration:none;border-radius:30px;font-size:16px;font-weight:600;letter-spacing:0.5px;transition:background-color 0.3s ease,transform 0.2s ease;" onmouseenter="this.style.backgroundColor='#9830ff';this.style.transform='scale(1.05)'" onmouseleave="this.style.backgroundColor='#07cbdc';this.style.transform='scale(1)'">Shop Now</a>
      </div>

    {% if block.settings.show_icons %}
      <div class="ai-image-banner-icons-wrapper-{{ ai_gen_id }}">
        <div class="ai-image-banner-icons-{{ ai_gen_id }}">
          {% if block.settings.icon_1_text != blank %}
            <div class="ai-image-banner-icon-item-{{ ai_gen_id }}">
              <div class="ai-image-banner-icon-{{ ai_gen_id }}">
                {% if block.settings.icon_1_image %}
                  <img
                    src="{{ block.settings.icon_1_image | image_url: width: 200 }}"
                    alt="{{ block.settings.icon_1_image.alt | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                {% endif %}
              </div>
              <p class="ai-image-banner-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_1_text }}</p>
            </div>
          {% endif %}

          {% if block.settings.icon_2_text != blank %}
            <div class="ai-image-banner-icon-item-{{ ai_gen_id }}">
              <div class="ai-image-banner-icon-{{ ai_gen_id }}">
                {% if block.settings.icon_2_image %}
                  <img
                    src="{{ block.settings.icon_2_image | image_url: width: 200 }}"
                    alt="{{ block.settings.icon_2_image.alt | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {% endif %}
              </div>
              <p class="ai-image-banner-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_2_text }}</p>
            </div>
          {% endif %}

          {% if block.settings.icon_3_text != blank %}
            <div class="ai-image-banner-icon-item-{{ ai_gen_id }}">
              <div class="ai-image-banner-icon-{{ ai_gen_id }}">
                {% if block.settings.icon_3_image %}
                  <img
                    src="{{ block.settings.icon_3_image | image_url: width: 200 }}"
                    alt="{{ block.settings.icon_3_image.alt | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% endif %}
              </div>
              <p class="ai-image-banner-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_3_text }}</p>
            </div>
          {% endif %}

          {% if block.settings.icon_4_text != blank %}
            <div class="ai-image-banner-icon-item-{{ ai_gen_id }}">
              <div class="ai-image-banner-icon-{{ ai_gen_id }}">
                {% if block.settings.icon_4_image %}
                  <img
                    src="{{ block.settings.icon_4_image | image_url: width: 200 }}"
                    alt="{{ block.settings.icon_4_image.alt | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                {% endif %}
              </div>
              <p class="ai-image-banner-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_4_text }}</p>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image banner with icons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Banner image (mobile)",
      "info": "Optional. If not set, desktop image will be used"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height (desktop)",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Banner height (mobile)",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover amazing products with exceptional quality"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 400,
      "max": 1200,
      "step": 100,
      "unit": "px",
      "default": 800
    },
    {
      "type": "header",
      "content": "Padding (desktop)"
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "content_padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding_horizontal_mobile",
      "label": "Horizontal padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Subheading style"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_max_width",
      "label": "Max width",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_placement",
      "label": "Icon placement",
      "options": [
        {
          "value": "below_content",
          "label": "Below content (stacked)"
        },
        {
          "value": "inline",
          "label": "Inline (horizontal)"
        },
        {
          "value": "grid",
          "label": "Grid layout"
        }
      ],
      "default": "inline"
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Gap between icons",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Gap between icon and text",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "icon_padding",
      "label": "Icon padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Icon border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_text_color",
      "label": "Icon text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "icon_text_size",
      "label": "Icon text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_text_max_width",
      "label": "Icon text max width",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "icon_text_max_width_mobile",
      "label": "Icon text max width (mobile)",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Icon 1"
    },
    {
      "type": "image_picker",
      "id": "icon_1_image",
      "label": "Custom icon image",
      "info": "Optional. If not set, default SVG icon will be used"
    },
    {
      "type": "text",
      "id": "icon_1_text",
      "label": "Text",
      "default": "Free Shipping"
    },
    {
      "type": "header",
      "content": "Icon 2"
    },
    {
      "type": "image_picker",
