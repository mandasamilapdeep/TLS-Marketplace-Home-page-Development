{% doc %}
  @prompt
    Build a row of 7 icons/SVGs , I want the icons to be custom icons i have 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-icon-row__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-icon-row__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.text_spacing }}px;
    flex: 0 0 auto;
  }

  .ai-icon-row__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .ai-icon-row__item-{{ ai_gen_id }}:hover .ai-icon-row__icon-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.icon_hover_background_color }};
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-icon-row__icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .ai-icon-row__item-{{ ai_gen_id }}:hover .ai-icon-row__icon-{{ ai_gen_id }} {
    transform: scale({{ block.settings.icon_hover_scale }});
  }

  .ai-icon-row__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_color }};
    border-radius: 4px;
    opacity: 0.3;
  }

  .ai-icon-row__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-row__container-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.7 }}px;
    }

    .ai-icon-row__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-icon-row__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-icon-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-row__container-{{ ai_gen_id }}">
    {% for i in (1..7) %}
      {% liquid
        assign icon_key = 'icon_' | append: i
        assign text_key = 'text_' | append: i
        assign icon_image = block.settings[icon_key]
        assign icon_text = block.settings[text_key]
      %}

      <div class="ai-icon-row__item-{{ ai_gen_id }}">
        <div class="ai-icon-row__icon-wrapper-{{ ai_gen_id }}">
          {% if icon_image != blank %}
            <img
              src="{{ icon_image | image_url: width: 200 }}"
              alt="{{ icon_text | escape }}"
              class="ai-icon-row__icon-{{ ai_gen_id }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-icon-row__icon-placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
          {% endif %}
        </div>
        {% if icon_text != blank %}
          <p class="ai-icon-row__text-{{ ai_gen_id }}">{{ icon_text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

