{% doc %}
  @prompt
    section with image and short bio on left and scientific test results on right
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bio-results-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-bio-results-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: flex-start;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-bio-results-left-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-bio-results-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-bio-results-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-bio-results-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-bio-results-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-bio-results-bio-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-bio-results-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-bio-results-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 500;
    margin: 0 0 12px 0;
    color: {{ block.settings.subheading_color }};
  }

  .ai-bio-results-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-bio-results-right-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.results_gap }}px;
  }

  .ai-bio-results-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.results_gap }}px 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-bio-results-item-{{ ai_gen_id }} {
    padding: {{ block.settings.result_padding }}px;
    background-color: {{ block.settings.result_background }};
    border-radius: {{ block.settings.result_border_radius }}px;
    border: 1px solid {{ block.settings.result_border_color }};
  }

  .ai-bio-results-item-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_label_size }}px;
    font-weight: 600;
    margin: 0 0 4px 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-bio-results-item-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_value_size }}px;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-bio-results-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-bio-results-name-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.name_size }}px * 0.85);
    }

    .ai-bio-results-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-bio-results-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_heading_size }}px * 0.85);
    }
  }
{% endstyle %}

<bio-results-{{ ai_gen_id }} class="ai-bio-results-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bio-results-container-{{ ai_gen_id }}">
    <div class="ai-bio-results-left-{{ ai_gen_id }}">
      <div class="ai-bio-results-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            class="ai-bio-results-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-bio-results-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-bio-results-bio-{{ ai_gen_id }}">
        {% if block.settings.name != blank %}
          <h3 class="ai-bio-results-name-{{ ai_gen_id }}">{{ block.settings.name }}</h3>
        {% endif %}

        {% if block.settings.job_title != blank %}
          <p class="ai-bio-results-title-{{ ai_gen_id }}">{{ block.settings.job_title }}</p>
        {% endif %}

        {% if block.settings.bio != blank %}
          <div class="ai-bio-results-description-{{ ai_gen_id }}">
            {{ block.settings.bio }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-bio-results-right-{{ ai_gen_id }}">
      {% if block.settings.results_heading != blank %}
        <h3 class="ai-bio-results-heading-{{ ai_gen_id }}">{{ block.settings.results_heading }}</h3>
      {% endif %}

      {% if block.settings.result_1_label != blank %}
        <div class="ai-bio-results-item-{{ ai_gen_id }}">
          <p class="ai-bio-results-item-label-{{ ai_gen_id }}">{{ block.settings.result_1_label }}</p>
          {% if block.settings.result_1_value != blank %}
            <p class="ai-bio-results-item-value-{{ ai_gen_id }}">{{ block.settings.result_1_value }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.result_2_label != blank %}
        <div class="ai-bio-results-item-{{ ai_gen_id }}">
          <p class="ai-bio-results-item-label-{{ ai_gen_id }}">{{ block.settings.result_2_label }}</p>
          {% if block.settings.result_2_value != blank %}
            <p class="ai-bio-results-item-value-{{ ai_gen_id }}">{{ block.settings.result_2_value }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.result_3_label != blank %}
        <div class="ai-bio-results-item-{{ ai_gen_id }}">
          <p class="ai-bio-results-item-label-{{ ai_gen_id }}">{{ block.settings.result_3_label }}</p>
          {% if block.settings.result_3_value != blank %}
            <p class="ai-bio-results-item-value-{{ ai_gen_id }}">{{ block.settings.result_3_value }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.result_4_label != blank %}
        <div class="ai-bio-results-item-{{ ai_gen_id }}">
          <p class="ai-bio-results-item-label-{{ ai_gen_id }}">{{ block.settings.result_4_label }}</p>
          {% if block.settings.result_4_value != blank %}
            <p class="ai-bio-results-item-value-{{ ai_gen_id }}">{{ block.settings.result_4_value }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.result_5_label != blank %}
        <div class="ai-bio-results-item-{{ ai_gen_id }}">
          <p class="ai-bio-results-item-label-{{ ai_gen_id }}">{{ block.settings.result_5_label }}</p>
          {% if block.settings.result_5_value != blank %}
            <p class="ai-bio-results-item-value-{{ ai_gen_id }}">{{ block.settings.result_5_value }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</bio-results-{{ ai_gen_id }}>

<script>
  (function() {
    class BioResults{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('bio-results-{{ ai_gen_id }}', BioResults{{ ai_gen_id }});
  })();
</script>

{% schema %}
