{% doc %}
  @prompt
    newsletter sign up section with heading and padding control, fix liquid error
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-newsletter-signup-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_horizontal }}px;
    padding-right: {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-newsletter-signup__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-newsletter-signup__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-newsletter-signup__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.form_spacing }}px;
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.5;
  }

  .ai-newsletter-signup__form-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.form_max_width }}px;
    margin: 0 auto;
  }

  .ai-newsletter-signup__form-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.input_button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-newsletter-signup__input-wrapper-{{ ai_gen_id }} {
    flex: 1 1 250px;
    min-width: 0;
  }

  .ai-newsletter-signup__input-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px {{ block.settings.input_padding | times: 1.5 }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: {{ block.settings.input_font_size }}px;
    transition: border-color 0.3s ease;
  }

  .ai-newsletter-signup__input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
    opacity: 0.7;
  }

  .ai-newsletter-signup__input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-newsletter-signup__input-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-newsletter-signup__button-{{ ai_gen_id }} {
    padding: {{ block.settings.input_padding }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .ai-newsletter-signup__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
  }

  .ai-newsletter-signup__button-{{ ai_gen_id }}:active {
    transform: scale(0.98);
  }

  .ai-newsletter-signup__message-{{ ai_gen_id }} {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-newsletter-signup__success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-newsletter-signup__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-newsletter-signup-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.7 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.7 }}px;
      padding-left: {{ block.settings.padding_horizontal | times: 0.7 }}px;
      padding-right: {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-newsletter-signup__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-newsletter-signup__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-newsletter-signup__form-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-newsletter-signup__input-wrapper-{{ ai_gen_id }} {
      flex: 1 1 100%;
    }

    .ai-newsletter-signup__button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<newsletter-signup-{{ ai_gen_id }}
  class="ai-newsletter-signup-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-newsletter-signup__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-newsletter-signup__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-newsletter-signup__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    <div class="ai-newsletter-signup__form-wrapper-{{ ai_gen_id }}">
      {% form 'contact' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="ai-newsletter-signup__form-{{ ai_gen_id }}">
          <div class="ai-newsletter-signup__input-wrapper-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="ai-newsletter-signup__input-{{ ai_gen_id }}"
              value="{{ form.email }}"
              placeholder="{{ block.settings.email_placeholder }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-newsletter-error-{{ ai_gen_id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="ai-newsletter-success-{{ ai_gen_id }}"
              {% endif %}
              required
            >
          </div>

          <button
            type="submit"
            class="ai-newsletter-signup__button-{{ ai_gen_id }}"
            name="commit"
          >
            {{ block.settings.button_text }}
          </button>
        </div>

        {% if form.errors %}
          <div
            id="ai-newsletter-error-{{ ai_gen_id }}"
            class="ai-newsletter-signup__message-{{ ai_gen_id }} ai-newsletter-signup__error-{{ ai_gen_id }}"
          >
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {% endif %}

        {% if form.posted_successfully? %}
          <div
            id="ai-newsletter-success-{{ ai_gen_id }}"
            class="ai-newsletter-signup__message-{{ ai_gen_id }} ai-newsletter-signup__success-{{ ai_gen_id }}"
          >
            {{ block.settings.success_message }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</newsletter-signup-{{ ai_gen_id }}>

<script>
  (function() {
    class NewsletterSignup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const emailInput = this.form.querySelector('input[type="email"]');
        if (emailInput && !emailInput.value.trim()) {
          event.preventDefault();
          emailInput.focus();
        }
      }
    }

    customElements.define('newsletter-signup-{{ ai_gen_id }}', NewsletterSignup{{ ai_gen_id }});
  })();
</script>

