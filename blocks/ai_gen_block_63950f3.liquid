{% doc %}
  @prompt
    create a copy of the "Featured ticker" section but add images, Add a heading above the ticker enable padding control
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ticker-with-images-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-ticker-with-images-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-ticker-with-images-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    text-transform: {{ block.settings.heading_transform }};
  }

  .ai-ticker-with-images-overflow-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-ticker-with-images-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    animation: ai-ticker-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-ticker-with-images-{{ ai_gen_id }}:hover .ai-ticker-with-images-wrapper-{{ ai_gen_id }} {
    animation-play-state: {% if block.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  .ai-ticker-with-images-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.text_image_gap }}px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .ai-ticker-with-images-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    flex-shrink: 0;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-ticker-with-images-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-ticker-with-images-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ticker-with-images-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ticker-with-images-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  @keyframes ai-ticker-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ticker-with-images-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-ticker-with-images-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-ticker-with-images-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.8);
    }

    .ai-ticker-with-images-image-{{ ai_gen_id }} {
      width: calc({{ block.settings.image_size }}px * 0.8);
      height: calc({{ block.settings.image_size }}px * 0.8);
    }
  }
{% endstyle %}

<ticker-with-images-{{ ai_gen_id }} class="ai-ticker-with-images-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ticker-with-images-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-ticker-with-images-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    
    <div class="ai-ticker-with-images-overflow-{{ ai_gen_id }}">
      <div class="ai-ticker-with-images-wrapper-{{ ai_gen_id }}">
        {% for i in (1..2) %}
          {% for item_num in (1..5) %}
            {% liquid
              assign text_key = 'item_' | append: item_num | append: '_text'
              assign image_key = 'item_' | append: item_num | append: '_image'
              assign enabled_key = 'item_' | append: item_num | append: '_enabled'
              
              assign item_text = block.settings[text_key]
              assign item_image = block.settings[image_key]
              assign item_enabled = block.settings[enabled_key]
            %}

            {% if item_enabled %}
              <div class="ai-ticker-with-images-item-{{ ai_gen_id }}">
                <div class="ai-ticker-with-images-image-{{ ai_gen_id }}">
                  {% if item_image %}
                    <img
                      src="{{ item_image | image_url: width: 200 }}"
                      alt="{{ item_image.alt | escape }}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    <div class="ai-ticker-with-images-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                {% if item_text != blank %}
                  <span class="ai-ticker-with-images-text-{{ ai_gen_id }}">{{ item_text }}</span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</ticker-with-images-{{ ai_gen_id }}>

<script>
  (function() {
    class TickerWithImages{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-ticker-with-images-wrapper-{{ ai_gen_id }}');
        this.adjustAnimation();
      }

      adjustAnimation() {
        if (!this.wrapper) return;
        
        const firstItem = this.wrapper.querySelector('.ai-ticker-with-images-item-{{ ai_gen_id }}');
        if (!firstItem) return;

        const itemWidth = firstItem.offsetWidth;
        const gap = {{ block.settings.item_spacing }};
        const itemCount = this.wrapper.querySelectorAll('.ai-ticker-with-images-item-{{ ai_gen_id }}').length / 2;
        const totalWidth = (itemWidth + gap) * itemCount;

        this.wrapper.style.width = `${totalWidth * 2}px`;
      }
    }

    customElements.define('ticker-with-images-{{ ai_gen_id }}', TickerWithImages{{ ai_gen_id }});
  })();
</script>

